| execute_sql {"sql": "-- 1. Create materialized view exec_department_summary\nCREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT \n  d.dept_name AS department_name,\n  COUNT(DISTINCT de.employee_id) FILTER (WHERE s.to_date = '9999-01-01') AS total_employees,\n  AVG(s.amount) FILTER (WHERE s.to_date = '9999-01-01')::numeric(15,2) AS avg_salary,\n  SUM(s.amount) FILTER (WHERE s.to_date = '9999-01-01') AS total_payroll,\n  CONCAT(e.first_name, ' ', e.last_name) AS manager_name\nFROM employees.department d\nJOIN employees.department_employee de ON d.id = de.department_id\nJOIN employees.salary s ON s.employee_id = de.employee_id\nJOIN employees.department_manager dm ON dm.department_id = d.id\nJOIN employees.employee e ON e.id = dm.employee_id\nWHERE de.to_date = '9999-01-01'\n  AND dm.to_date = '9999-01-01'\n  AND s.to_date = '9999-01-01'\nGROUP BY d.dept_name, e.first_name, e.last_name;\n\n-- 2. Create materialized view exec_hiring_trends\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n  SELECT\n    EXTRACT(YEAR FROM e.hire_date)::INT AS hire_year,\n    e.id AS employee_id,\n    s.amount AS starting_salary,\n    de.department_id\n  FROM employees.employee e\n  JOIN employees.salary s ON s.employee_id = e.id\n    AND s.from_date = e.hire_date\n  JOIN employees.department_employee de ON de.employee_id = e.id\n    AND de.from_date <= e.hire_date AND de.to_date >= e.hire_date\n),\nhire_counts AS (\n  SELECT\n    hire_year,\n    COUNT(employee_id) AS employees_hired,\n    AVG(starting_salary)::numeric(15,2) AS avg_starting_salary\n  FROM hires\n  GROUP BY hire_year\n),\nemployment AS (\n  SELECT\n    h.hire_year,\n    h.employee_id,\n    CASE WHEN de.to_date = '9999-01-01' THEN 1 ELSE 0 END AS still_employed,\n    de.department_id\n  FROM hires h\n  JOIN employees.department_employee de ON de.employee_id = h.employee_id\n    AND de.from_date <= CURRENT_DATE AND de.to_date >= CURRENT_DATE\n),\nretention AS (\n  SELECT\n    hire_year,\n    AVG(still_employed)::numeric(5,4) AS retention_rate\n  FROM employment\n  GROUP BY hire_year\n),\ntop_dept AS (\n  SELECT DISTINCT ON (hire_year)\n    hire_year,\n    d.dept_name AS top_hiring_department\n  FROM hires h\n  JOIN employees.department d ON d.id = h.department_id\n  GROUP BY hire_year, d.dept_name\n  ORDER BY hire_year, COUNT(*) DESC\n)\nSELECT\n  hc.hire_year,\n  hc.employees_hired,\n  hc.avg_starting_salary,\n  r.retention_rate,\n  td.top_hiring_department\nFROM hire_counts hc\nJOIN retention r ON r.hire_year = hc.hire_year\nJOIN top_dept td ON td.hire_year = hc.hire_year;\n\n-- 3. Create materialized view exec_salary_distribution\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH current_salaries AS (\n  SELECT s.employee_id, s.amount\n  FROM employees.salary s\n  WHERE s.to_date = '9999-01-01'\n),\nsalary_bands AS (\n  SELECT\n    employee_id,\n    amount,\n    CASE \n      WHEN amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n      WHEN amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n      WHEN amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n      WHEN amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n      ELSE '110K+'\n    END AS salary_band\n  FROM current_salaries\n),\nband_counts AS (\n  SELECT\n    salary_band,\n    COUNT(employee_id) AS employee_count\n  FROM salary_bands\n  GROUP BY salary_band\n),\nworkforce_count AS (\n  SELECT COUNT(*) AS total FROM employees.employee\n),\ncommon_titles AS (\n  SELECT\n    sb.salary_band,\n    t.title AS most_common_title\n  FROM salary_bands sb\n  JOIN employees.title t ON sb.employee_id = t.employee_id\n  WHERE t.to_date = '9999-01-01'\n  GROUP BY sb.salary_band, t.title\n  ORDER BY sb.salary_band, COUNT(*) DESC\n),\nmost_common_titles AS (\n  SELECT DISTINCT ON (salary_band)\n    salary_band,\n    most_common_title\n  FROM common_titles\n)\nSELECT\n  bc.salary_band,\n  bc.employee_count,\n  (bc.employee_count::decimal / (SELECT total FROM workforce_count))::numeric(5,4) AS percentage_of_workforce,\n  mct.most_common_title\nFROM band_counts bc\nJOIN most_common_titles mct ON bc.salary_band = mct.salary_band\nORDER BY bc.salary_band;"}
| execute_sql {"sql": "-- 2. Create table monthly_reports if not exists\nCREATE TABLE IF NOT EXISTS employees.monthly_reports (\n  report_id SERIAL PRIMARY KEY,\n  report_date DATE NOT NULL,\n  department_count INTEGER NOT NULL,\n  total_employees INTEGER NOT NULL,\n  avg_salary NUMERIC(15,2) NOT NULL,\n  generated_at TIMESTAMPTZ DEFAULT now()\n);\n\n-- 2. Create stored procedure generate_monthly_report\nCREATE OR REPLACE FUNCTION employees.generate_monthly_report(report_date DATE) RETURNS INTEGER AS $$\nDECLARE\n  v_department_count INTEGER;\n  v_total_employees INTEGER;\n  v_avg_salary NUMERIC(15,2);\n  v_report_id INTEGER;\nBEGIN\n  -- Calculate department count\n  SELECT COUNT(*) INTO v_department_count FROM employees.department;\n\n  -- Calculate total active employees\n  SELECT COUNT(DISTINCT de.employee_id) INTO v_total_employees\n  FROM employees.department_employee de\n  WHERE de.to_date = '9999-01-01';\n\n  -- Calculate average current salary\n  SELECT AVG(s.amount)::numeric(15,2) INTO v_avg_salary\n  FROM employees.salary s\n  WHERE s.to_date = '9999-01-01';\n\n  -- Insert new report record\n  INSERT INTO employees.monthly_reports (report_date, department_count, total_employees, avg_salary)\n  VALUES (report_date, v_department_count, v_total_employees, v_avg_salary)\n  RETURNING report_id INTO v_report_id;\n\n  RETURN v_report_id;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- 3. Create salary_alerts table if not exists\nCREATE TABLE IF NOT EXISTS employees.salary_alerts (\n  alert_id SERIAL PRIMARY KEY,\n  employee_id BIGINT NOT NULL,\n  salary_amount BIGINT NOT NULL,\n  alert_date TIMESTAMPTZ DEFAULT now(),\n  status VARCHAR(20) DEFAULT 'new'\n);\n\n-- 4. Create trigger and function for high_salary_alert\nCREATE OR REPLACE FUNCTION employees.fn_high_salary_alert() RETURNS TRIGGER AS $$\nBEGIN\n  IF NEW.amount > 120000 THEN\n    INSERT INTO employees.salary_alerts (employee_id, salary_amount, alert_date, status)\n    VALUES (NEW.employee_id, NEW.amount, now(), 'new');\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nDROP TRIGGER IF EXISTS high_salary_alert ON employees.salary;\n\nCREATE TRIGGER high_salary_alert\nAFTER INSERT ON employees.salary\nFOR EACH ROW\nEXECUTE FUNCTION employees.fn_high_salary_alert();"}
