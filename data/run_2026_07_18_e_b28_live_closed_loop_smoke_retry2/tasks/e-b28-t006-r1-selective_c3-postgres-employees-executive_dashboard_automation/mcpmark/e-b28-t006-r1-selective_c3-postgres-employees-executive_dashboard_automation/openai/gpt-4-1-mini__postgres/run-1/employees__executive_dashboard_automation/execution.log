| execute_sql {"sql": "-- Create exec_department_summary:\nCREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT\n  d.dept_name AS department_name,\n  COUNT(DISTINCT de.employee_id) FILTER (WHERE CURRENT_DATE BETWEEN de.from_date AND de.to_date) AS total_employees,\n  AVG(s.amount) FILTER (WHERE CURRENT_DATE BETWEEN s.from_date AND s.to_date) AS avg_salary,\n  SUM(s.amount) FILTER (WHERE CURRENT_DATE BETWEEN s.from_date AND s.to_date) AS total_payroll,\n  CONCAT(e.first_name, ' ', e.last_name) AS manager_name\nFROM employees.department d\nJOIN employees.department_employee de ON d.id = de.department_id\nJOIN employees.salary s ON de.employee_id = s.employee_id AND CURRENT_DATE BETWEEN s.from_date AND s.to_date\nLEFT JOIN employees.department_manager dm ON d.id = dm.department_id AND CURRENT_DATE BETWEEN dm.from_date AND dm.to_date\nLEFT JOIN employees.employee e ON dm.employee_id = e.id\nWHERE CURRENT_DATE BETWEEN de.from_date AND de.to_date\nGROUP BY d.dept_name, e.first_name, e.last_name;\n\n-- Create exec_hiring_trends:\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n  SELECT\n    EXTRACT(YEAR FROM e.hire_date) AS hire_year,\n    e.id AS employee_id,\n    de.department_id,\n    s.amount AS starting_salary,\n    CURRENT_DATE AS today\n  FROM employees.employee e\n  LEFT JOIN employees.salary s ON e.id = s.employee_id AND s.from_date = (\n    SELECT MIN(from_date) FROM employees.salary WHERE employee_id = e.id\n  )\n  LEFT JOIN employees.department_employee de ON e.id = de.employee_id AND e.hire_date BETWEEN de.from_date AND de.to_date\n),\nhiring_summary AS (\n  SELECT\n    hire_year,\n    COUNT(employee_id) AS employees_hired,\n    AVG(starting_salary) AS avg_starting_salary\n  FROM hires\n  GROUP BY hire_year\n),\nretention AS (\n  SELECT\n    hire_year,\n    COUNT(employee_id) FILTER (WHERE e.id IS NOT NULL) AS retained_count\n  FROM hires\n  LEFT JOIN employees.employee e ON hires.employee_id = e.id AND CURRENT_DATE BETWEEN e.hire_date AND CURRENT_DATE\n  GROUP BY hire_year\n),\ntop_dept AS (\n  SELECT\n    hire_year,\n    department_id AS top_department\n  FROM (\n    SELECT\n      hire_year,\n      department_id,\n      ROW_NUMBER() OVER (PARTITION BY hire_year ORDER BY COUNT(employee_id) DESC) AS rn\n    FROM hires\n    GROUP BY hire_year, department_id\n  ) sub\n  WHERE rn = 1\n)\nSELECT\n  hs.hire_year,\n  hs.employees_hired,\n  hs.avg_starting_salary,\n  COALESCE(CAST(rs.retained_count AS DECIMAL) / hs.employees_hired, 0) AS retention_rate,\n  d.dept_name AS top_hiring_department\nFROM hiring_summary hs\nLEFT JOIN retention rs ON hs.hire_year = rs.hire_year\nLEFT JOIN top_dept td ON hs.hire_year = td.hire_year\nLEFT JOIN employees.department d ON td.top_department = d.id\nORDER BY hs.hire_year;\n\n-- Create exec_salary_distribution:\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT * FROM (VALUES\n    ('30K-50K', 30000, 50000),\n    ('50K-70K', 50001, 70000),\n    ('70K-90K', 70001, 90000),\n    ('90K-110K', 90001, 110000),\n    ('110K+', 110001, 999999999)\n  ) AS bands(salary_band, band_min, band_max)\n), current_salaries AS (\n  SELECT employee_id, amount FROM employees.salary\n  WHERE CURRENT_DATE BETWEEN from_date AND to_date\n), total_employees AS (\n  SELECT COUNT(DISTINCT employee_id) AS total FROM current_salaries\n), employee_titles AS (\n  SELECT employee_id, title FROM employees.title\n  WHERE CURRENT_DATE BETWEEN from_date AND COALESCE(to_date, '9999-01-01')\n)\nSELECT\n  sb.salary_band,\n  COUNT(cs.employee_id) AS employee_count,\n  ROUND(COUNT(cs.employee_id) * 100.0 / (SELECT total FROM total_employees), 2) AS percentage_of_workforce,\n  (SELECT title FROM employee_titles et WHERE et.employee_id = cs.employee_id\n   GROUP BY title ORDER BY COUNT(*) DESC LIMIT 1) AS most_common_title\nFROM salary_bands sb\nLEFT JOIN current_salaries cs ON cs.amount BETWEEN sb.band_min AND sb.band_max\nGROUP BY sb.salary_band\nORDER BY sb.band_min;\n"}
