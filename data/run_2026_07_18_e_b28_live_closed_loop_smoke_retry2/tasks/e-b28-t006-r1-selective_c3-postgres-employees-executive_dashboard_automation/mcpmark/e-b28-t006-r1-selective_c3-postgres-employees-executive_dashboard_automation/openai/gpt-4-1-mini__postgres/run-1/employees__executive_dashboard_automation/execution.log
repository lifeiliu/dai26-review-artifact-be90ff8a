01-01') AS retained_count\n  FROM hires h\n  LEFT JOIN employees.salary s ON h.employee_id = s.employee_id AND s.to_date = '9999-01-01'\n  GROUP BY hire_year\n),\ntop_dept AS (\n  SELECT\n    hire_year,\n    department_id\n  FROM (\n    SELECT\n      hire_year,\n      department_id,\n      ROW_NUMBER() OVER (PARTITION BY hire_year ORDER BY COUNT(employee_id) DESC) AS rn\n    FROM hires\n    GROUP BY hire_year, department_id\n  ) sub\n  WHERE rn = 1\n)\nSELECT\n  hs.hire_year,\n  hs.employees_hired,\n  hs.avg_starting_salary,\n  COALESCE(CAST(rs.retained_count AS DECIMAL) / hs.employees_hired, 0) AS retention_rate,\n  d.dept_name AS top_hiring_department\nFROM hiring_summary hs\nLEFT JOIN retention rs ON hs.hire_year = rs.hire_year\nLEFT JOIN top_dept td ON hs.hire_year = td.hire_year\nLEFT JOIN employees.department d ON td.department_id = d.id\nORDER BY hs.hire_year;\n\n-- Recreate exec_salary_distribution\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT * FROM (VALUES\n    ('30K-50K', 30000, 50000),\n    ('50K-70K', 50001, 70000),\n    ('70K-90K', 70001, 90000),\n    ('90K-110K', 90001, 110000),\n    ('110K+', 110001, 999999999)\n  ) AS bands(salary_band, band_min, band_max)\n), current_salaries AS (\n  SELECT employee_id, amount FROM employees.salary\n  WHERE CURRENT_DATE BETWEEN from_date AND to_date\n), total_employees AS (\n  SELECT COUNT(DISTINCT employee_id) AS total FROM current_salaries\n), titles_in_band AS (\n  SELECT\n    sb.salary_band,\n    t.title\n  FROM salary_bands sb\n  JOIN current_salaries cs ON cs.amount BETWEEN sb.band_min AND sb.band_max\n  JOIN employees.title t ON cs.employee_id = t.employee_id\n    AND CURRENT_DATE BETWEEN t.from_date AND COALESCE(t.to_date, '9999-01-01')\n), band_title_counts AS (\n  SELECT\n    salary_band,\n    title,\n    COUNT(*) AS title_count,\n    RANK() OVER (PARTITION BY salary_band ORDER BY COUNT(*) DESC) AS rank\n  FROM titles_in_band\n  GROUP BY salary_band, title\n), most_common_titles AS (\n  SELECT salary_band, title AS most_common_title FROM band_title_counts WHERE rank = 1\n)\nSELECT\n  sb.salary_band,\n  COUNT(cs.employee_id) AS employee_count,\n  ROUND(COUNT(cs.employee_id) * 100.0 / (SELECT total FROM total_employees), 2) AS percentage_of_workforce,\n  mct.most_common_title\nFROM salary_bands sb\nLEFT JOIN current_salaries cs ON cs.amount BETWEEN sb.band_min AND sb.band_max\nLEFT JOIN most_common_titles mct ON sb.salary_band = mct.salary_band\nGROUP BY sb.salary_band, mct.most_common_title\nORDER BY sb.band_min;\n"}
