| execute_sql {"sql": "-- Create materialized view exec_department_summary\nCREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.dept_name AS department_name,\n       COUNT(DISTINCT de.employee_id) AS total_employees,\n       AVG(s.amount)::numeric(12,2) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       CONCAT(e_mgr.first_name, ' ', e_mgr.last_name) AS manager_name\nFROM employees.department d\nLEFT JOIN employees.department_employee de ON de.department_id = d.id\n    AND CURRENT_DATE BETWEEN de.from_date AND de.to_date\nLEFT JOIN employees.salary s ON s.employee_id = de.employee_id\n    AND CURRENT_DATE BETWEEN s.from_date AND s.to_date\nLEFT JOIN employees.department_manager dm ON dm.department_id = d.id\n    AND CURRENT_DATE BETWEEN dm.from_date AND dm.to_date\nLEFT JOIN employees.employee e_mgr ON e_mgr.id = dm.employee_id\nGROUP BY d.dept_name, e_mgr.first_name, e_mgr.last_name;\n\n-- Create materialized view exec_hiring_trends\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n    SELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n           e.id,\n           s.amount AS starting_salary,\n           de.department_id\n    FROM employees.employee e\n    LEFT JOIN employees.salary s ON s.employee_id = e.id\n        AND s.from_date = e.hire_date\n    LEFT JOIN employees.department_employee de ON de.employee_id = e.id\n        AND e.hire_date BETWEEN de.from_date AND de.to_date\n), retained AS (\n    SELECT hire_year, COUNT(*) AS hired, SUM(CASE WHEN e2.id IS NOT NULL THEN 1 ELSE 0 END) AS retained\n    FROM hires h\n    LEFT JOIN employees.employee e2 ON e2.id = h.id\n    GROUP BY hire_year\n), top_dept AS (\n    SELECT hire_year, department_id, COUNT(*) AS dept_hires,\n           RANK() OVER (PARTITION BY hire_year ORDER BY COUNT(*) DESC) AS rank\n    FROM hires\n    GROUP BY hire_year, department_id\n)\nSELECT h.hire_year,\n       COUNT(h.id) AS employees_hired,\n       AVG(h.starting_salary)::numeric(12,2) AS avg_starting_salary,\n       CASE WHEN r.hired > 0 THEN (r.retained::decimal / r.hired)::numeric(5,2) ELSE 0 END AS retention_rate,\n       (SELECT d.dept_name FROM employees.department d WHERE d.id = td.department_id) AS top_hiring_department\nFROM hires h\nJOIN retained r ON h.hire_year = r.hire_year\nJOIN top_dept td ON h.hire_year = td.hire_year AND td.rank = 1\nGROUP BY h.hire_year, r.hired, r.retained, td.department_id\nORDER BY h.hire_year;\n\n-- Create materialized view exec_salary_distribution\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n    SELECT employee_id, s.amount\n    FROM employees.salary s\n    WHERE CURRENT_DATE BETWEEN s.from_date AND s.to_date\n), banded AS (\n    SELECT employee_id,\n           amount,\n           CASE\n               WHEN amount >= 30000 AND amount < 50000 THEN '30K-50K'\n               WHEN amount >= 50000 AND amount < 70000 THEN '50K-70K'\n               WHEN amount >= 70000 AND amount < 90000 THEN '70K-90K'\n               WHEN amount >= 90000 AND amount < 110000 THEN '90K-110K'\n               WHEN amount >= 110000 THEN '110K+'\n               ELSE 'Below 30K'\n           END AS salary_band\n    FROM salary_bands\n), counted AS (\n    SELECT salary_band, COUNT(employee_id) AS employee_count\n    FROM banded\n    GROUP BY salary_band\n), common_title AS (\n    SELECT b.salary_band, t.title, COUNT(*) AS title_count\n    FROM banded b\n    JOIN employees.title t ON b.employee_id = t.employee_id\n    WHERE CURRENT_DATE BETWEEN t.from_date AND t.to_date\n    GROUP BY b.salary_band, t.title\n), most_common AS (\n    SELECT salary_band, title AS most_common_title\n    FROM (\n        SELECT salary_band, title, title_count,\n               ROW_NUMBER() OVER (PARTITION BY salary_band ORDER BY title_count DESC) AS rn\n        FROM common_title\n    ) sub\n    WHERE rn = 1\n), total AS (\n    SELECT COUNT(*)::decimal AS total_employees\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE CURRENT_DATE BETWEEN s.from_date AND s.to_date\n)\nSELECT c.salary_band,\n       c.employee_count,\n       ROUND((c.employee_count / t.total_employees)::numeric, 4) AS percentage_of_workforce,\n       COALESCE(m.most_common_title, 'Unknown') AS most_common_title\nFROM counted c\nCROSS JOIN total t\nLEFT JOIN most_common m ON c.salary_band = m.salary_band\nORDER BY c.salary_band;"}
| execute_sql {"sql": "-- Create table monthly_reports\nCREATE TABLE IF NOT EXISTS employees.monthly_reports (\n    report_id SERIAL PRIMARY KEY,\n    report_date DATE NOT NULL,\n    department_count INTEGER NOT NULL,\n    total_employees INTEGER NOT NULL,\n    avg_salary DECIMAL(12,2) NOT NULL,\n    generated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create stored procedure generate_monthly_report\nCREATE OR REPLACE FUNCTION employees.generate_monthly_report(report_date DATE)\nRETURNS INTEGER AS $$\nDECLARE\n    v_report_id INTEGER;\nBEGIN\n    INSERT INTO employees.monthly_reports(report_date, department_count, total_employees, avg_salary, generated_at)\n    SELECT \n        report_date,\n        (SELECT COUNT(*) FROM employees.department),\n        COUNT(DISTINCT de.employee_id),\n        AVG(s.amount)::numeric(12,2),\n        CURRENT_TIMESTAMP\n    FROM employees.department_employee de\n    JOIN employees.salary s ON s.employee_id = de.employee_id\n    WHERE CURRENT_DATE BETWEEN de.from_date AND de.to_date\n      AND CURRENT_DATE BETWEEN s.from_date AND s.to_date\n    RETURNING report_id INTO v_report_id;\n\n    RETURN v_report_id;\nEND;\n$$ LANGUAGE plpgsql;"}
| execute_sql {"sql": "-- Create table salary_alerts\nCREATE TABLE IF NOT EXISTS employees.salary_alerts (\n    alert_id SERIAL PRIMARY KEY,\n    employee_id BIGINT NOT NULL,\n    salary_amount BIGINT NOT NULL,\n    alert_date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    status VARCHAR(20) NOT NULL DEFAULT 'new'\n);\n\n-- Create trigger function for high_salary_alert\nCREATE OR REPLACE FUNCTION employees.fn_high_salary_alert()\nRETURNS TRIGGER AS $$\nBEGIN\n    IF NEW.amount > 120000 THEN\n        INSERT INTO employees.salary_alerts(employee_id, salary_amount, alert_date, status)\n        VALUES (NEW.employee_id, NEW.amount, CURRENT_TIMESTAMP, 'new');\n    END IF;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- Create trigger high_salary_alert on salary table\nDROP TRIGGER IF EXISTS high_salary_alert ON employees.salary;\nCREATE TRIGGER high_salary_alert\nAFTER INSERT ON employees.salary\nFOR EACH ROW\nEXECUTE FUNCTION employees.fn_high_salary_alert();"}
