| execute_sql {"sql": "-- Step 2: Insert historical player statistics into player_evaluation\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n  pos.person_id,\n  CASE WHEN SUM(pos.at_bats) = 0 THEN 0 ELSE CAST(SUM(pos.hits) AS DECIMAL) / SUM(pos.at_bats) END AS batting_avg,\n  COALESCE(SUM(pos.home_runs), 0) AS home_runs,\n  COALESCE(SUM(pos.rbi), 0) AS rbis,\n  COALESCE(COUNT(DISTINCT pem.game_id), 0) AS games_played,\n  (CASE WHEN SUM(pos.at_bats) = 0 THEN 0 ELSE CAST(SUM(pos.hits) AS DECIMAL) / SUM(pos.at_bats) END) * 1000 + \n  COALESCE(SUM(pos.home_runs), 0) * 5 +\n  COALESCE(SUM(pos.rbi), 0) * 2 AS performance_score,\n  DATE '2024-01-01' AS evaluation_date\nFROM\n  baseball_offensive_stats pos\n  LEFT JOIN person_event_metadata pem ON pos.person_id = pem.person_id\nGROUP BY\n  pos.person_id\nHAVING\n  COALESCE(COUNT(DISTINCT pem.game_id), 0) >= 10;"}
