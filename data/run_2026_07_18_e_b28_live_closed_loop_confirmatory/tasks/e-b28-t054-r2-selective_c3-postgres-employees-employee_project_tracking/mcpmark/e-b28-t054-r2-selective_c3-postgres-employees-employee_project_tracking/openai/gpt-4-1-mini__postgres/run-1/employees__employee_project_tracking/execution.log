epartment = 'Customer Service' AND pd.project_name = 'HR Analytics Dashboard')\n)\nWHERE e.department IN ('Development', 'Human Resources', 'Marketing', 'Finance', 'Sales', 'Research', 'Production', 'Quality Management', 'Customer Service');"}
