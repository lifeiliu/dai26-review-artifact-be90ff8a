| execute_sql {"sql": "INSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n  s.person_id,\n  CASE WHEN COALESCE(s.at_bats, 0) = 0 THEN 0 ELSE COALESCE(s.hits, 0)::DECIMAL / s.at_bats END AS batting_avg,\n  COALESCE(s.home_runs, 0) AS home_runs,\n  COALESCE(s.rbi, 0) AS rbis,\n  COALESCE(m.games_played, 0) AS games_played,\n  (CASE WHEN COALESCE(s.at_bats, 0) = 0 THEN 0 ELSE COALESCE(s.hits, 0)::DECIMAL / s.at_bats END * 1000) +\n  (COALESCE(s.home_runs, 0) * 5) +\n  (COALESCE(s.rbi, 0) * 2) AS performance_score,\n  DATE '2024-01-01' AS evaluation_date\nFROM\n  baseball_offensive_stats s\nLEFT JOIN (\n  SELECT person_id, COUNT(DISTINCT event_id) AS games_played\n  FROM person_event_metadata\n  GROUP BY person_id\n) m ON s.person_id = m.person_id\nWHERE COALESCE(m.games_played, 0) >= 10;"}
