| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n  TO_CHAR(invoicedate, 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT invoiceid) AS total_invoices,\n  SUM(total) AS total_revenue,\n  SUM(iline.quantity) AS total_tracks_sold,\n  AVG(total) AS average_invoice_value,\n  COUNT(DISTINCT customerid) AS unique_customers\nFROM invoice inv\nJOIN invoiceline iline ON inv.invoiceid = iline.invoiceid\nGROUP BY year_month\nORDER BY year_month;"}
| list_schemas {}
| list_objects {"schema_name": "public","object_type": "table"}
| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n  TO_CHAR(i.\"InvoiceDate\", 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT i.\"InvoiceId\") AS total_invoices,\n  SUM(i.\"Total\") AS total_revenue,\n  SUM(il.\"Quantity\") AS total_tracks_sold,\n  AVG(i.\"Total\") AS average_invoice_value,\n  COUNT(DISTINCT i.\"CustomerId\") AS unique_customers\nFROM public.\"Invoice\" i\nJOIN public.\"InvoiceLine\" il ON i.\"InvoiceId\" = il.\"InvoiceId\"\nGROUP BY year_month\nORDER BY year_month;"}
| execute_sql {"sql": "WITH TopTracks AS (\n  SELECT il.\"TrackId\" AS item_id, t.\"Name\" AS item_name, SUM(il.\"Quantity\") AS total_quantity, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  GROUP BY il.\"TrackId\", t.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_quantity DESC, item_name ASC\n  LIMIT 10\n),\nTopAlbums AS (\n  SELECT a.\"AlbumId\" AS item_id, a.\"Title\" AS item_name, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  JOIN public.\"Album\" a ON t.\"AlbumId\" = a.\"AlbumId\"\n  GROUP BY a.\"AlbumId\", a.\"Title\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name ASC\n  LIMIT 10\n),\nTopArtists AS (\n  SELECT ar.\"ArtistId\" AS item_id, ar.\"Name\" AS item_name, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  JOIN public.\"Album\" a ON t.\"AlbumId\" = a.\"AlbumId\"\n  JOIN public.\"Artist\" ar ON a.\"ArtistId\" = ar.\"ArtistId\"\n  GROUP BY ar.\"ArtistId\", ar.\"Name\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name ASC\n  LIMIT 10\n}\n\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM TopTracks\nUNION ALL\nSELECT 'top_albums' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM TopAlbums\nUNION ALL\nSELECT 'top_artists' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM TopArtists\nORDER BY chart_type, rank_position;"}
| execute_sql {"sql": "WITH TopTracks AS (\n  SELECT il.\"TrackId\" AS item_id, t.\"Name\" AS item_name, SUM(il.\"Quantity\") AS total_quantity, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  GROUP BY il.\"TrackId\", t.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_quantity DESC, item_name ASC\n  LIMIT 10\n),\nTopAlbums AS (\n  SELECT a.\"AlbumId\" AS item_id, a.\"Title\" AS item_name, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  JOIN public.\"Album\" a ON t.\"AlbumId\" = a.\"AlbumId\"\n  GROUP BY a.\"AlbumId\", a.\"Title\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name ASC\n  LIMIT 10\n),\nTopArtists AS (\n  SELECT ar.\"ArtistId\" AS item_id, ar.\"Name\" AS item_name, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  JOIN public.\"Album\" a ON t.\"AlbumId\" = a.\"AlbumId\"\n  JOIN public.\"Artist\" ar ON a.\"ArtistId\" = ar.\"ArtistId\"\n  GROUP BY ar.\"ArtistId\", ar.\"Name\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name ASC\n  LIMIT 10\n)\n\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM TopTracks\nUNION ALL\nSELECT 'top_albums' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM TopAlbums\nUNION ALL\nSELECT 'top_artists' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM TopArtists\nORDER BY chart_type, rank_position;"}
