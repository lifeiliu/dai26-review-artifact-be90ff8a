| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(de.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       dm.manager_name\nFROM employees.department d\nJOIN employees.department_employee de ON d.department_id = de.department_id\nJOIN employees.employee e ON de.employee_id = e.employee_id\nJOIN employees.salary s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.department_manager dm ON d.department_id = dm.department_id AND dm.to_date = '9999-01-01'\nWHERE e.status = 'active'\nGROUP BY d.department_name, dm.manager_name;\n\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nSELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n       COUNT(e.employee_id) AS employees_hired,\n       AVG(s.amount) AS avg_starting_salary,\n       100.0 * SUM(CASE WHEN e.status = 'active' THEN 1 ELSE 0 END) / COUNT(e.employee_id) AS retention_rate,\n       (SELECT d.department_name\n        FROM employees.department d\n        JOIN employees.department_employee de ON d.department_id = de.department_id\n        JOIN employees.employee e2 ON de.employee_id = e2.employee_id\n        WHERE EXTRACT(YEAR FROM e2.hire_date) = EXTRACT(YEAR FROM e.hire_date)\n        GROUP BY d.department_name\n        ORDER BY COUNT(e2.employee_id) DESC\n        LIMIT 1) AS top_hiring_department\nFROM employees.employee e\nJOIN employees.salary s ON e.employee_id = s.employee_id AND s.from_date = e.hire_date\nGROUP BY hire_year;\n\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT e.employee_id,\n         s.amount,\n         CASE\n           WHEN s.amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n           WHEN s.amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n           WHEN s.amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n           WHEN s.amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n           ELSE '110K+'\n         END AS salary_band\n  FROM employees.employee e\n  JOIN employees.salary s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\n)\nSELECT salary_band,\n       COUNT(employee_id) AS employee_count,\n       100.0 * COUNT(employee_id) / (SELECT COUNT(*) FROM employees.employee WHERE status = 'active') AS percentage_of_workforce,\n       (SELECT t.title_name\n        FROM employees.title t\n        JOIN employees.employee e ON t.title_id = e.title_id\n        JOIN salary_bands sb ON e.employee_id = sb.employee_id\n        WHERE sb.salary_band = s.salary_band\n        GROUP BY t.title_name\n        ORDER BY COUNT(*) DESC\n        LIMIT 1) AS most_common_title\nFROM salary_bands s\nGROUP BY salary_band;"}
