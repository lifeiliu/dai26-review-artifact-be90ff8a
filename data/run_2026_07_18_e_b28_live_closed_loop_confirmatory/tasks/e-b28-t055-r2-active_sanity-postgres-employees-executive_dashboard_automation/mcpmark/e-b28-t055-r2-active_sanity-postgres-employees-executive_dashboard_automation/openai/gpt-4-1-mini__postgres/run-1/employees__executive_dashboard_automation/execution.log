| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n    SELECT '30K-50K'::varchar AS salary_band, 30000 AS min_salary, 49999 AS max_salary UNION ALL\n    SELECT '50K-70K', 50000, 69999 UNION ALL\n    SELECT '70K-90K', 70000, 89999 UNION ALL\n    SELECT '90K-110K', 90000, 109999 UNION ALL\n    SELECT '110K+', 110000, 1000000000\n),\ncurrent_salaries AS (\n    SELECT employee_id, amount FROM employees.salary\n    WHERE to_date = '9999-01-01'\n),\nband_counts AS (\n    SELECT sb.salary_band,\n           COUNT(e.id) AS employee_count,\n           COUNT(e.id)::decimal / (SELECT COUNT(*) FROM employees.employee WHERE to_date = '9999-01-01') AS percentage_of_workforce\n    FROM salary_bands sb\n    LEFT JOIN current_salaries s ON s.amount BETWEEN sb.min_salary AND sb.max_salary\n    LEFT JOIN employees.employee e ON s.employee_id = e.id AND e.to_date = '9999-01-01'\n    GROUP BY sb.salary_band\n),\ncommon_titles AS (\n    SELECT sb.salary_band,\n        (SELECT t.title\n         FROM employees.title t\n         JOIN employees.salary s ON t.employee_id = s.employee_id\n         WHERE s.amount BETWEEN sb.min_salary AND sb.max_salary\n           AND s.to_date = '9999-01-01'\n         GROUP BY t.title\n         ORDER BY COUNT(*) DESC\n         LIMIT 1) AS most_common_title\n    FROM salary_bands sb\n)\nSELECT bc.salary_band, bc.employee_count, bc.percentage_of_workforce, ct.most_common_title\nFROM band_counts bc\nJOIN common_titles ct ON bc.salary_band = ct.salary_band\nORDER BY bc.salary_band;"}
