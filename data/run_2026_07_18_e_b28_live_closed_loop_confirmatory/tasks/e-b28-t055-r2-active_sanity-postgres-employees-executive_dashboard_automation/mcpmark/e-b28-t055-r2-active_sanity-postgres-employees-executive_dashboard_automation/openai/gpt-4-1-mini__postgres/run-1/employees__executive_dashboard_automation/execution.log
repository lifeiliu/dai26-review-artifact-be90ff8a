| execute_sql {"sql": "CREATE TABLE IF NOT EXISTS employees.monthly_reports (\n    report_id SERIAL PRIMARY KEY,\n    report_date DATE NOT NULL,\n    department_count INTEGER NOT NULL,\n    total_employees INTEGER NOT NULL,\n    avg_salary DECIMAL NOT NULL,\n    generated_at TIMESTAMP NOT NULL DEFAULT now()\n);"}
| execute_sql {"sql": "CREATE OR REPLACE FUNCTION employees.generate_monthly_report(report_date DATE) RETURNS INTEGER AS $$\nDECLARE\n    dept_count INTEGER;\n    total_emp INTEGER;\n    avg_sal DECIMAL;\n    new_report_id INTEGER;\nBEGIN\n    SELECT COUNT(DISTINCT department_id) INTO dept_count FROM employees.department_employee WHERE to_date = '9999-01-01';\n    SELECT COUNT(id) INTO total_emp FROM employees.employee;\n    SELECT AVG(amount) INTO avg_sal FROM employees.salary WHERE to_date = '9999-01-01';\n\n    INSERT INTO employees.monthly_reports(report_date, department_count, total_employees, avg_salary, generated_at)\n    VALUES (report_date, dept_count, total_emp, avg_sal, now()) RETURNING report_id INTO new_report_id;\n\n    RETURN new_report_id;\nEND;\n$$ LANGUAGE plpgsql;"}
| execute_sql {"sql": "CREATE TABLE IF NOT EXISTS employees.salary_alerts (\n    alert_id SERIAL PRIMARY KEY,\n    employee_id BIGINT NOT NULL,\n    salary_amount BIGINT NOT NULL,\n    alert_date TIMESTAMP NOT NULL DEFAULT now(),\n    status VARCHAR(20) NOT NULL DEFAULT 'new'\n);"}
| execute_sql {"sql": "CREATE OR REPLACE FUNCTION employees.check_high_salary() RETURNS TRIGGER AS $$\nBEGIN\n    IF NEW.amount > 120000 THEN\n        INSERT INTO employees.salary_alerts(employee_id, salary_amount, alert_date, status)\n        VALUES (NEW.employee_id, NEW.amount, now(), 'new');\n    END IF;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER high_salary_alert\nAFTER INSERT ON employees.salary\nFOR EACH ROW EXECUTE FUNCTION employees.check_high_salary();"}
