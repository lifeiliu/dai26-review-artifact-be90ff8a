| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(e.employee_id) AS total_employees,\n       AVG(s.salary_amount) AS avg_salary,\n       SUM(s.salary_amount) AS total_payroll,\n       m.manager_name\nFROM employees.departments d\nJOIN employees.employees e ON d.department_id = e.department_id\nJOIN employees.salaries s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN (\n    SELECT department_id, manager_name\n    FROM employees.department_managers\n    WHERE to_date = '9999-01-01'\n) m ON d.department_id = m.department_id\nWHERE e.to_date = '9999-01-01'\nGROUP BY d.department_name, m.manager_name;"}
| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH yearly_hires AS (\n    SELECT EXTRACT(YEAR FROM hire_date) AS hire_year,\n           COUNT(employee_id) AS employees_hired,\n           AVG(start_salary) AS avg_starting_salary\n    FROM employees.employees\n    GROUP BY hire_year\n),\nretention AS (\n    SELECT EXTRACT(YEAR FROM hire_date) AS hire_year,\n           COUNT(employee_id) FILTER (WHERE to_date = '9999-01-01')::float / COUNT(employee_id) AS retention_rate\n    FROM employees.employees\n    GROUP BY hire_year\n),\nhiring_dept AS (\n    SELECT EXTRACT(YEAR FROM hire_date) AS hire_year,\n           department_id,\n           COUNT(employee_id) AS dept_hires\n    FROM employees.employees\n    GROUP BY hire_year, department_id\n),\ntop_department AS (\n    SELECT hire_year,\n           (SELECT department_name FROM employees.departments d WHERE d.department_id = hd.department_id) AS top_hiring_department\n    FROM (\n        SELECT hire_year, department_id,\n               RANK() OVER (PARTITION BY hire_year ORDER BY dept_hires DESC) AS rnk\n        FROM hiring_dept\n    ) hd\n    WHERE rnk = 1\n)\nSELECT yh.hire_year,\n       yh.employees_hired,\n       yh.avg_starting_salary,\n       COALESCE(r.retention_rate, 0) AS retention_rate,\n       td.top_hiring_department\nFROM yearly_hires yh\nLEFT JOIN retention r ON yh.hire_year = r.hire_year\nLEFT JOIN top_department td ON yh.hire_year = td.hire_year\nORDER BY yh.hire_year;"}
| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n    SELECT '30K-50K'::varchar AS salary_band, 30000 AS min_salary, 49999 AS max_salary UNION ALL\n    SELECT '50K-70K', 50000, 69999 UNION ALL\n    SELECT '70K-90K', 70000, 89999 UNION ALL\n    SELECT '90K-110K', 90000, 109999 UNION ALL\n    SELECT '110K+', 110000, 1000000000\n),\nband_counts AS (\n    SELECT sb.salary_band,\n           COUNT(e.employee_id) AS employee_count,\n           COUNT(e.employee_id)::decimal / SUM(COUNT(e.employee_id)) OVER () AS percentage_of_workforce\n    FROM salary_bands sb\n    LEFT JOIN employees.employees e ON (\n        EXISTS (\n            SELECT 1\n            FROM employees.salaries s\n            WHERE s.employee_id = e.employee_id\n              AND s.salary_amount BETWEEN sb.min_salary AND sb.max_salary\n              AND s.to_date = '9999-01-01'\n        )\n        AND e.to_date = '9999-01-01'\n    )\n    GROUP BY sb.salary_band\n),\ncommon_titles AS (\n    SELECT sb.salary_band,\n           (SELECT jt.job_title\n            FROM employees.job_titles jt\n            JOIN employees.salaries s ON jt.job_id = s.job_id\n            JOIN employees.employees e ON s.employee_id = e.employee_id\n            WHERE s.salary_amount BETWEEN sb.min_salary AND sb.max_salary\n              AND s.to_date = '9999-01-01'\n              AND e.to_date = '9999-01-01'\n            GROUP BY jt.job_title\n            ORDER BY COUNT(*) DESC\n            LIMIT 1) AS most_common_title\n    FROM salary_bands sb\n)\nSELECT bc.salary_band, bc.employee_count, bc.percentage_of_workforce, ct.most_common_title\nFROM band_counts bc\nJOIN common_titles ct ON bc.salary_band = ct.salary_band\nORDER BY bc.salary_band;"}
