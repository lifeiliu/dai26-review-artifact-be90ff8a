| execute_sql {"sql": "-- Step 3 continued: Insert data into player_injury_status\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT\n    pe.person_id,\n    COALESCE(COUNT(ip.id), 0) AS injury_count,\n    MAX(ip.start_date) AS last_injury_date,\n    CASE WHEN MAX(ip.end_date) IS NULL THEN 'injured' ELSE 'healthy' END AS current_status\nFROM (SELECT DISTINCT person_id FROM player_evaluation) pe\nLEFT JOIN injury_phases ip ON ip.person_id = pe.person_id\nGROUP BY pe.person_id;\n"}
