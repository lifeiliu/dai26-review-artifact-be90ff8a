| execute_sql {"sql": "-- Step 4: Update player_evaluation scores based on injury status reductions\nUPDATE player_evaluation pe\nSET performance_score = \n    CASE \n        WHEN pis.current_status = 'injured' THEN GREATEST(pe.performance_score * 0.8, 0)\n        WHEN pis.injury_count > 2 THEN GREATEST(pe.performance_score * 0.9, 0)\n        ELSE pe.performance_score\n    END\nFROM player_injury_status pis\nWHERE pe.person_id = pis.person_id;"}
