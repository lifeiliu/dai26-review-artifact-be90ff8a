| execute_sql {"sql": "-- Plan: Use baseball_defensive_players to get player_id linked to baseball_offensive_stats by baseball_defensive_group_id through baseball_action_plays\n-- so we join baseball_offensive_stats -> baseball_action_plays -> baseball_defensive_players\n\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n    bdp.player_id AS person_id,\n    CASE WHEN SUM(bos.at_bats) = 0 THEN 0 ELSE SUM(bos.hits)::DECIMAL / SUM(bos.at_bats) END AS batting_avg,\n    COALESCE(SUM(bos.home_runs), 0) AS home_runs,\n    COALESCE(SUM(bos.rbi), 0) AS rbis,\n    COALESCE(COUNT(DISTINCT pem.event_id), 0) AS games_played,\n    \n    (CASE WHEN SUM(bos.at_bats) = 0 THEN 0 ELSE SUM(bos.hits)::DECIMAL / SUM(bos.at_bats) END) * 1000 +\n    COALESCE(SUM(bos.home_runs), 0) * 5 +\n    COALESCE(SUM(bos.rbi), 0) * 2 AS performance_score,\n    '2024-01-01'::DATE AS evaluation_date\nFROM baseball_offensive_stats bos\nJOIN baseball_action_plays bap ON bap.id = bos.id\nJOIN baseball_defensive_players bdp ON bdp.baseball_defensive_group_id = bap.baseball_defensive_group_id\nLEFT JOIN person_event_metadata pem ON bdp.player_id = pem.person_id\nGROUP BY bdp.player_id\nHAVING COUNT(DISTINCT pem.event_id) >= 10;"}
