| execute_sql {"sql": "WITH monthly_data AS (\n  SELECT\n    TO_CHAR(\"Invoice\".\"InvoiceDate\", 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT \"Invoice\".\"InvoiceId\") AS total_invoices,\n    SUM(\"Invoice\".\"Total\") AS total_revenue,\n    SUM(\"InvoiceLine\".\"Quantity\") AS total_tracks_sold,\n    AVG(\"Invoice\".\"Total\") AS average_invoice_value,\n    COUNT(DISTINCT \"Invoice\".\"CustomerId\") AS unique_customers\n  FROM public.\"Invoice\"\n  JOIN public.\"InvoiceLine\" ON \"Invoice\".\"InvoiceId\" = \"InvoiceLine\".\"InvoiceId\"\n  GROUP BY year_month\n  HAVING COUNT(DISTINCT \"Invoice\".\"InvoiceId\") > 0\n)\nINSERT INTO public.monthly_sales_summary\nSELECT year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers\nFROM monthly_data;"}
| execute_sql {"sql": "TRUNCATE TABLE public.top_music_charts;"}
| execute_sql {"sql": "WITH TopTracks AS (\n  SELECT \n    il.TrackId AS item_id, \n    t.Name AS item_name, \n    SUM(il.Quantity) AS total_quantity_sold, \n    SUM(il.UnitPrice * il.Quantity) AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.TrackId = t.TrackId\n  GROUP BY il.TrackId, t.Name\n  HAVING SUM(il.Quantity) > 0\n  ORDER BY total_quantity_sold DESC, item_name ASC\n  LIMIT 10\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks', ROW_NUMBER() OVER (ORDER BY total_quantity_sold DESC, item_name ASC), item_id, item_name, total_revenue\nFROM TopTracks;"}
| execute_sql {"sql": "WITH AlbumRevenue AS (\n  SELECT \n    al.AlbumId AS item_id, \n    al.Title AS item_name, \n    SUM(il.UnitPrice * il.Quantity) AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.TrackId = t.TrackId\n  JOIN public.\"Album\" al ON t.AlbumId = al.AlbumId\n  GROUP BY al.AlbumId, al.Title\n  HAVING SUM(il.UnitPrice * il.Quantity) > 0\n  ORDER BY total_revenue DESC, item_name ASC\n  LIMIT 10\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_albums', ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC), item_id, item_name, total_revenue\nFROM AlbumRevenue;"}
| execute_sql {"sql": "WITH ArtistRevenue AS (\n  SELECT \n    ar.ArtistId AS item_id, \n    ar.Name AS item_name, \n    SUM(il.UnitPrice * il.Quantity) AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.TrackId = t.TrackId\n  JOIN public.\"Album\" al ON t.AlbumId = al.AlbumId\n  JOIN public.\"Artist\" ar ON al.ArtistId = ar.ArtistId\n  GROUP BY ar.ArtistId, ar.Name\n  HAVING SUM(il.UnitPrice * il.Quantity) > 0\n  ORDER BY total_revenue DESC, item_name ASC\n  LIMIT 10\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_artists', ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC), item_id, item_name, total_revenue\nFROM ArtistRevenue;"}
