| execute_sql {"sql": "WITH monthly_data AS (\n  SELECT\n    TO_CHAR(invoicedate, 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT invoiceid) AS total_invoices,\n    SUM(total) AS total_revenue,\n    SUM(quantity) AS total_tracks_sold,\n    AVG(total) AS average_invoice_value,\n    COUNT(DISTINCT customerid) AS unique_customers\n  FROM invoice\n  JOIN invoice_line USING (invoiceid)\n  GROUP BY year_month\n  HAVING COUNT(DISTINCT invoiceid) > 0\n)\nINSERT INTO public.monthly_sales_summary\nSELECT year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers\nFROM monthly_data;"}
