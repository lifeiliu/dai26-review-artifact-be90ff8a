| execute_sql {"sql": "-- Aggregate and load historical player statistics for step 2\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n  pem.person_id,\n  CASE WHEN SUM(bos.at_bats) > 0 THEN SUM(bos.hits)::decimal / SUM(bos.at_bats) ELSE 0 END AS batting_avg,\n  COALESCE(SUM(bos.home_runs), 0) AS home_runs,\n  COALESCE(SUM(bos.rbi), 0) AS rbis,\n  COALESCE(COUNT(DISTINCT pem.event_id), 0) AS games_played,\n  (CASE WHEN SUM(bos.at_bats) > 0 THEN SUM(bos.hits)::decimal / SUM(bos.at_bats) ELSE 0 END * 1000) +\n  (COALESCE(SUM(bos.home_runs), 0) * 5) + (COALESCE(SUM(bos.rbi), 0) * 2) AS performance_score,\n  DATE '2024-01-01' AS evaluation_date\nFROM person_event_metadata pem\nJOIN baseball_event_states bes ON pem.event_id = bes.event_id\nJOIN baseball_offensive_stats bos ON bes.id = bos.id\nGROUP BY pem.person_id\nHAVING COALESCE(COUNT(DISTINCT pem.event_id), 0) >= 10;"}
| execute_sql {"sql": "-- Step 3: Create player_injury_status table\nCREATE TABLE player_injury_status (\n    status_id SERIAL PRIMARY KEY,\n    person_id INTEGER UNIQUE NOT NULL,\n    injury_count INTEGER DEFAULT 0,\n    last_injury_date DATE,\n    current_status VARCHAR CHECK (current_status IN ('healthy', 'injured', 'recovering'))\n);"}
| execute_sql {"sql": "-- Insert initial data into player_injury_status based on player_evaluation and injury_phases\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT\n  pe.person_id,\n  COALESCE(COUNT(ip.person_id), 0) AS injury_count,\n  MAX(ip.start_date) AS last_injury_date,\n  CASE WHEN MAX(ip.end_date) IS NULL AND COUNT(ip.person_id) > 0 THEN 'injured' ELSE 'healthy' END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON pe.person_id = ip.person_id\nGROUP BY pe.person_id;"}
| execute_sql {"sql": "-- Check injury_phases table columns\nSELECT column_name FROM information_schema.columns WHERE table_name='injury_phases';"}
| execute_sql {"sql": "-- Use correct columns start_date_time and end_date_time\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT\n  pe.person_id,\n  COALESCE(COUNT(ip.person_id), 0) AS injury_count,\n  MAX(ip.start_date_time)::date AS last_injury_date,\n  CASE WHEN MAX(ip.end_date_time) IS NULL AND COUNT(ip.person_id) > 0 THEN 'injured' ELSE 'healthy' END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON pe.person_id = ip.person_id\nGROUP BY pe.person_id\nON CONFLICT (person_id) DO NOTHING;"}
| execute_sql {"sql": "-- Step 4: Update performance scores based on health\nUPDATE player_evaluation pe\nSET performance_score = \n  CASE\n    WHEN pis.current_status = 'injured' THEN GREATEST(pe.performance_score * 0.8, 0)\n    WHEN pis.injury_count > 2 THEN GREATEST(pe.performance_score * 0.9, 0)\n    ELSE pe.performance_score\n  END\nFROM player_injury_status pis\nWHERE pe.person_id = pis.person_id;"}
