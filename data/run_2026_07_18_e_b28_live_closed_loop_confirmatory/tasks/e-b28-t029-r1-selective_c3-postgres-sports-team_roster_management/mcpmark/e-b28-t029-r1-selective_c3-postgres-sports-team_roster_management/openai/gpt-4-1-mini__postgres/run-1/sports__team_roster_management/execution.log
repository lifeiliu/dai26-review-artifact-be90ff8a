| execute_sql {"sql": "CREATE TABLE player_evaluation (\n    performance_id SERIAL PRIMARY KEY,\n    person_id INTEGER NOT NULL,\n    batting_avg DECIMAL CHECK (batting_avg BETWEEN 0 AND 1),\n    home_runs INTEGER,\n    rbis INTEGER,\n    games_played INTEGER,\n    performance_score DECIMAL,\n    evaluation_date DATE\n);"}
| execute_sql {"sql": "-- Step 2: Insert player performance data into player_evaluation\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n    bos.person_id,\n    CASE WHEN SUM(bos.at_bats) > 0 THEN SUM(bos.hits)::decimal / SUM(bos.at_bats) ELSE 0 END AS batting_avg,\n    COALESCE(SUM(bos.home_runs), 0) AS home_runs,\n    COALESCE(SUM(bos.rbi), 0) AS rbis,\n    COALESCE(COUNT(DISTINCT pem.event_id), 0) AS games_played,\n    (CASE WHEN SUM(bos.at_bats) > 0 THEN SUM(bos.hits)::decimal / SUM(bos.at_bats) ELSE 0 END * 1000) +\n    (COALESCE(SUM(bos.home_runs), 0) * 5) + (COALESCE(SUM(bos.rbi), 0) * 2) AS performance_score,\n    DATE '2024-01-01' AS evaluation_date\nFROM\n    baseball_offensive_stats bos\nLEFT JOIN\n    person_event_metadata pem ON bos.person_id = pem.person_id\nGROUP BY bos.person_id\nHAVING COALESCE(COUNT(DISTINCT pem.event_id), 0) >= 10;"}
