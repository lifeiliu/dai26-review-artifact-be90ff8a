| execute_sql {"sql": "-- Step 1: Create materialized views in employees schema\nCREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(e.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       m.manager_name\nFROM employees.departments d\nJOIN employees.employees e ON d.department_id = e.department_id AND e.current_flag = true\nJOIN employees.salaries s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.department_managers m ON d.department_id = m.department_id AND m.to_date = '9999-01-01'\nGROUP BY d.department_name, m.manager_name;\n\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hire_info AS (\n  SELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n         e.employee_id,\n         s.amount AS starting_salary,\n         e.department_id\n  FROM employees.employees e\n  JOIN employees.salaries s ON e.employee_id = s.employee_id\n  WHERE s.from_date = e.hire_date\n),\nretained AS (\n  SELECT hire_year,\n         COUNT(employee_id) AS hired,\n         AVG(starting_salary) AS avg_starting_salary,\n         COUNT(CASE WHEN e.current_flag THEN 1 END) AS retained_count\n  FROM hire_info h\n  JOIN employees.employees e ON h.employee_id = e.employee_id\n  GROUP BY hire_year\n),\ntop_dept AS (\n  SELECT hire_year,\n         department_id,\n         COUNT(employee_id) AS dept_hires,\n         ROW_NUMBER() OVER (PARTITION BY hire_year ORDER BY COUNT(employee_id) DESC) AS rn\n  FROM hire_info\n  GROUP BY hire_year, department_id\n)\nSELECT r.hire_year,\n       r.hired AS employees_hired,\n       r.avg_starting_salary,\n       CASE WHEN r.hired = 0 THEN 0 ELSE r.retained_count::decimal / r.hired END AS retention_rate,\n       d.department_name AS top_hiring_department\nFROM retained r\nLEFT JOIN top_dept t ON r.hire_year = t.hire_year AND t.rn = 1\nLEFT JOIN employees.departments d ON t.department_id = d.department_id\nORDER BY r.hire_year;\n\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT e.employee_id,\n         s.amount,\n         CASE\n           WHEN s.amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n           WHEN s.amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n           WHEN s.amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n           WHEN s.amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n           ELSE '110K+'\n         END AS salary_band\n  FROM employees.employees e\n  JOIN employees.salaries s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\n  WHERE e.current_flag = true\n),\nband_stats AS (\n  SELECT salary_band,\n         COUNT(employee_id) AS employee_count,\n         ROUND(100.0 * COUNT(employee_id) / (SELECT COUNT(*) FROM employees.employees WHERE current_flag = true), 2) AS percentage_of_workforce\n  FROM salary_bands\n  GROUP BY salary_band\n),\nmost_common_titles AS (\n  SELECT salary_band,\n         mode() WITHIN GROUP (ORDER BY e.title) AS most_common_title\n  FROM salary_bands sb\n  JOIN employees.employees e ON sb.employee_id = e.employee_id\n  GROUP BY salary_band\n)\nSELECT b.salary_band,\n       b.employee_count,\n       b.percentage_of_workforce,\n       m.most_common_title\nFROM band_stats b\nJOIN most_common_titles m ON b.salary_band = m.salary_band\nORDER BY b.salary_band;"}
| execute_sql {"sql": "-- Step 2: Create stored procedure generate_monthly_report\nCREATE TABLE IF NOT EXISTS employees.monthly_reports (\n  report_id SERIAL PRIMARY KEY,\n  report_date DATE NOT NULL,\n  department_count INTEGER NOT NULL,\n  total_employees INTEGER NOT NULL,\n  avg_salary DECIMAL NOT NULL,\n  generated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now()\n);\n\nCREATE OR REPLACE PROCEDURE employees.generate_monthly_report(report_date DATE)\nLANGUAGE plpgsql\nAS $$\nDECLARE\n  dept_count INT;\n  total_emp INT;\n  avg_sal DECIMAL;\n  new_report_id INT;\nBEGIN\n  SELECT COUNT(*) INTO dept_count FROM employees.departments;\n  SELECT COUNT(*) INTO total_emp FROM employees.employees WHERE current_flag = true;\n  SELECT AVG(s.amount) INTO avg_sal FROM employees.salaries s JOIN employees.employees e ON s.employee_id = e.employee_id WHERE e.current_flag = true AND s.to_date = '9999-01-01';\n\n  INSERT INTO employees.monthly_reports(report_date, department_count, total_employees, avg_salary)\n  VALUES (report_date, dept_count, total_emp, avg_sal)\n  RETURNING report_id INTO new_report_id;\n\n  RETURN new_report_id;\nEND;\n$$;"}
| execute_sql {"sql": "-- Step 3: Create trigger and trigger function for high_salary_alert\nCREATE TABLE IF NOT EXISTS employees.salary_alerts (\n  alert_id SERIAL PRIMARY KEY,\n  employee_id INT NOT NULL,\n  salary_amount DECIMAL NOT NULL,\n  alert_date TIMESTAMP WITHOUT TIME ZONE DEFAULT now(),\n  status VARCHAR(20) DEFAULT 'new'\n);\n\nCREATE OR REPLACE FUNCTION employees.high_salary_alert()\nRETURNS TRIGGER AS $$\nBEGIN\n  IF NEW.amount > 120000 THEN\n    INSERT INTO employees.salary_alerts(employee_id, salary_amount, alert_date, status)\n    VALUES (NEW.employee_id, NEW.amount, now(), 'new');\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nDROP TRIGGER IF EXISTS trg_high_salary_alert ON employees.salaries;\nCREATE TRIGGER trg_high_salary_alert\nAFTER INSERT ON employees.salaries\nFOR EACH ROW\nEXECUTE FUNCTION employees.high_salary_alert();"}
