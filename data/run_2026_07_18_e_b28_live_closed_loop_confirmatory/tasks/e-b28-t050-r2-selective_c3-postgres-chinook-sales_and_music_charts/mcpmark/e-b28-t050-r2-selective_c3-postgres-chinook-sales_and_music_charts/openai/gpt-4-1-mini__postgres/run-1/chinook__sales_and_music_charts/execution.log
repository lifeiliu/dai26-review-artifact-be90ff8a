| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n    TO_CHAR(\"Invoice\".invoicedate, 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT \"Invoice\".invoiceid) AS total_invoices,\n    SUM(\"Invoice\".total) AS total_revenue,\n    SUM(\"InvoiceLine\".quantity) AS total_tracks_sold,\n    AVG(\"Invoice\".total) AS average_invoice_value,\n    COUNT(DISTINCT \"Invoice\".customerid) AS unique_customers\nFROM\n    \"Invoice\"\nJOIN\n    \"InvoiceLine\" ON \"Invoice\".invoiceid = \"InvoiceLine\".invoiceid\nGROUP BY\n    TO_CHAR(\"Invoice\".invoicedate, 'YYYY-MM')\nORDER BY\n    year_month;"}
| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n    TO_CHAR(\"Invoice\".\"InvoiceDate\", 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT \"Invoice\".\"InvoiceId\") AS total_invoices,\n    SUM(\"Invoice\".\"Total\") AS total_revenue,\n    SUM(\"InvoiceLine\".\"Quantity\") AS total_tracks_sold,\n    AVG(\"Invoice\".\"Total\") AS average_invoice_value,\n    COUNT(DISTINCT \"Invoice\".\"CustomerId\") AS unique_customers\nFROM\n    \"Invoice\"\nJOIN\n    \"InvoiceLine\" ON \"Invoice\".\"InvoiceId\" = \"InvoiceLine\".\"InvoiceId\"\nGROUP BY\n    TO_CHAR(\"Invoice\".\"InvoiceDate\", 'YYYY-MM')\nORDER BY\n    year_month;"}
| execute_sql {"sql": "WITH top_tracks AS (\n    SELECT \n        \"Track\".\"TrackId\" AS item_id, \n        \"Track\".\"Name\" AS item_name, \n        SUM(\"InvoiceLine\".\"Quantity\") AS total_quantity, \n        SUM(\"InvoiceLine\".\"UnitPrice\" * \"InvoiceLine\".\"Quantity\") AS total_revenue\n    FROM \"InvoiceLine\"\n    JOIN \"Track\" ON \"InvoiceLine\".\"TrackId\" = \"Track\".\"TrackId\"\n    GROUP BY \"Track\".\"TrackId\", \"Track\".\"Name\"\n    HAVING SUM(\"InvoiceLine\".\"Quantity\") > 0\n    ORDER BY total_quantity DESC, item_name ASC\n    LIMIT 10\n), \ntop_albums AS (\n    SELECT \n        \"Album\".\"AlbumId\" AS item_id, \n        \"Album\".\"Title\" AS item_name, \n        SUM(\"InvoiceLine\".\"UnitPrice\" * \"InvoiceLine\".\"Quantity\") AS total_revenue\n    FROM \"InvoiceLine\"\n    JOIN \"Track\" ON \"InvoiceLine\".\"TrackId\" = \"Track\".\"TrackId\"\n    JOIN \"Album\" ON \"Track\".\"AlbumId\" = \"Album\".\"AlbumId\"\n    GROUP BY \"Album\".\"AlbumId\", \"Album\".\"Title\"\n    HAVING SUM(\"InvoiceLine\".\"Quantity\") > 0\n    ORDER BY total_revenue DESC, item_name ASC\n    LIMIT 10\n),\ntop_artists AS (\n    SELECT \n        \"Artist\".\"ArtistId\" AS item_id, \n        \"Artist\".\"Name\" AS item_name, \n        SUM(\"InvoiceLine\".\"UnitPrice\" * \"InvoiceLine\".\"Quantity\") AS total_revenue\n    FROM \"InvoiceLine\"\n    JOIN \"Track\" ON \"InvoiceLine\".\"TrackId\" = \"Track\".\"TrackId\"\n    JOIN \"Album\" ON \"Track\".\"AlbumId\" = \"Album\".\"AlbumId\"\n    JOIN \"Artist\" ON \"Album\".\"ArtistId\" = \"Artist\".\"ArtistId\"\n    GROUP BY \"Artist\".\"ArtistId\", \"Artist\".\"Name\"\n    HAVING SUM(\"InvoiceLine\".\"Quantity\") > 0\n    ORDER BY total_revenue DESC, item_name ASC\n    LIMIT 10\n}\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM top_tracks\nUNION ALL\nSELECT 'top_albums' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM top_albums\nUNION ALL\nSELECT 'top_artists' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name ASC) AS rank_position, item_id, item_name, total_revenue FROM top_artists;"}
