| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n    TO_CHAR(invoicedate, 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT invoiceid) AS total_invoices,\n    SUM(total) AS total_revenue,\n    SUM(il.quantity) AS total_tracks_sold,\n    AVG(total) AS average_invoice_value,\n    COUNT(DISTINCT customerid) AS unique_customers\nFROM\n    invoice i\nJOIN\n    invoiceline il ON i.invoiceid = il.invoiceid\nGROUP BY\n    TO_CHAR(invoicedate, 'YYYY-MM')\nORDER BY\n    year_month;"}
