| execute_sql {"sql": "WITH project_ids AS (\n  SELECT project_id, project_name FROM employees.employee_projects\n),\nemp_dept AS (\n  SELECT id, department FROM employees.employee\n)\nINSERT INTO employees.project_assignments (employee_id, project_id, role, allocation_percentage, assigned_date)\nSELECT e.id, p.project_id, \n  CASE \n    WHEN e.department = 'Development' THEN 'Developer'\n    WHEN e.department = 'Human Resources' THEN 'Business Analyst'\n    WHEN e.department = 'Marketing' THEN 'Marketing Specialist'\n    WHEN e.department = 'Finance' THEN 'Financial Analyst'\n    WHEN e.department = 'Sales' THEN 'Sales Representative'\n    WHEN e.department = 'Research' THEN 'Research Analyst'\n    WHEN e.department = 'Production' THEN 'Production Coordinator'\n    WHEN e.department = 'Quality Management' THEN 'QA Specialist'\n    WHEN e.department = 'Customer Service' THEN 'Customer Success'\n  END as role,\n  CASE \n    WHEN e.department = 'Development' THEN 80\n    WHEN e.department = 'Human Resources' THEN 60\n    WHEN e.department = 'Marketing' THEN 40\n    WHEN e.department = 'Finance' THEN 30\n    WHEN e.department = 'Sales' THEN 50\n    WHEN e.department = 'Research' THEN 70\n    WHEN e.department = 'Production' THEN 45\n    WHEN e.department = 'Quality Management' THEN 85\n    WHEN e.department = 'Customer Service' THEN 35\n  END as allocation_percentage,\n  '2024-01-01'::date\nFROM emp_dept e\nJOIN project_ids p ON \n  (e.department = 'Development' AND p.project_name = 'Database Modernization') OR\n  (e.department = 'Human Resources' AND p.project_name = 'Employee Portal Upgrade') OR\n  (e.department = 'Marketing' AND p.project_name = 'HR Analytics Dashboard') OR\n  (e.department = 'Finance' AND p.project_name = 'Database Modernization') OR\n  (e.department = 'Sales' AND p.project_name = 'Employee Portal Upgrade') OR\n  (e.department = 'Research' AND p.project_name = 'HR Analytics Dashboard') OR\n  (e.department = 'Production' AND p.project_name = 'Database Modernization') OR\n  (e.department = 'Quality Management' AND p.project_name = 'Employee Portal Upgrade') OR\n  (e.department = 'Customer Service' AND p.project_name = 'HR Analytics Dashboard');"}
