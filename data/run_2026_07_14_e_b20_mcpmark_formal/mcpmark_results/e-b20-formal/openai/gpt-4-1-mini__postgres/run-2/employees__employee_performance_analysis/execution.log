| execute_sql {"sql": "WITH current_salaries AS (\n  SELECT employee_id, salary\n  FROM employees.salaries\n  WHERE to_date = '9999-01-01'\n),\nfirst_salaries AS (\n  SELECT employee_id, MIN(from_date) AS first_salary_date\n  FROM employees.salaries\n  GROUP BY employee_id\n),\nsalary_stats AS (\n  SELECT s.employee_id,\n         c.salary AS current_salary,\n         (SELECT salary FROM employees.salaries WHERE employee_id = s.employee_id AND from_date = f.first_salary_date) AS first_salary\n  FROM current_salaries c\n  JOIN salaries s ON c.employee_id = s.employee_id\n  JOIN first_salaries f ON s.employee_id = f.employee_id\n  WHERE c.employee_id = s.employee_id\n),\nservice_days AS (\n  SELECT employee_id, (MAX(to_date) - MIN(from_date)) AS days_of_service\n  FROM employees.salaries\n  GROUP BY employee_id\n),\npromotions AS (\n  SELECT employee_id, COUNT(DISTINCT title) AS promotion_count\n  FROM employees.job_history\n  GROUP BY employee_id\n)\nSELECT s.employee_id,\n       CASE\n         WHEN ((s.current_salary - s.first_salary) / s.first_salary) > 0.4 AND p.promotion_count > 1 THEN 'high_achiever'\n         WHEN ((s.current_salary - s.first_salary) / s.first_salary) < 0.15 AND sd.days_of_service > 3650 THEN 'needs_attention'\n         ELSE 'steady_performer'\n       END AS performance_category,\n       ((s.current_salary - s.first_salary) / s.first_salary) AS salary_growth_rate,\n       sd.days_of_service,\n       p.promotion_count\nFROM salary_stats s\nJOIN service_days sd ON s.employee_id = sd.employee_id\nJOIN promotions p ON s.employee_id = p.employee_id;"}
