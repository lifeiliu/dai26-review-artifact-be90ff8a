| execute_sql {"sql": "-- Insert performance analysis data\nWITH first_salary AS (\n  SELECT employee_id, MIN(from_date) AS first_salary_date\n  FROM employees.salary\n  GROUP BY employee_id\n),\ncurrent_salary AS (\n  SELECT employee_id, salary\n  FROM employees.salary\n  WHERE to_date = '9999-01-01'\n),\nsalary_growth AS (\n  SELECT c.employee_id,\n         c.salary AS current_salary,\n         f_salary.salary AS first_salary,\n         (c.salary - f_salary.salary) / f_salary.salary AS growth_rate\n  FROM current_salary c\n  JOIN (\n    SELECT s.employee_id, s.salary\n    FROM employees.salary s\n    JOIN first_salary f ON s.employee_id = f.employee_id AND s.from_date = f.first_salary_date\n  ) f_salary ON c.employee_id = f_salary.employee_id\n),\ndays_service AS (\n  SELECT employee_id, (MAX(to_date) - MIN(from_date)) AS days_of_service\n  FROM employees.salary\n  GROUP BY employee_id\n),\npromotions AS (\n  SELECT employee_id, COUNT(DISTINCT title) AS promotion_count\n  FROM employees.title\n  GROUP BY employee_id\n)\nINSERT INTO employees.employee_performance_analysis (employee_id, performance_category, salary_growth_rate, days_of_service, promotion_count)\nSELECT s.employee_id,\n       CASE\n         WHEN s.growth_rate > 0.4 AND p.promotion_count > 1 THEN 'high_achiever'\n         WHEN s.growth_rate < 0.15 AND d.days_of_service > 3650 THEN 'needs_attention'\n         ELSE 'steady_performer'\n       END AS performance_category,\n       s.growth_rate,\n       d.days_of_service,\n       p.promotion_count\nFROM salary_growth s\nJOIN days_service d ON s.employee_id = d.employee_id\nJOIN promotions p ON s.employee_id = p.employee_id;"}
