| execute_sql {"sql": "TRUNCATE TABLE employees.gender_statistics;\n\nWITH current_employees AS (\n    SELECT e.id, e.gender\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n),\ngender_stats AS (\n    SELECT \n        e.gender,\n        COUNT(e.id) AS total_employees,\n        COUNT(ce.id) AS current_employees\n    FROM employees.employee e\n    LEFT JOIN current_employees ce ON e.id = ce.id\n    GROUP BY e.gender\n),\nworkforce_total AS (\n    SELECT COUNT(*) AS total FROM current_employees\n)\nINSERT INTO employees.gender_statistics (gender, total_employees, current_employees, percentage_of_workforce)\nSELECT \n    gs.gender,\n    gs.total_employees,\n    gs.current_employees,\n    ROUND(100.0 * gs.current_employees / wt.total, 2) AS percentage_of_workforce\nFROM gender_stats gs, workforce_total wt;"}
| execute_sql {"sql": "TRUNCATE TABLE employees.age_group_analysis;\n\nWITH current_employees AS (\n    SELECT e.id, e.birth_date, s.amount, e.hire_date\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n),\nage_calculations AS (\n    SELECT \n        id,\n        amount,\n        hire_date,\n        birth_date,\n        DATE_PART('year', AGE('2002-08-01'::date, birth_date)) AS age,\n        EXTRACT(EPOCH FROM ('2002-08-01'::date - hire_date))/86400 AS tenure_days\n    FROM current_employees\n),\nage_groups AS (\n    SELECT\n        CASE \n            WHEN age BETWEEN 20 AND 29 THEN '20-29'\n            WHEN age BETWEEN 30 AND 39 THEN '30-39'\n            WHEN age BETWEEN 40 AND 49 THEN '40-49'\n            WHEN age BETWEEN 50 AND 59 THEN '50-59'\n            WHEN age >= 60 THEN '60+'\n        END AS age_group,\n        amount,\n        tenure_days\n    FROM age_calculations\n    WHERE age >= 20\n)\nINSERT INTO employees.age_group_analysis (age_group, employee_count, avg_salary, avg_tenure_days)\nSELECT \n    age_group,\n    COUNT(*) AS employee_count,\n    ROUND(AVG(amount)::numeric, 2) AS avg_salary,\n    ROUND(AVG(tenure_days)::numeric, 2) AS avg_tenure_days\nFROM age_groups\nGROUP BY age_group\nHAVING COUNT(*) > 0\nORDER BY age_group;"}
| execute_sql {"sql": "TRUNCATE TABLE employees.age_group_analysis;\n\nWITH current_employees AS (\n    SELECT e.id, e.birth_date, s.amount, e.hire_date\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n),\nage_calculations AS (\n    SELECT \n        id,\n        amount,\n        hire_date,\n        birth_date,\n        DATE_PART('year', AGE('2002-08-01'::date, birth_date)) AS age,\n        EXTRACT(EPOCH FROM ('2002-08-01'::timestamp - hire_date::timestamp))/86400 AS tenure_days\n    FROM current_employees\n),\nage_groups AS (\n    SELECT\n        CASE \n            WHEN age BETWEEN 20 AND 29 THEN '20-29'\n            WHEN age BETWEEN 30 AND 39 THEN '30-39'\n            WHEN age BETWEEN 40 AND 49 THEN '40-49'\n            WHEN age BETWEEN 50 AND 59 THEN '50-59'\n            WHEN age >= 60 THEN '60+'\n        END AS age_group,\n        amount,\n        tenure_days\n    FROM age_calculations\n    WHERE age >= 20\n)\nINSERT INTO employees.age_group_analysis (age_group, employee_count, avg_salary, avg_tenure_days)\nSELECT \n    age_group,\n    COUNT(*) AS employee_count,\n    ROUND(AVG(amount)::numeric, 2) AS avg_salary,\n    ROUND(AVG(tenure_days)::numeric, 2) AS avg_tenure_days\nFROM age_groups\nGROUP BY age_group\nHAVING COUNT(*) > 0\nORDER BY age_group;"}
| execute_sql {"sql": "TRUNCATE TABLE employees.birth_month_distribution;\n\nWITH current_employees AS (\n    SELECT e.id, e.birth_date\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n),\nbirth_stats AS (\n    SELECT\n        EXTRACT(MONTH FROM birth_date)::integer AS birth_month,\n        TO_CHAR(birth_date, 'Month') AS month_name,\n        COUNT(id) AS employee_count\n    FROM employees.employee\n    GROUP BY birth_month, month_name\n),\ncurrent_birth_stats AS (\n    SELECT\n        EXTRACT(MONTH FROM birth_date)::integer AS birth_month,\n        COUNT(id) AS current_employee_count\n    FROM current_employees\n    GROUP BY birth_month\n)\nINSERT INTO employees.birth_month_distribution (birth_month, month_name, employee_count, current_employee_count)\nSELECT\n    bs.birth_month,\n    TRIM(bs.month_name) AS month_name,\n    bs.employee_count,\n    COALESCE(cbs.current_employee_count, 0) AS current_employee_count\nFROM birth_stats bs\nLEFT JOIN current_birth_stats cbs ON bs.birth_month = cbs.birth_month\nORDER BY bs.birth_month;"}
| execute_sql {"sql": "TRUNCATE TABLE employees.hiring_year_summary;\n\nWITH hire_stats AS (\n    SELECT hire_date, id\n    FROM employees.employee\n),\nhire_year_stats AS (\n    SELECT \n        EXTRACT(YEAR FROM hire_date)::integer AS hire_year,\n        COUNT(id) AS employees_hired\n    FROM hire_stats\n    GROUP BY hire_year\n),\nstill_employed_stats AS (\n    SELECT \n        EXTRACT(YEAR FROM e.hire_date)::integer AS hire_year,\n        COUNT(DISTINCT e.id) AS still_employed\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n    GROUP BY hire_year\n)\nINSERT INTO employees.hiring_year_summary (hire_year, employees_hired, still_employed, retention_rate)\nSELECT \n    hys.hire_year,\n    hys.employees_hired,\n    COALESCE(ses.still_employed, 0) AS still_employed,\n    ROUND(100.0 * COALESCE(ses.still_employed, 0) / hys.employees_hired, 2) AS retention_rate\nFROM hire_year_stats hys\nLEFT JOIN still_employed_stats ses ON hys.hire_year = ses.hire_year\nORDER BY hire_year;"}
I have created the required tables in the employees schema and populated them with the requested workforce composition and basic statistical summaries:

1. The `gender_statistics` table contains total and current employee counts by gender and their percentage of the current workforce.

2. The `age_group_analysis` table shows the number of current employees in each age group, with their average salary and average tenure days as of 2002-08-01.

3. The `birth_month_distribution` table provides counts of total and current employees by birth month, including month names.

4. The `hiring_year_summary` table details the number of employees hired each year, how many are still employed, and retention rates.

All calculations are based on current employees identified by having active salary records (to_date = '9999-01-01'). Age groups include only those with employees in them, and simple counts, averages, and percentages are reported for easy comprehension.

