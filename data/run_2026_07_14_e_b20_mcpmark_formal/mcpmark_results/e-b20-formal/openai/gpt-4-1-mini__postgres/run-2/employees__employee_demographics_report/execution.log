| execute_sql {"sql": "WITH current_employees AS (\n    SELECT e.employee_id, e.gender, e.birth_date, e.hire_date, s.salary, s.to_date\n    FROM employees.employee e\n    JOIN employees.salary s ON e.employee_id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n),\n-- Gender statistics\ngender_stats AS (\n    SELECT \n        gender,\n        COUNT(*) AS total_employees,\n        COUNT(*) FILTER (WHERE to_date = '9999-01-01') AS current_employees\n    FROM employees.employee e\n    LEFT JOIN employees.salary s ON e.employee_id = s.employee_id\n    GROUP BY gender\n),\nworkforce_total AS (\n    SELECT COUNT(*) AS total FROM current_employees\n)\n\nINSERT INTO employees.gender_statistics (gender, total_employees, current_employees, percentage_of_workforce)\nSELECT \n    gs.gender,\n    gs.total_employees,\n    gs.current_employees,\n    ROUND(100.0 * gs.current_employees / wt.total, 2) AS percentage_of_workforce\nFROM gender_stats gs, workforce_total wt;"}
