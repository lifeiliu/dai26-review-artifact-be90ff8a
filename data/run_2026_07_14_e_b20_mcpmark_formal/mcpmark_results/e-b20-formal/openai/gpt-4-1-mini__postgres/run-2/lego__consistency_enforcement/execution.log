| execute_sql {"sql": "-- Task 1: Identify Data Inconsistencies\nSELECT\n  ls.set_num,\n  ls.num_parts AS stored_num_parts,\n  COALESCE(actual_parts, 0) AS actual_parts\nFROM\n  public.lego_sets ls\nLEFT JOIN (\n  SELECT\n    li.set_num,\n    SUM(lip.quantity) AS actual_parts\n  FROM\n    public.lego_inventories li\n  LEFT JOIN public.lego_inventory_parts lip ON li.id = lip.inventory_id AND lip.is_spare = false\n  INNER JOIN (\n    SELECT set_num, MAX(version) AS max_version\n    FROM public.lego_inventories\n    GROUP BY set_num\n  ) latest ON li.set_num = latest.set_num AND li.version = latest.max_version\n  GROUP BY li.set_num\n) part_counts ON ls.set_num = part_counts.set_num\nWHERE\n  ls.num_parts <> COALESCE(part_counts.actual_parts, 0);"}
| execute_sql {"sql": "-- Task 2: Fix Existing Inconsistencies\n-- Step 1: Create Temporary Table\nCREATE TEMP TABLE correct_counts (\n    set_num TEXT PRIMARY KEY,\n    actual_parts INTEGER\n);\n\n-- Step 2: Populate Temporary Table\nINSERT INTO correct_counts (set_num, actual_parts)\nSELECT\n    ls.set_num,\n    COALESCE(pc.actual_parts, 0) AS actual_parts\nFROM\n    public.lego_sets ls\nLEFT JOIN (\n    SELECT\n        li.set_num,\n        SUM(lip.quantity) AS actual_parts\n    FROM\n        public.lego_inventories li\n    LEFT JOIN public.lego_inventory_parts lip ON li.id = lip.inventory_id AND lip.is_spare = false\n    INNER JOIN (\n        SELECT set_num, MAX(version) AS max_version\n        FROM public.lego_inventories\n        GROUP BY set_num\n    ) latest ON li.set_num = latest.set_num AND li.version = latest.max_version\n    GROUP BY li.set_num\n) pc ON ls.set_num = pc.set_num;\n\n-- Step 3: Update lego_sets from Temporary Table\nUPDATE public.lego_sets ls\nSET num_parts = cc.actual_parts\nFROM correct_counts cc\nWHERE ls.set_num = cc.set_num;"}
| execute_sql {"sql": "-- Task 3 Part A: Create the Trigger Function\nCREATE OR REPLACE FUNCTION public.check_set_parts_consistency()\nRETURNS trigger\nLANGUAGE plpgsql\nAS $$\nDECLARE\n    relevant_set_num TEXT;\n    actual_parts INTEGER;\n    stored_num_parts INTEGER;\nBEGIN\n    -- Determine set_num to check based on the table firing the trigger\n    IF TG_TABLE_NAME = 'lego_sets' OR TG_TABLE_NAME = 'lego_inventories' THEN\n        relevant_set_num := NEW.set_num;\n    ELSIF TG_TABLE_NAME = 'lego_inventory_parts' THEN\n        -- Lookup set_num from lego_inventories\n        SELECT set_num INTO relevant_set_num FROM public.lego_inventories WHERE id = NEW.inventory_id;\n        IF relevant_set_num IS NULL THEN\n            RAISE EXCEPTION 'No associated inventory found for inventory_id %', NEW.inventory_id;\n        END IF;\n    ELSE\n        -- For safety, don't check if unknown table\n        RETURN NEW;\n    END IF;\n\n    -- Calculate actual_parts for the relevant set_num based on latest inventory version\n    SELECT\n        COALESCE(SUM(lip.quantity), 0)\n    INTO actual_parts\n    FROM\n        public.lego_inventories li\n    LEFT JOIN public.lego_inventory_parts lip ON li.id = lip.inventory_id AND lip.is_spare = false\n    INNER JOIN (\n        SELECT set_num, MAX(version) AS max_version\n        FROM public.lego_inventories\n        WHERE set_num = relevant_set_num\n        GROUP BY set_num\n    ) latest ON li.set_num = latest.set_num AND li.version = latest.max_version\n    WHERE li.set_num = relevant_set_num;\n\n    -- Get stored num_parts from lego_sets\n    SELECT num_parts INTO stored_num_parts FROM public.lego_sets WHERE set_num = relevant_set_num;\n\n    -- Check for consistency\n    IF stored_num_parts IS NULL THEN\n        RAISE EXCEPTION 'Set % does not exist in lego_sets table', relevant_set_num;\n    END IF;\n\n    IF actual_parts <> stored_num_parts THEN\n        RAISE EXCEPTION 'Inconsistent part count for set %, stored: %, actual: %', relevant_set_num, stored_num_parts, actual_parts;\n    END IF;\n\n    RETURN NEW;\nEND;\n$$;"}
