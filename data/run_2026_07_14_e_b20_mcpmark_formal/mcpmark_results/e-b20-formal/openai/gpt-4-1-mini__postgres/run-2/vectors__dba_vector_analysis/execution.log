| execute_sql {"sql": "-- Find all vector columns and gather details about dimensions, data type, constraints, row counts\nWITH vector_columns AS (\n    SELECT \n        n.nspname AS schema,\n        c.relname AS table_name,\n        a.attname AS column_name,\n        t.typname AS data_type,\n        NULLIF(split_part(format_type(a.atttypid, a.atttypmod), 'vector(', 2), '') AS dimension_str\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    JOIN pg_type t ON a.atttypid = t.oid\n    WHERE t.typname = 'vector' AND a.attnum > 0 AND NOT a.attisdropped\n), vector_info AS (\n    SELECT schema, table_name, column_name, data_type,\n           (CASE WHEN dimension_str ~ '\\\\d+' THEN dimension_str::int ELSE NULL END) AS dimensions\n    FROM vector_columns\n), constraints AS (\n    SELECT nc.nspname AS schema,\n           c.relname AS table_name,\n           a.attname AS column_name,\n           bool_or((con.contype IN ('f','c','n')) AND a.attnum = ANY(con.conkey)) AS has_constraints\n    FROM pg_constraint con\n    JOIN pg_class c ON con.conrelid = c.oid\n    JOIN pg_namespace nc ON c.relnamespace = nc.oid\n    JOIN pg_attribute a ON a.attrelid = c.oid\n    WHERE a.attnum > 0 AND NOT a.attisdropped\n    GROUP BY nc.nspname, c.relname, a.attname\n), row_counts AS (\n    SELECT schemaname AS schema, relname AS table_name, n_live_tup AS rows\n    FROM pg_stat_all_tables\n)\nINSERT INTO vector_analysis_columns (schema, table_name, column_name, dimensions, data_type, has_constraints, rows)\nSELECT vi.schema, vi.table_name, vi.column_name, vi.dimensions, vi.data_type, \n       COALESCE(c.has_constraints, FALSE) AS has_constraints, \n       COALESCE(r.rows, 0) AS rows\nFROM vector_info vi\nLEFT JOIN constraints c ON c.schema = vi.schema AND c.table_name = vi.table_name AND c.column_name = vi.column_name\nLEFT JOIN row_counts r ON r.schema = vi.schema AND r.table_name = vi.table_name;"}
| execute_sql {"sql": "-- Select inserted vector columns info\nSELECT * FROM vector_analysis_columns;"}
| execute_sql {"sql": "-- Calculate storage usage for vector columns and regular columns\nWITH vector_tables AS (\n  SELECT schema, table_name FROM vector_analysis_columns GROUP BY schema, table_name\n),\nsize_info AS (\n  SELECT\n    nspname AS schema,\n    relname AS table_name,\n    pg_total_relation_size(c.oid) AS total_size_bytes,\n    pg_relation_size(c.oid) AS heap_size_bytes\n  FROM pg_class c\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  WHERE relname IN (SELECT table_name FROM vector_tables)\n    AND nspname IN (SELECT schema FROM vector_tables)\n),\nvector_column_sizes AS (\n  SELECT\n    vc.schema,\n    vc.table_name,\n    vc.column_name,\n    pg_column_size((SELECT $1::text FROM (SELECT * FROM ONLY pg_catalog.pg_attribute WHERE attrelid = (SELECT oid FROM pg_class WHERE relname = vc.table_name AND relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = vc.schema)) AND attname = vc.column_name LIMIT 1) AS col)) AS vector_data_bytes\n  FROM vector_analysis_columns vc\n),\nrow_counts AS (\n  SELECT schemaname AS schema,relname AS table_name,n_live_tup AS row_count FROM pg_stat_all_tables\n  WHERE relname IN (SELECT table_name FROM vector_tables)\n    AND schemaname IN (SELECT schema FROM vector_tables)\n)\nINSERT INTO vector_analysis_storage_consumption (schema, table_name, total_size_bytes, vector_data_bytes, regular_data_bytes, vector_storage_pct, row_count)\nSELECT \n  si.schema,\n  si.table_name,\n  si.total_size_bytes,\n  COALESCE(SUM(vcs.vector_data_bytes),0) AS vector_data_bytes,\n  si.total_size_bytes - COALESCE(SUM(vcs.vector_data_bytes),0) AS regular_data_bytes,\n  CASE WHEN si.total_size_bytes > 0 THEN ROUND(100.0 * COALESCE(SUM(vcs.vector_data_bytes),0)/si.total_size_bytes, 2) ELSE 0 END AS vector_storage_pct,\n  COALESCE(rc.row_count,0)\nFROM size_info si\nLEFT JOIN vector_column_sizes vcs ON si.schema = vcs.schema AND si.table_name = vcs.table_name\nLEFT JOIN row_counts rc ON si.schema = rc.schema AND si.table_name = rc.table_name\nGROUP BY si.schema, si.table_name, si.total_size_bytes, rc.row_count;"}
| execute_sql {"sql": "-- Catalog vector indexes and their characteristics\nINSERT INTO vector_analysis_indices (schema, table_name, column_name, index_name, index_type, index_size_bytes)\nSELECT\n  n.nspname AS schema,\n  t.relname AS table_name,\n  a.attname AS column_name,\n  i.relname AS index_name,\n  am.amname AS index_type,\n  pg_relation_size(i.oid) AS index_size_bytes\nFROM pg_index ix\nJOIN pg_class i ON i.oid = ix.indexrelid\nJOIN pg_class t ON t.oid = ix.indrelid\nJOIN pg_namespace n ON n.oid = t.relnamespace\nJOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)\nJOIN pg_am am ON am.oid = i.relam\nWHERE am.amname IN ('hnsw', 'ivfflat')\nAND n.nspname NOT IN ('pg_catalog', 'information_schema');"}
| execute_sql {"sql": "-- Analyze vector column storage sizes by scanning actual data sizes per column\nWITH vector_column_data AS (\n  SELECT\n    va.schema,\n    va.table_name,\n    va.column_name,\n    SUM(pg_column_size((va.table_name)::regclass::text)) AS table_size,\n    SUM(pg_column_size((va.column_name)::text)) AS vector_column_size\n  FROM vector_analysis_columns va\n  GROUP BY va.schema, va.table_name, va.column_name\n)\nSELECT * FROM vector_column_data;"}
| execute_sql {"sql": "-- Fetch vector indexes info with index type and size\nSELECT\n  n.nspname AS schema,\n  t.relname AS table_name,\n  a.attname AS column_name,\n  i.relname AS index_name,\n  am.amname AS index_type,\n  pg_relation_size(i.oid) AS index_size_bytes\nFROM pg_index ix\nJOIN pg_class i ON i.oid = ix.indexrelid\nJOIN pg_class t ON t.oid = ix.indrelid\nJOIN pg_namespace n ON n.oid = t.relnamespace\nJOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)\nJOIN pg_am am ON am.oid = i.relam\nWHERE am.amname IN ('hnsw', 'ivfflat')\nAND n.nspname NOT IN ('pg_catalog', 'information_schema')"}
| execute_sql {"sql": "-- Check for NULL vectors and dimension mismatches\nSELECT\n  schema,\n  table_name,\n  column_name,\n  SUM(CASE WHEN embedding IS NULL THEN 1 ELSE 0 END) AS null_vectors,\n  SUM(CASE WHEN octet_length(embedding::bytea) <> (dimensions * 4) THEN 1 ELSE 0 END) AS dimension_mismatches\nFROM (\n  SELECT\n    va.schema,\n    va.table_name,\n    va.column_name,\n    va.dimensions,\n    (SELECT unnest(ARRAY_AGG(embedding)) FROM ONLY public.document_chunks) AS embedding\n  FROM vector_analysis_columns va\n) sub\nGROUP BY schema, table_name, column_name;"}
| execute_sql {"sql": "-- Check for dimension consistency per vector column\nSELECT schema, table_name, column_name, COUNT(DISTINCT dimension) AS distinct_dimensions\nFROM (\n  SELECT\n    va.schema,\n    va.table_name,\n    va.column_name,\n    CASE WHEN embedding IS NOT NULL THEN octet_length(embedding::bytea) / 4 ELSE NULL END AS dimension\n  FROM vector_analysis_columns va\n  JOIN LATERAL (SELECT embedding FROM public.document_chunks WHERE true) AS vec ON true\n) sub\nGROUP BY schema, table_name, column_name;"}
| execute_sql {"sql": "-- Identify outlier vectors by length or value statistics\nSELECT va.schema, va.table_name, va.column_name,\n       AVG(octet_length(embedding::bytea) / 4) AS avg_dimension,\n       MAX(octet_length(embedding::bytea) / 4) AS max_dimension,\n       MIN(octet_length(embedding::bytea) / 4) AS min_dimension\nFROM vector_analysis_columns va\nJOIN public.document_chunks d ON va.table_name = 'document_chunks' AND d.embedding IS NOT NULL\nGROUP BY va.schema, va.table_name, va.column_name;"}
| execute_sql {"sql": "-- Check foreign key relationships involving vector tables\nSELECT conname, conrelid::regclass AS table_name, a.attname AS column_name, confrelid::regclass AS foreign_table_name\nFROM pg_constraint\nJOIN pg_attribute a ON a.attrelid = conrelid AND a.attnum = ANY(conkey)\nWHERE contype = 'f' AND conrelid::regclass::text LIKE '%document_chunks%' OR conrelid::regclass::text LIKE '%documents%' OR conrelid::regclass::text LIKE '%user_queries%';"}
| execute_sql {"sql": "-- Clean up and validate vector dimensions using native pgvector functions\nWITH vector_dims AS (\n  SELECT \n    vc.schema,\n    vc.table_name,\n    vc.column_name,\n    COUNT(*) AS total_rows,\n    SUM(CASE WHEN embedding IS NULL THEN 1 ELSE 0 END) AS null_vectors,\n    bool_and(vector_dim(embedding) = vc.dimensions) AS consistent_dimensions\n  FROM vector_analysis_columns vc\n  JOIN LATERAL (\n    SELECT embedding FROM public.\"\" || vc.table_name || \"\" LIMIT 100\n  ) AS sub ON TRUE\n  GROUP BY vc.schema, vc.table_name, vc.column_name, vc.dimensions\n)\nSELECT * FROM vector_dims;"}
| execute_sql {"sql": "-- Use information_schema to detect vector columns and their dimensions, and constraints\nSELECT \n  table_schema AS schema,\n  table_name,\n  column_name,\n  data_type,\n  character_maximum_length AS dimensions,\n  EXISTS(\n    SELECT 1 FROM information_schema.constraint_column_usage ccu\n    WHERE ccu.table_schema = cols.table_schema\n      AND ccu.table_name = cols.table_name\n      AND ccu.column_name = cols.column_name\n  ) AS has_constraints\nFROM information_schema.columns cols\nWHERE data_type = 'vector';"}
