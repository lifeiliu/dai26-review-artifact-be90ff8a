ns_flat\n    UNION ALL\n    SELECT * FROM dangling_user_grants\n)\nSELECT 'DANGLING_USERS' AS audit_type, COUNT(DISTINCT username) AS total_issues, COUNT(DISTINCT username) AS users_affected, 0 AS tables_affected\nFROM dangling_users\nUNION ALL\nSELECT 'MISSING_PERMISSIONS', COUNT(*), COUNT(DISTINCT username), COUNT(DISTINCT table_name)\nFROM missing_permissions\nUNION ALL\nSELECT 'EXCESSIVE_PERMISSIONS', COUNT(*), COUNT(DISTINCT username), COUNT(DISTINCT table_name)\nFROM excessive_permissions;"}
