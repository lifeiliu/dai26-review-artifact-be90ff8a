| execute_sql {"sql": "UPDATE public.film SET rental_rate = rental_rate * 1.1 WHERE rating = 'PG-13';"}
| execute_sql {"sql": "DROP TABLE IF EXISTS public.available_films; CREATE TABLE public.available_films (\n  film_id INTEGER PRIMARY KEY,\n  title VARCHAR(255) NOT NULL,\n  rental_rate NUMERIC(4,2) NOT NULL,\n  length SMALLINT\n);"}
| execute_sql {"sql": "INSERT INTO public.available_films (film_id, title, rental_rate, length)\nSELECT f.film_id, f.title, f.rental_rate, f.length\nFROM public.film f\nJOIN public.inventory i ON f.film_id = i.film_id\nWHERE f.rental_rate BETWEEN 3.00 AND 5.00\n  AND f.length > 100\n  AND i.store_id = 1\nGROUP BY f.film_id;"}
| execute_sql {"sql": "DELETE FROM public.inventory i\nWHERE EXISTS (\n  SELECT 1 FROM public.film f\n  LEFT JOIN public.rental r ON r.inventory_id = i.inventory_id\n  WHERE i.film_id = f.film_id\n    AND f.replacement_cost > 25.00\n    AND f.rental_rate < 1.00\n    AND r.rental_id IS NULL\n);\n"}
| execute_sql {"sql": "DROP TABLE IF EXISTS public.film_inventory_summary;\n\nCREATE TABLE public.film_inventory_summary (\n  title VARCHAR(255) NOT NULL,\n  rental_rate NUMERIC(4,2) NOT NULL,\n  total_inventory INTEGER NOT NULL,\n  store1_count INTEGER NOT NULL,\n  store2_count INTEGER NOT NULL\n);\n\nINSERT INTO public.film_inventory_summary (title, rental_rate, total_inventory, store1_count, store2_count)\nSELECT f.title, f.rental_rate,\n  COUNT(i.inventory_id) AS total_inventory,\n  COUNT(CASE WHEN i.store_id = 1 THEN 1 END) AS store1_count,\n  COUNT(CASE WHEN i.store_id = 2 THEN 1 END) AS store2_count\nFROM public.film f\nJOIN public.inventory i ON f.film_id = i.film_id\nGROUP BY f.title, f.rental_rate\nHAVING COUNT(i.inventory_id) > 0\nORDER BY total_inventory DESC, f.title ASC;"}
