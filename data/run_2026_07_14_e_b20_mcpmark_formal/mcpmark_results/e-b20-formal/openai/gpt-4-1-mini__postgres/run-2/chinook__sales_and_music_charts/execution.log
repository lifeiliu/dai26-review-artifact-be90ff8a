| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n  to_char(i.invoice_date, 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT i.invoice_id) AS total_invoices,\n  SUM(i.total) AS total_revenue,\n  SUM(il.quantity) AS total_tracks_sold,\n  AVG(i.total) AS average_invoice_value,\n  COUNT(DISTINCT i.customer_id) AS unique_customers\nFROM invoice i\nJOIN invoice_line il ON i.invoice_id = il.invoice_id\nGROUP BY year_month\nORDER BY year_month;"}
