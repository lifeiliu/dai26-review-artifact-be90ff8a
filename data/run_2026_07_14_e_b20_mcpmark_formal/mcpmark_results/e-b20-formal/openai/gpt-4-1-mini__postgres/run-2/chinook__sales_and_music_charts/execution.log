| execute_sql {"sql": "DELETE FROM public.top_music_charts;"}
| execute_sql {"sql": "-- Top Tracks by quantity sold\nWITH track_sales AS (\n  SELECT\n    t.\"TrackId\" AS item_id,\n    t.\"Name\" AS item_name,\n    SUM(il.\"Quantity\") AS total_quantity,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Track\" t\n  JOIN public.\"InvoiceLine\" il ON t.\"TrackId\" = il.\"TrackId\"\n  GROUP BY t.\"TrackId\", t.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT\n  'top_tracks' AS chart_type,\n  ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) AS rank_position,\n  item_id,\n  item_name,\n  total_revenue\nFROM track_sales\nWHERE ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) <= 10;"}
| execute_sql {"sql": "WITH track_sales AS (\n  SELECT\n    t.\"TrackId\" AS item_id,\n    t.\"Name\" AS item_name,\n    SUM(il.\"Quantity\") AS total_quantity,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Track\" t\n  JOIN public.\"InvoiceLine\" il ON t.\"TrackId\" = il.\"TrackId\"\n  GROUP BY t.\"TrackId\", t.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n), ranked_tracks AS (\n  SELECT\n    'top_tracks' AS chart_type,\n    ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) AS rank_position,\n    item_id,\n    item_name,\n    total_revenue\n  FROM track_sales\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT chart_type, rank_position, item_id, item_name, total_revenue\nFROM ranked_tracks\nWHERE rank_position <= 10;"}
| execute_sql {"sql": "-- Top Albums by total revenue\nWITH album_revenue AS (\n  SELECT\n    a.\"AlbumId\" AS item_id,\n    a.\"Title\" AS item_name,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Album\" a\n  JOIN public.\"Track\" t ON a.\"AlbumId\" = t.\"AlbumId\"\n  JOIN public.\"InvoiceLine\" il ON t.\"TrackId\" = il.\"TrackId\"\n  GROUP BY a.\"AlbumId\", a.\"Title\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n), ranked_albums AS (\n  SELECT\n    'top_albums' AS chart_type,\n    ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name) AS rank_position,\n    item_id,\n    item_name,\n    total_revenue\n  FROM album_revenue\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT chart_type, rank_position, item_id, item_name, total_revenue\nFROM ranked_albums\nWHERE rank_position <= 10;"}
| execute_sql {"sql": "-- Top Artists by total revenue\nWITH artist_revenue AS (\n  SELECT\n    ar.\"ArtistId\" AS item_id,\n    ar.\"Name\" AS item_name,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Artist\" ar\n  JOIN public.\"Album\" al ON ar.\"ArtistId\" = al.\"ArtistId\"\n  JOIN public.\"Track\" t ON al.\"AlbumId\" = t.\"AlbumId\"\n  JOIN public.\"InvoiceLine\" il ON t.\"TrackId\" = il.\"TrackId\"\n  GROUP BY ar.\"ArtistId\", ar.\"Name\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n), ranked_artists AS (\n  SELECT\n    'top_artists' AS chart_type,\n    ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name) AS rank_position,\n    item_id,\n    item_name,\n    total_revenue\n  FROM artist_revenue\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT chart_type, rank_position, item_id, item_name, total_revenue\nFROM ranked_artists\nWHERE rank_position <= 10;"}
