| execute_sql {"sql": "CREATE TABLE public.customer_analysis_fixed AS\nWITH rental_payment AS (\n    SELECT DISTINCT r.rental_id, r.customer_id, r.inventory_id, r.rental_date, r.return_date, p.amount\n    FROM rental r\n    JOIN payment p ON r.rental_id = p.rental_id\n),\ncustomer_basic_stats AS (\n    SELECT \n        c.customer_id,\n        c.first_name || ' ' || c.last_name as customer_name,\n        ci.city as customer_city,\n        co.country as customer_country,\n        COUNT(DISTINCT rp.rental_id) as total_rentals,\n        COUNT(DISTINCT i.film_id) as unique_films,\n        SUM(rp.amount) as total_spent,\n        AVG(EXTRACT(EPOCH FROM (rp.return_date - rp.rental_date)) / 86400.0) as avg_rental_duration\n    FROM customer c\n    JOIN address a ON c.address_id = a.address_id\n    JOIN city ci ON a.city_id = ci.city_id\n    JOIN country co ON ci.country_id = co.country_id\n    JOIN rental_payment rp ON c.customer_id = rp.customer_id\n    JOIN inventory i ON rp.inventory_id = i.inventory_id\n    WHERE c.email IS NOT NULL\n    GROUP BY c.customer_id, c.first_name, c.last_name, ci.city, co.country\n    HAVING COUNT(DISTINCT rp.rental_id) >= 15\n),\ncustomer_categories AS (\n    SELECT \n        rp.customer_id,\n        cat.name as category_name,\n        COUNT(*) as category_count,\n        ROW_NUMBER() OVER (PARTITION BY rp.customer_id ORDER BY COUNT(*) DESC, cat.name ASC) as rn\n    FROM rental_payment rp\n    JOIN inventory i ON rp.inventory_id = i.inventory_id\n    JOIN film f ON i.film_id = f.film_id\n    JOIN film_category fc ON f.film_id = fc.film_id\n    JOIN category cat ON fc.category_id = cat.category_id\n    WHERE rp.customer_id IN (SELECT customer_id FROM customer_basic_stats)\n    GROUP BY rp.customer_id, cat.name\n),\ncustomer_actors AS (\n    SELECT \n        rp.customer_id,\n        a.first_name || ' ' || a.last_name as actor_name,\n        COUNT(*) as actor_count,\n        ROW_NUMBER() OVER (PARTITION BY rp.customer_id ORDER BY COUNT(*) DESC, (a.first_name || ' ' || a.last_name) ASC) as rn\n    FROM rental_payment rp\n    JOIN inventory i ON rp.inventory_id = i.inventory_id\n    JOIN film f ON i.film_id = f.film_id\n    JOIN film_actor fa ON f.film_id = fa.film_id\n    JOIN actor a ON fa.actor_id = a.actor_id\n    WHERE rp.customer_id IN (SELECT customer_id FROM customer_basic_stats)\n    GROUP BY rp.customer_id, a.first_name, a.last_name\n),\nregional_popular_films AS (\n    SELECT \n        co.country,\n        f.title,\n        COUNT(*) as rental_count,\n        ROW_NUMBER() OVER (PARTITION BY co.country ORDER BY COUNT(*) DESC, f.title ASC) as rn\n    FROM rental_payment rp\n    JOIN inventory i ON rp.inventory_id = i.inventory_id\n    JOIN film f ON i.film_id = f.film_id\n    JOIN customer c ON rp.customer_id = c.customer_id\n    JOIN address a ON c.address_id = a.address_id\n    JOIN city ci ON a.city_id = ci.city_id\n    JOIN country co ON ci.country_id = co.country_id\n    GROUP BY co.country, f.title\n)\nSELECT \n    cbs.customer_id,\n    cbs.customer_name,\n    cbs.customer_city,\n    cbs.customer_country,\n    cbs.total_rentals,\n    cbs.unique_films,\n    cbs.total_spent,\n    cc.category_name as favorite_category,\n    ca.actor_name as favorite_actor,\n    cbs.avg_rental_duration,\n    CASE \n        WHEN cbs.total_spent >= 150 THEN 'Premium'\n        WHEN cbs.total_spent >= 75 THEN 'Standard'\n        ELSE 'Basic'\n    END as customer_tier,\n    rpf.title as most_popular_film_in_region,\n    rpf.rental_count as regional_film_rental_count\nINTO public.customer_analysis_fixed\nFROM customer_basic_stats cbs\nLEFT JOIN customer_categories cc ON cbs.customer_id = cc.customer_id AND cc.rn = 1\nLEFT JOIN customer_actors ca ON cbs.customer_id = ca.customer_id AND ca.rn = 1\nLEFT JOIN regional_popular_films rpf ON cbs.customer_country = rpf.country AND rpf.rn = 1\nORDER BY cbs.total_spent DESC, cbs.total_rentals DESC, cbs.customer_name ASC;"}
