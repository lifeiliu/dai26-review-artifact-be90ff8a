| execute_sql {"sql": "-- Update player_evaluation performance_score by reducing for injured players\nUPDATE player_evaluation pe\nSET performance_score = GREATEST(\n  performance_score *\n  CASE \n    WHEN pis.current_status = 'injured' THEN 0.8\n    WHEN pis.injury_count > 2 THEN 0.9\n    ELSE 1\n  END, 0\n)\nFROM player_injury_status pis\nWHERE pe.person_id = pis.person_id;"}
