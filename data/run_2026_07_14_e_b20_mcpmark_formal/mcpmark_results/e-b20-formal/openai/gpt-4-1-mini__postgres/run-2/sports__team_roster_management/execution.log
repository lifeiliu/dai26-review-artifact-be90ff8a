| execute_sql {"sql": "INSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT \n  p.person_id,\n  CASE WHEN COALESCE(b.at_bats, 0) = 0 THEN 0 ELSE COALESCE(b.hits, 0)::DECIMAL / COALESCE(b.at_bats, 1) END AS batting_avg,\n  COALESCE(b.home_runs, 0) AS home_runs,\n  COALESCE(b.rbi, 0) AS rbis,\n  COALESCE(g.games_played, 0) AS games_played,\n  (CASE WHEN COALESCE(b.at_bats, 0) = 0 THEN 0 ELSE COALESCE(b.hits, 0)::DECIMAL / COALESCE(b.at_bats, 1) END * 1000) + (COALESCE(b.home_runs, 0) * 5) + (COALESCE(b.rbi, 0) * 2) AS performance_score,\n  DATE '2024-01-01' AS evaluation_date\nFROM\n  (SELECT DISTINCT person_id FROM baseball_offensive_stats) p\nLEFT JOIN baseball_offensive_stats b ON p.person_id = b.person_id\nLEFT JOIN (\n  SELECT person_id, COUNT(DISTINCT event_id) AS games_played\n  FROM person_event_metadata\n  GROUP BY person_id\n) g ON p.person_id = g.person_id\nWHERE COALESCE(g.games_played, 0) >= 10;"}
