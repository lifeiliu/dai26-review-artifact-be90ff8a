| execute_sql {"sql": "-- Create player_injury_status table\nCREATE TABLE player_injury_status (\n  status_id SERIAL PRIMARY KEY,\n  person_id INTEGER UNIQUE NOT NULL,\n  injury_count INTEGER DEFAULT 0,\n  last_injury_date DATE,\n  current_status VARCHAR CHECK (current_status IN ('healthy', 'injured', 'recovering'))\n);\n\n-- Insert data into player_injury_status for players in player_evaluation\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT \n  pe.person_id,\n  COALESCE(COUNT(ip.phase_id), 0) AS injury_count,\n  MAX(ip.start_date) AS last_injury_date,\n  CASE \n    WHEN MAX(ip.end_date) IS NULL THEN 'injured' \n    ELSE 'healthy' \n  END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON pe.person_id = ip.person_id\nGROUP BY pe.person_id;"}
| execute_sql {"sql": "-- Insert data into player_injury_status for players in player_evaluation\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT \n  pe.person_id,\n  COALESCE(COUNT(ip.phase_id), 0) AS injury_count,\n  MAX(ip.start_date) AS last_injury_date,\n  CASE \n    WHEN MAX(ip.end_date) IS NULL THEN 'injured' \n    ELSE 'healthy' \n  END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON pe.person_id = ip.person_id\nGROUP BY pe.person_id\nON CONFLICT (person_id) DO NOTHING;"}
