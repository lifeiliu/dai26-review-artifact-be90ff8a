| execute_sql {"sql": "-- 1. Create role theme_analyst\nDO $$\nBEGIN\n   IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'theme_analyst') THEN\n      CREATE ROLE theme_analyst NOINHERIT LOGIN PASSWORD 'secure_password_here';\n   END IF;\nEND\n$$;\n\n-- Grant SELECT on reference tables\nGRANT SELECT ON lego_themes TO theme_analyst;\nGRANT SELECT ON lego_colors TO theme_analyst;\nGRANT SELECT ON lego_parts TO theme_analyst;\nGRANT SELECT ON lego_part_categories TO theme_analyst;\n\n-- Grant SELECT on main data tables\nGRANT SELECT ON lego_sets TO theme_analyst;\nGRANT SELECT ON lego_inventories TO theme_analyst;\nGRANT SELECT ON lego_inventory_parts TO theme_analyst;"}
| execute_sql {"sql": "-- 2. Enable Row-Level Security (RLS) on main data tables\nALTER TABLE lego_sets ENABLE ROW LEVEL SECURITY;\nALTER TABLE lego_inventories ENABLE ROW LEVEL SECURITY;\nALTER TABLE lego_inventory_parts ENABLE ROW LEVEL SECURITY;"}
| execute_sql {"sql": "-- 4. Create theme assignment function get_user_theme_id()\nCREATE OR REPLACE FUNCTION get_user_theme_id()\nRETURNS INTEGER AS $$\nBEGIN\n   IF current_user = 'theme_analyst' THEN\n      RETURN 18; -- Star Wars theme\n   ELSE\n      RETURN NULL; -- No theme assigned\n   END IF;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\n-- 3. Create RLS policies\n\n-- Policy 1: theme_sets_policy on lego_sets\nCREATE POLICY theme_sets_policy ON lego_sets\nFOR SELECT\nUSING (theme_id = get_user_theme_id());\n\n-- Policy 2: theme_inventories_policy on lego_inventories\nCREATE POLICY theme_inventories_policy ON lego_inventories\nFOR SELECT\nUSING (EXISTS (\n  SELECT 1 FROM lego_sets s\n  WHERE s.set_num = lego_inventories.set_num\n    AND s.theme_id = get_user_theme_id()\n));\n\n-- Policy 3: theme_inventory_parts_policy on lego_inventory_parts\nCREATE POLICY theme_inventory_parts_policy ON lego_inventory_parts\nFOR SELECT\nUSING (EXISTS (\n  SELECT 1 FROM lego_inventories i\n  JOIN lego_sets s ON s.set_num = i.set_num\n  WHERE i.inventory_id = lego_inventory_parts.inventory_id\n    AND s.theme_id = get_user_theme_id()\n));"}
