| execute_sql {"sql": "WITH manager_periods AS (\n  SELECT \n    dm.employee_id AS manager_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    d.dept_name AS department_name,\n    dm.from_date,\n    dm.to_date\n  FROM employees.department_manager dm\n  JOIN employees.employee e ON dm.employee_id = e.id\n  JOIN employees.department d ON dm.department_id = d.id\n),\ncurrent_managers AS (\n  SELECT \n    manager_id,\n    manager_name,\n    department_name\n  FROM manager_periods\n  WHERE to_date = '9999-01-01'\n),\nmanagement_count AS (\n  SELECT \n    manager_id,\n    COUNT(*) AS management_periods\n  FROM manager_periods\n  GROUP BY manager_id\n)\nINSERT INTO employees.manager_profile (manager_id, manager_name, current_department, management_periods, current_manager)\nSELECT \n  mp.manager_id,\n  mp.manager_name,\n  cm.department_name AS current_department,\n  mc.management_periods,\n  CASE WHEN cm.manager_id IS NOT NULL THEN true ELSE false END AS current_manager\nFROM management_count mc\nJOIN (SELECT DISTINCT manager_id, manager_name FROM manager_periods) mp ON mc.manager_id = mp.manager_id\nLEFT JOIN current_managers cm ON mp.manager_id = cm.manager_id;"}
| execute_sql {"sql": "WITH current_leadership AS (\n  SELECT \n    d.dept_name AS department_name,\n    CONCAT(e.first_name, ' ', e.last_name) AS current_manager_name,\n    dm.from_date AS manager_start_date\n  FROM employees.department_manager dm\n  JOIN employees.employee e ON dm.employee_id = e.id\n  JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n),\nhistorical_managers AS (\n  SELECT \n    d.dept_name AS department_name,\n    dm.employee_id\n  FROM employees.department_manager dm\n  JOIN employees.department d ON dm.department_id = d.id\n  GROUP BY d.dept_name, dm.employee_id\n)\nINSERT INTO employees.department_leadership (department_name, current_manager_name, manager_start_date, total_historical_managers)\nSELECT \n  cl.department_name,\n  cl.current_manager_name,\n  cl.manager_start_date,\n  (SELECT COUNT(DISTINCT employee_id) FROM employees.department_manager dm\n   JOIN employees.department d ON dm.department_id = d.id\n   WHERE d.dept_name = cl.department_name) AS total_historical_managers\nFROM current_leadership cl;"}
| execute_sql {"sql": "WITH management_changes AS (\n  SELECT\n    d.dept_name AS department_name,\n    dm.employee_id AS manager_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    dm.from_date,\n    dm.to_date,\n    ROW_NUMBER() OVER (PARTITION BY d.dept_name ORDER BY dm.from_date) AS rn\n  FROM employees.department_manager dm\n  JOIN employees.employee e ON dm.employee_id = e.id\n  JOIN employees.department d ON dm.department_id = d.id\n),\ntransitions AS (\n  SELECT\n    curr.department_name,\n    EXTRACT(YEAR FROM curr.from_date) AS transition_year,\n    prev.manager_name AS outgoing_manager,\n    curr.manager_name AS incoming_manager,\n    GREATEST(0, curr.from_date - prev.to_date) AS transition_gap_days\n  FROM management_changes curr\n  LEFT JOIN management_changes prev ON curr.department_name = prev.department_name AND curr.rn = prev.rn + 1\n  WHERE curr.rn > 1\n)\nINSERT INTO employees.management_transitions (department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days)\nSELECT department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days FROM transitions;"}
| execute_sql {"sql": "WITH current_managers AS (\n  SELECT \n    dm.employee_id AS manager_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    d.dept_name AS department_name\n  FROM employees.department_manager dm\n  JOIN employees.employee e ON dm.employee_id = e.id\n  JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n),\nemployee_counts AS (\n  SELECT \n    d.id AS department_id,\n    COUNT(de.employee_id) AS total_employees,\n    COUNT(CASE WHEN de.to_date = '9999-01-01' THEN 1 END) AS current_employees\n  FROM employees.department_employee de\n  JOIN employees.department d ON de.department_id = d.id\n  GROUP BY d.id\n)\nINSERT INTO employees.span_of_control (manager_id, manager_name, department_name, total_employees, current_employees, management_load)\nSELECT \n  cm.manager_id,\n  cm.manager_name,\n  cm.department_name,\n  ec.total_employees,\n  ec.current_employees,\n  CASE \n    WHEN ec.current_employees < 5000 THEN 'light'\n    WHEN ec.current_employees BETWEEN 5000 AND 15000 THEN 'moderate'\n    ELSE 'heavy'\n  END AS management_load\nFROM current_managers cm\nJOIN employees.department d ON cm.department_name = d.dept_name\nJOIN employee_counts ec ON d.id = ec.department_id;"}
