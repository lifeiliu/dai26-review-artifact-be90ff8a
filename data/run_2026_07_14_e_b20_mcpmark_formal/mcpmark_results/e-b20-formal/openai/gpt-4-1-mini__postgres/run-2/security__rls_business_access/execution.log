| execute_sql {"sql": "-- Policies for posts table\n-- SELECT: Users can read all posts in channels they have access to\nCREATE POLICY posts_select_access ON public.posts\nFOR SELECT USING (\n  EXISTS (\n    SELECT 1 FROM public.channels c\n    WHERE c.id = public.posts.channel_id\n    AND (c.is_public OR is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()))\n  )\n);\n\n-- INSERT: Authenticated users can create posts in any channel\nCREATE POLICY posts_insert_auth ON public.posts\nFOR INSERT WITH CHECK (app_current_user_id() IS NOT NULL);\n\n-- UPDATE: Post authors OR channel moderators OR channel owners can edit posts\nCREATE POLICY posts_update_auth ON public.posts\nFOR UPDATE USING (\n  author_id = app_current_user_id()\n  OR is_channel_moderator(channel_id, app_current_user_id())\n  OR is_channel_owner(channel_id, app_current_user_id())\n);\n\n-- DELETE: Post authors OR channel moderators OR channel owners can delete posts\nCREATE POLICY posts_delete_auth ON public.posts\nFOR DELETE USING (\n  author_id = app_current_user_id()\n  OR is_channel_moderator(channel_id, app_current_user_id())\n  OR is_channel_owner(channel_id, app_current_user_id())\n);"}
| execute_sql {"sql": "-- Policies for comments table\n-- SELECT: Users can read comments on posts they can access\nCREATE POLICY comments_select_access ON public.comments\nFOR SELECT USING (\n  EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = public.comments.post_id\n    AND (c.is_public OR is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()))\n  )\n);\n\n-- INSERT: Authenticated users can comment on posts they can see\nCREATE POLICY comments_insert_auth ON public.comments\nFOR INSERT WITH CHECK (\n  app_current_user_id() IS NOT NULL\n  AND EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = public.comments.post_id\n    AND (c.is_public OR is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()))\n  )\n);\n\n-- UPDATE: Comment authors OR post authors OR channel moderators OR channel owners can edit comments\nCREATE POLICY comments_update_auth ON public.comments\nFOR UPDATE USING (\n  author_id = app_current_user_id()\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = public.comments.post_id\n    AND p.author_id = app_current_user_id()\n  )\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = public.comments.post_id\n    AND (is_channel_moderator(c.id, app_current_user_id()) OR is_channel_owner(c.id, app_current_user_id()))\n  )\n);\n\n-- DELETE: Comment authors OR post authors OR channel moderators OR channel owners can delete comments\nCREATE POLICY comments_delete_auth ON public.comments\nFOR DELETE USING (\n  author_id = app_current_user_id()\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = public.comments.post_id\n    AND p.author_id = app_current_user_id()\n  )\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = public.comments.post_id\n    AND (is_channel_moderator(c.id, app_current_user_id()) OR is_channel_owner(c.id, app_current_user_id()))\n  )\n);"}
