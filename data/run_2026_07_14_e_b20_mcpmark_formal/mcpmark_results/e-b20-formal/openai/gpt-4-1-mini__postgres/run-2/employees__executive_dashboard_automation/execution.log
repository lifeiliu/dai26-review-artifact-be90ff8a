| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(e.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       m.manager_name\nFROM employees.departments d\nJOIN employees.employees e ON e.department_id = d.department_id AND e.current_employee = true\nJOIN employees.salaries s ON s.employee_id = e.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.managers m ON m.department_id = d.department_id\nGROUP BY d.department_name, m.manager_name;"}
| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n    SELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n           e.employee_id,\n           e.department_id,\n           s.amount AS starting_salary,\n           e.current_employee\n    FROM employees.employees e\n    JOIN employees.salaries s ON e.employee_id = s.employee_id AND s.from_date = e.hire_date\n),\nhiring_counts AS (\n    SELECT hire_year,\n           COUNT(employee_id) AS employees_hired,\n           AVG(starting_salary) AS avg_starting_salary\n    FROM hires\n    GROUP BY hire_year\n),\nretention AS (\n    SELECT hire_year,\n           COUNT(CASE WHEN current_employee THEN 1 END)::decimal / NULLIF(COUNT(*),0) AS retention_rate\n    FROM hires\n    GROUP BY hire_year\n),\ntop_department AS (\n    SELECT hire_year, department_id\n    FROM (\n        SELECT hire_year, department_id, RANK() OVER (PARTITION BY hire_year ORDER BY COUNT(*) DESC) AS rnk\n        FROM hires\n        GROUP BY hire_year, department_id\n    ) ranked\n    WHERE rnk = 1\n)\nSELECT hc.hire_year,\n       hc.employees_hired,\n       hc.avg_starting_salary,\n       r.retention_rate,\n       d.department_name AS top_hiring_department\nFROM hiring_counts hc\nJOIN retention r ON hc.hire_year = r.hire_year\nJOIN top_department t ON hc.hire_year = t.hire_year\nJOIN employees.departments d ON t.department_id = d.department_id;"}
| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n    SELECT e.employee_id,\n           s.amount,\n           CASE\n               WHEN s.amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n               WHEN s.amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n               WHEN s.amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n               WHEN s.amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n               ELSE '110K+'\n           END AS salary_band,\n           e.job_title\n    FROM employees.employees e\n    JOIN employees.salaries s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\n    WHERE e.current_employee = true\n), \nbanded_counts AS (\n    SELECT salary_band, COUNT(*) AS employee_count\n    FROM salary_bands\n    GROUP BY salary_band\n),\ntotal_count AS (\n    SELECT COUNT(*) AS total_employee_count\n    FROM employees.employees\n    WHERE current_employee = true\n),\nmost_common_titles AS (\n    SELECT salary_band, job_title\n    FROM (\n        SELECT salary_band, job_title, ROW_NUMBER() OVER (PARTITION BY salary_band ORDER BY COUNT(*) DESC) AS rn\n        FROM salary_bands\n        GROUP BY salary_band, job_title\n    ) ranked\n    WHERE rn = 1\n)\nSELECT b.salary_band,\n       b.employee_count,\n       (b.employee_count::decimal / t.total_employee_count) * 100 AS percentage_of_workforce,\n       m.job_title AS most_common_title\nFROM banded_counts b\nCROSS JOIN total_count t\nJOIN most_common_titles m ON b.salary_band = m.salary_band;"}
| execute_sql {"sql": "CREATE TABLE IF NOT EXISTS employees.monthly_reports (\n  report_id SERIAL PRIMARY KEY,\n  report_date DATE NOT NULL,\n  department_count INTEGER NOT NULL,\n  total_employees INTEGER NOT NULL,\n  avg_salary DECIMAL NOT NULL,\n  generated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nCREATE OR REPLACE PROCEDURE employees.generate_monthly_report(report_date DATE)\nLANGUAGE plpgsql\nAS $$\nDECLARE\n  dep_count INTEGER;\n  emp_count INTEGER;\n  avg_sal DECIMAL;\n  new_report_id INTEGER;\nBEGIN\n  SELECT COUNT(*) INTO dep_count FROM employees.departments;\n  SELECT COUNT(*) INTO emp_count FROM employees.employees WHERE current_employee = TRUE;\n  SELECT AVG(amount) INTO avg_sal FROM employees.salaries WHERE to_date = '9999-01-01';\n\n  INSERT INTO employees.monthly_reports(report_date, department_count, total_employees, avg_salary)\n  VALUES (report_date, dep_count, emp_count, avg_sal)\n  RETURNING report_id INTO new_report_id;\n\n  RETURN new_report_id;\nEND;\n$$;"}
| execute_sql {"sql": "CREATE TABLE IF NOT EXISTS employees.salary_alerts (\n  alert_id SERIAL PRIMARY KEY,\n  employee_id INTEGER NOT NULL,\n  salary_amount DECIMAL NOT NULL,\n  alert_date TIMESTAMPTZ DEFAULT NOW(),\n  status VARCHAR(20) DEFAULT 'new'\n);\n\nCREATE OR REPLACE FUNCTION employees.high_salary_alert_fn()\nRETURNS TRIGGER\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  IF NEW.amount > 120000 THEN\n    INSERT INTO employees.salary_alerts(employee_id, salary_amount)\n    VALUES (NEW.employee_id, NEW.amount);\n  END IF;\n  RETURN NEW;\nEND;\n$$;\n\nDROP TRIGGER IF EXISTS high_salary_alert ON employees.salaries;\nCREATE TRIGGER high_salary_alert\nAFTER INSERT ON employees.salaries\nFOR EACH ROW\nEXECUTE FUNCTION employees.high_salary_alert_fn();"}
