| execute_sql {"sql": "DROP MATERIALIZED VIEW IF EXISTS employees.exec_department_summary;\nCREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.dept_name AS department_name,\n       COUNT(de.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       (SELECT e.first_name || ' ' || e.last_name\n        FROM employees.employee e\n        JOIN employees.department_manager dm ON e.id = dm.employee_id\n        WHERE dm.department_id = d.id\n          AND dm.from_date <= CURRENT_DATE\n          AND dm.to_date > CURRENT_DATE\n        LIMIT 1) AS manager_name\nFROM employees.department d\nJOIN employees.department_employee de ON d.id = de.department_id\nJOIN employees.salary s ON de.employee_id = s.employee_id\nWHERE de.to_date > CURRENT_DATE\n  AND s.to_date = '9999-01-01'\nGROUP BY d.dept_name, d.id;"}
| execute_sql {"sql": "DROP MATERIALIZED VIEW IF EXISTS employees.exec_hiring_trends;\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n    SELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n           e.id AS employee_id,\n           de.department_id,\n           s.amount AS starting_salary,\n           CASE WHEN de.to_date > CURRENT_DATE THEN true ELSE false END AS still_employed\n    FROM employees.employee e\n    JOIN employees.department_employee de ON e.id = de.employee_id AND de.from_date = e.hire_date\n    JOIN employees.salary s ON e.id = s.employee_id AND s.from_date = e.hire_date\n)\n, hiring_counts AS (\n    SELECT hire_year,\n           COUNT(employee_id) AS employees_hired,\n           AVG(starting_salary) AS avg_starting_salary\n    FROM hires\n    GROUP BY hire_year\n)\n, retention AS (\n    SELECT hire_year,\n           AVG(CASE WHEN still_employed THEN 1.0 ELSE 0.0 END) AS retention_rate\n    FROM hires\n    GROUP BY hire_year\n)\n, top_department AS (\n    SELECT hire_year, department_id\n    FROM (\n        SELECT hire_year, department_id, RANK() OVER (PARTITION BY hire_year ORDER BY COUNT(*) DESC) AS rnk\n        FROM hires\n        GROUP BY hire_year, department_id\n    ) sub\n    WHERE rnk = 1\n)\nSELECT hc.hire_year,\n       hc.employees_hired,\n       hc.avg_starting_salary,\n       r.retention_rate,\n       d.dept_name AS top_hiring_department\nFROM hiring_counts hc\nJOIN retention r ON hc.hire_year = r.hire_year\nJOIN top_department td ON hc.hire_year = td.hire_year\nJOIN employees.department d ON td.department_id = d.id;"}
| execute_sql {"sql": "DROP MATERIALIZED VIEW IF EXISTS employees.exec_salary_distribution;\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n    SELECT e.id AS employee_id,\n           s.amount,\n           CASE\n               WHEN s.amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n               WHEN s.amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n               WHEN s.amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n               WHEN s.amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n               ELSE '110K+'\n           END AS salary_band,\n           t.title\n    FROM employees.employee e\n    JOIN employees.salary s ON e.id = s.employee_id AND s.to_date = '9999-01-01'\n    LEFT JOIN employees.title t ON e.id = t.employee_id AND t.to_date = '9999-01-01'\n    WHERE e.id IN (SELECT employee_id FROM employees.department_employee WHERE to_date > CURRENT_DATE)\n), \nbanded_counts AS (\n    SELECT salary_band, COUNT(*) AS employee_count\n    FROM salary_bands\n    GROUP BY salary_band\n),\ntotal_count AS (\n    SELECT COUNT(*) AS total_employee_count\n    FROM employees.employee\n    WHERE id IN (SELECT employee_id FROM employees.department_employee WHERE to_date > CURRENT_DATE)\n),\nmost_common_titles AS (\n    SELECT salary_band, title\n    FROM (\n        SELECT salary_band, title, ROW_NUMBER() OVER (PARTITION BY salary_band ORDER BY COUNT(*) DESC) AS rn\n        FROM salary_bands\n        GROUP BY salary_band, title\n    ) ranked\n    WHERE rn = 1\n)\nSELECT b.salary_band,\n       b.employee_count,\n       (b.employee_count::decimal / t.total_employee_count) * 100 AS percentage_of_workforce,\n       m.title AS most_common_title\nFROM banded_counts b\nCROSS JOIN total_count t\nLEFT JOIN most_common_titles m ON b.salary_band = m.salary_band;"}
