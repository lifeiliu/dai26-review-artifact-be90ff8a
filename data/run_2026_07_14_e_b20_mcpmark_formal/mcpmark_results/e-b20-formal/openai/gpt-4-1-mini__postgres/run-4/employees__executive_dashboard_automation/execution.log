| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.dept_name AS department_name,\n       COUNT(de.employee_id) FILTER (WHERE current_date BETWEEN de.from_date AND de.to_date) AS total_employees,\n       AVG(CASE WHEN s.to_date = '9999-01-01' THEN s.amount END) AS avg_salary,\n       SUM(CASE WHEN s.to_date = '9999-01-01' THEN s.amount ELSE 0 END)::bigint AS total_payroll,\n       CONCAT(e.first_name, ' ', e.last_name) AS manager_name\nFROM employees.department d\nLEFT JOIN employees.department_employee de ON de.department_id = d.id AND current_date BETWEEN de.from_date AND de.to_date\nLEFT JOIN employees.salary s ON s.employee_id = de.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.department_manager dm ON dm.department_id = d.id AND current_date BETWEEN dm.from_date AND dm.to_date\nLEFT JOIN employees.employee e ON e.id = dm.employee_id\nGROUP BY d.dept_name, e.first_name, e.last_name;"}
