| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.dept_name AS department_name,\n       COUNT(de.employee_id) FILTER (WHERE now() BETWEEN de.from_date AND de.to_date) AS total_employees,\n       AVG(s.amount) FILTER (WHERE s.to_date = '9999-01-01') AS avg_salary,\n       SUM(s.amount)::bigint FILTER (WHERE s.to_date = '9999-01-01') AS total_payroll,\n       CONCAT(e.first_name, ' ', e.last_name) AS manager_name\nFROM employees.department d\nLEFT JOIN employees.department_employee de ON de.department_id = d.id AND now() BETWEEN de.from_date AND de.to_date\nLEFT JOIN employees.salary s ON s.employee_id = de.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.department_manager dm ON dm.department_id = d.id AND now() BETWEEN dm.from_date AND dm.to_date\nLEFT JOIN employees.employee e ON e.id = dm.employee_id\nGROUP BY d.dept_name, e.first_name, e.last_name;\n\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hire_data AS (\n    SELECT EXTRACT(YEAR FROM e.hire_date)::integer AS hire_year, e.id AS employee_id, de.department_id\n    FROM employees.employee e\n    LEFT JOIN employees.department_employee de ON de.employee_id = e.id AND de.from_date = (\n        SELECT MIN(from_date) FROM employees.department_employee WHERE employee_id = e.id\n    )\n), hire_stats AS (\n    SELECT hire_year,\n           COUNT(employee_id) AS employees_hired,\n           AVG(s.amount) AS avg_starting_salary\n    FROM hire_data hd\n    JOIN employees.salary s ON s.employee_id = hd.employee_id\n        AND s.from_date = (SELECT MIN(from_date) FROM employees.salary WHERE employee_id = hd.employee_id)\n    GROUP BY hire_year\n), retention AS (\n    SELECT hire_year,\n           COUNT(CASE WHEN e.hire_date <= current_date AND e.id IS NOT NULL THEN 1 END)::float / NULLIF(COUNT(*),0) AS retention_rate\n    FROM hire_data hd\n    LEFT JOIN employees.employee e ON e.id = hd.employee_id\n    GROUP BY hire_year\n), top_dept AS (\n    SELECT hire_year, department_id\n    FROM (\n        SELECT hire_year, department_id, RANK() OVER (PARTITION BY hire_year ORDER BY COUNT(employee_id) DESC) AS rank\n        FROM hire_data\n        GROUP BY hire_year, department_id\n    ) ranked\n    WHERE rank = 1\n)\nSELECT hs.hire_year, hs.employees_hired, hs.avg_starting_salary, r.retention_rate, d.dept_name AS top_hiring_department\nFROM hire_stats hs\nJOIN retention r ON hs.hire_year = r.hire_year\nJOIN top_dept td ON hs.hire_year = td.hire_year\nJOIN employees.department d ON d.id = td.department_id;\n\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT s.employee_id, s.amount, \n    CASE \n      WHEN s.amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n      WHEN s.amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n      WHEN s.amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n      WHEN s.amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n      WHEN s.amount >= 110000 THEN '110K+'\n      ELSE 'Unknown'\n    END AS salary_band\n  FROM employees.salary s\n  WHERE s.to_date = '9999-01-01'\n), counts AS (\n  SELECT salary_band, COUNT(*) AS employee_count\n  FROM salary_bands\n  GROUP BY salary_band\n), common_titles AS (\n  SELECT sb.salary_band, t.title, COUNT(*) AS cnt,\n         RANK() OVER (PARTITION BY sb.salary_band ORDER BY COUNT(*) DESC) AS rnk\n  FROM salary_bands sb\n  JOIN employees.title t ON t.employee_id = sb.employee_id\n  WHERE t.to_date IS NULL OR t.to_date > current_date\n  GROUP BY sb.salary_band, t.title\n)\nSELECT c.salary_band, c.employee_count,\n       ROUND((c.employee_count * 100.0 / (SELECT COUNT(*) FROM employees.employee)), 2) AS percentage_of_workforce,\n       (SELECT title FROM common_titles WHERE rnk = 1 AND salary_band = c.salary_band) AS most_common_title\nFROM counts c\nWHERE c.salary_band != 'Unknown';"}
