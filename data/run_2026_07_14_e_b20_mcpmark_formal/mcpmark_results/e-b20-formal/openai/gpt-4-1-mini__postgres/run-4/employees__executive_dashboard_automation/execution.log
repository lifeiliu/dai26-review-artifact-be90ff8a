| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(e.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       m.manager_name\nFROM employees.departments d\nLEFT JOIN employees.employees e ON e.department_id = d.department_id AND e.is_active = true\nLEFT JOIN employees.salaries s ON s.employee_id = e.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.managers m ON m.department_id = d.department_id\nGROUP BY d.department_name, m.manager_name;\n\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hire_data AS (\n    SELECT EXTRACT(YEAR FROM hire_date)::integer AS hire_year, employee_id, department_id\n    FROM employees.employees\n), \nhire_stats AS (\n    SELECT hire_year,\n           COUNT(employee_id) AS employees_hired,\n           AVG(s.amount) AS avg_starting_salary\n    FROM hire_data hd\n    JOIN employees.salaries s ON s.employee_id = hd.employee_id\n        AND s.from_date = (SELECT MIN(from_date) FROM employees.salaries WHERE employee_id = hd.employee_id)\n    GROUP BY hire_year\n), retention AS (\n    SELECT hd.hire_year,\n           COUNT(CASE WHEN e.is_active THEN 1 END)::float / COUNT(*) AS retention_rate\n    FROM hire_data hd\n    JOIN employees.employees e ON e.employee_id = hd.employee_id\n    GROUP BY hd.hire_year\n), top_dept AS (\n    SELECT hire_year, department_id\n    FROM (\n        SELECT hire_year, department_id, RANK() OVER (PARTITION BY hire_year ORDER BY COUNT(employee_id) DESC) AS rank\n        FROM hire_data\n        GROUP BY hire_year, department_id\n    ) ranked\n    WHERE rank = 1\n)\nSELECT hs.hire_year, hs.employees_hired, hs.avg_starting_salary, r.retention_rate, d.department_name AS top_hiring_department\nFROM hire_stats hs\nJOIN retention r ON hs.hire_year = r.hire_year\nJOIN top_dept td ON hs.hire_year = td.hire_year\nJOIN employees.departments d ON d.department_id = td.department_id;\n\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT employee_id, amount, \n    CASE \n      WHEN amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n      WHEN amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n      WHEN amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n      WHEN amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n      WHEN amount >= 110000 THEN '110K+'\n      ELSE 'Unknown'\n    END AS salary_band\n  FROM employees.salaries\n  WHERE to_date = '9999-01-01'\n), counts AS (\n  SELECT salary_band, COUNT(*) AS employee_count\n  FROM salary_bands\n  GROUP BY salary_band\n), common_titles AS (\n  SELECT sb.salary_band, st.title, COUNT(*) AS cnt,\n         RANK() OVER (PARTITION BY sb.salary_band ORDER BY COUNT(*) DESC) AS rnk\n  FROM salary_bands sb\n  JOIN employees.employee_titles et ON et.employee_id = sb.employee_id\n  JOIN employees.titles st ON st.title_id = et.title_id\n  WHERE et.current = true\n  GROUP BY sb.salary_band, st.title\n)\nSELECT c.salary_band, c.employee_count,\n       ROUND((c.employee_count * 100.0 / (SELECT COUNT(*) FROM employees.employees WHERE is_active = true)), 2) AS percentage_of_workforce,\n       (SELECT title FROM common_titles WHERE rnk = 1 AND salary_band = c.salary_band) AS most_common_title\nFROM counts c\nWHERE c.salary_band != 'Unknown';"}
