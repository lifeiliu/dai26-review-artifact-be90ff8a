de') OR\n  (ed.dept_name = 'Research' AND p.project_name = 'HR Analytics Dashboard') OR\n  (ed.dept_name = 'Production' AND p.project_name = 'Database Modernization') OR\n  (ed.dept_name = 'Quality Management' AND p.project_name = 'Employee Portal Upgrade') OR\n  (ed.dept_name = 'Customer Service' AND p.project_name = 'HR Analytics Dashboard');"}
