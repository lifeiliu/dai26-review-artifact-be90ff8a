| execute_sql {"sql": "WITH first_salaries AS (\n  SELECT employee_id, MIN(from_date) AS first_date\n  FROM employees.salary\n  GROUP BY employee_id\n),\nfirst_salary_amounts AS (\n  SELECT s.employee_id, s.amount AS first_salary\n  FROM employees.salary s\n  JOIN first_salaries fs ON s.employee_id = fs.employee_id AND s.from_date = fs.first_date\n),\ncurrent_salaries AS (\n  SELECT employee_id, amount AS current_salary\n  FROM employees.salary\n  WHERE to_date = '9999-01-01'\n),\npromotions AS (\n  SELECT employee_id, COUNT(DISTINCT title) AS promotion_count\n  FROM employees.title\n  GROUP BY employee_id\n),\nemployment_dates AS (\n  SELECT employee_id, MIN(from_date) AS start_date, MAX(to_date) AS end_date\n  FROM employees.salary\n  GROUP BY employee_id\n)\nINSERT INTO employees.employee_performance_analysis (employee_id, salary_growth_rate, days_of_service, promotion_count, performance_category)\nSELECT \n  cs.employee_id,\n  ((cs.current_salary - fsa.first_salary)::decimal / fsa.first_salary) * 100 AS salary_growth_rate,\n  (ed.end_date - ed.start_date) AS days_of_service,\n  COALESCE(p.promotion_count, 0) AS promotion_count,\n  CASE\n    WHEN ((cs.current_salary - fsa.first_salary)::decimal / fsa.first_salary) * 100 > 40 AND COALESCE(p.promotion_count, 0) > 1 THEN 'high_achiever'\n    WHEN ((cs.current_salary - fsa.first_salary)::decimal / fsa.first_salary) * 100 < 15 AND (ed.end_date - ed.start_date) > 3650 THEN 'needs_attention'\n    ELSE 'steady_performer'\n  END AS performance_category\nFROM current_salaries cs\nJOIN first_salary_amounts fsa ON cs.employee_id = fsa.employee_id\nJOIN employment_dates ed ON cs.employee_id = ed.employee_id\nLEFT JOIN promotions p ON cs.employee_id = p.employee_id;"}
| execute_sql {"sql": "WITH current_employees AS (\n  SELECT de.employee_id, d.dept_name\n  FROM employees.department_employee de\n  JOIN employees.department d ON de.department_id = d.id\n  WHERE de.to_date = '9999-01-01'\n)\nINSERT INTO employees.department_salary_analysis (department_name, avg_current_salary, employee_count, salary_range_spread)\nSELECT \n  ce.dept_name AS department_name,\n  AVG(s.amount) AS avg_current_salary,\n  COUNT(s.employee_id) AS employee_count,\n  (MAX(s.amount) - MIN(s.amount))::integer AS salary_range_spread\nFROM employees.salary s\nJOIN current_employees ce ON s.employee_id = ce.employee_id\nWHERE s.to_date = '9999-01-01'\nGROUP BY ce.dept_name;"}
