| execute_sql {"sql": "WITH first_salaries AS (\n  SELECT employee_id, MIN(from_date) AS first_date, salary AS first_salary\n  FROM employees.salaries\n  GROUP BY employee_id, salary\n),\ncurrent_salaries AS (\n  SELECT s.employee_id, s.salary AS current_salary\n  FROM employees.salaries s\n  WHERE s.to_date = '9999-01-01'\n),\npromotions AS (\n  SELECT employee_id, COUNT(DISTINCT title) AS promotion_count\n  FROM employees.titles\n  GROUP BY employee_id\n),\nemployment_dates AS (\n  SELECT employee_id, MIN(from_date) AS start_date, MAX(to_date) AS end_date\n  FROM employees.salaries\n  GROUP BY employee_id\n)\nINSERT INTO employees.employee_performance_analysis (employee_id, salary_growth_rate, days_of_service, promotion_count, performance_category)\nSELECT \n  cs.employee_id,\n  (cs.current_salary - fs.first_salary) / fs.first_salary * 100 AS salary_growth_rate,\n  (ed.end_date - ed.start_date) AS days_of_service,\n  COALESCE(p.promotion_count, 0) AS promotion_count,\n  CASE\n    WHEN ((cs.current_salary - fs.first_salary) / fs.first_salary * 100) > 40 AND COALESCE(p.promotion_count, 0) > 1 THEN 'high_achiever'\n    WHEN ((cs.current_salary - fs.first_salary) / fs.first_salary * 100) < 15 AND (ed.end_date - ed.start_date) > 3650 THEN 'needs_attention'\n    ELSE 'steady_performer'\n  END AS performance_category\nFROM current_salaries cs\nJOIN first_salaries fs ON cs.employee_id = fs.employee_id\nJOIN employment_dates ed ON cs.employee_id = ed.employee_id\nLEFT JOIN promotions p ON cs.employee_id = p.employee_id;"}
