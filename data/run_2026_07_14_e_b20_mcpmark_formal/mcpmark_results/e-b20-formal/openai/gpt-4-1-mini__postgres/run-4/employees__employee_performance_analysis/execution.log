| execute_sql {"sql": "INSERT INTO employees.department_salary_analysis (department_name, avg_current_salary, employee_count, salary_range_spread)\nSELECT \n  d.dept_name AS department_name,\n  AVG(s.salary) AS avg_current_salary,\n  COUNT(DISTINCT s.employee_id) AS employee_count,\n  (MAX(s.salary) - MIN(s.salary))::integer AS salary_range_spread\nFROM employees.salary s\nJOIN employees.department_employee de ON s.employee_id = de.employee_id\nJOIN employees.department d ON de.dept_no = d.dept_no\nWHERE s.to_date = '9999-01-01'\nGROUP BY d.dept_name;"}
