| execute_sql {"sql": "-- Check vector dimension consistency and corrupted embeddings\nWITH vector_cols AS (\n  SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n  FROM pg_attribute a\n  JOIN pg_class c ON a.attrelid = c.oid\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  WHERE a.atttypid = 'vector'::regtype\n    AND a.attnum > 0\n    AND NOT a.attisdropped\n), dimension_check AS (\n  SELECT schema_name, table_name, column_name,\n    bool_and(array_length((embedding)::float4[], 1) = 1536) as consistent_dimensions\n  FROM vector_cols vc\n  JOIN LATERAL (\n    SELECT embedding\n    FROM vc.schema_name || '.' || vc.table_name\n    LIMIT 100\n  ) t ON true\n  GROUP BY schema_name, table_name, column_name\n)\nSELECT * FROM dimension_check;"}
| execute_sql {"sql": "-- Check for outliers in vector columns by looking at vector norms exceeding typical range\nWITH vector_cols AS (\n  SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n  FROM pg_attribute a\n  JOIN pg_class c ON a.attrelid = c.oid\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  WHERE a.atttypid = 'vector'::regtype\n    AND a.attnum > 0\n    AND NOT a.attisdropped\n), outliers AS (\n  SELECT vc.schema_name, vc.table_name, vc.column_name, COUNT(*) AS outlier_count\n  FROM vector_cols vc\n  JOIN LATERAL (\n    SELECT * FROM vc.schema_name || '.' || vc.table_name\n    WHERE vector_norm(embedding) > 10\n  ) t ON true\n  GROUP BY vc.schema_name, vc.table_name, vc.column_name\n)\nSELECT * FROM outliers;"}
