| execute_sql {"sql": "INSERT INTO vector_analysis_columns (schema, table_name, column_name, dimensions, data_type, has_constraints, rows)\nSELECT \n  n.nspname AS schema,\n  c.relname AS table_name,\n  a.attname AS column_name,\n  1536 AS dimensions,\n  format_type(a.atttypid, a.atttypmod) AS data_type,\n  (a.attnotnull OR EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid = c.oid AND conkey[1] = a.attnum)) AS has_constraints,\n  (SELECT reltuples::BIGINT FROM pg_class WHERE oid = c.oid) AS rows\nFROM pg_attribute a\nJOIN pg_class c ON a.attrelid = c.oid\nJOIN pg_namespace n ON c.relnamespace = n.oid\nWHERE a.atttypid = 'vector'::regtype AND a.attnum > 0 AND NOT a.attisdropped\nORDER BY n.nspname, c.relname, a.attname;"}
| execute_sql {"sql": "-- Get storage stats for each table with vector columns\nWITH vector_columns AS (\n    SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    WHERE a.atttypid = 'vector'::regtype\n      AND a.attnum > 0\n      AND NOT a.attisdropped\n),\ntable_sizes AS (\n    SELECT\n        nspname AS schema_name,\n        relname AS table_name,\n        pg_total_relation_size(c.oid) AS total_size,\n        pg_relation_size(c.oid) AS table_size,\n        pg_relation_size(c.oid) - COALESCE(pg_relation_size(i.oid), 0) AS table_data_size\n    FROM pg_class c\n    JOIN pg_namespace n ON n.oid = c.relnamespace\n    LEFT JOIN pg_class i ON i.relname = c.relname || '_idx'\n    WHERE c.relkind = 'r'\n),\nvector_storage AS (\n    SELECT\n        vc.schema_name,\n        vc.table_name,\n        SUM(pg_column_size(t::vector)) AS vector_data_bytes\n    FROM vector_columns vc\n    JOIN LATERAL (\n      SELECT (t).embedding as t FROM vc.table_name t\n    ) AS t ON true\n    GROUP BY vc.schema_name, vc.table_name\n)\nSELECT * FROM table_sizes LIMIT 10;"}
| execute_sql {"sql": "WITH vector_columns AS (\n    SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    WHERE a.atttypid = 'vector'::regtype\n      AND a.attnum > 0\n      AND NOT a.attisdropped\n),\ntable_sizes AS (\n    SELECT\n        n.nspname AS schema_name,\n        c.relname AS table_name,\n        pg_total_relation_size(c.oid) AS total_size,\n        pg_relation_size(c.oid) AS table_size,\n        pg_relation_size(c.oid) - COALESCE(pg_relation_size(i.oid), 0) AS table_data_size\n    FROM pg_class c\n    JOIN pg_namespace n ON n.oid = c.relnamespace\n    LEFT JOIN pg_class i ON i.relname = c.relname || '_idx'\n    WHERE c.relkind = 'r'\n)\nSELECT * FROM table_sizes LIMIT 10;"}
| execute_sql {"sql": "-- Get row count and vector column storage size per table, comparing vector vs regular columns size\nWITH vector_cols AS (\n  SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n  FROM pg_attribute a\n  JOIN pg_class c ON a.attrelid = c.oid\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  WHERE a.atttypid = 'vector'::regtype\n    AND a.attnum > 0\n    AND NOT a.attisdropped\n),\nrow_counts AS (\n    SELECT nspname AS schema_name, relname AS table_name, reltuples::BIGINT AS row_count\n    FROM pg_class\n    JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n    WHERE relkind = 'r'\n),\nvector_sizes AS (\n  SELECT\n    vc.schema_name,\n    vc.table_name,\n    SUM(pg_column_size(t.v)) AS vector_data_bytes\n  FROM vector_cols vc\n  JOIN LATERAL (\n    SELECT (vc.column_name) as v\n    FROM information_schema.columns col\n    WHERE col.table_name = vc.table_name\n  ) t ON true\n  GROUP BY vc.schema_name, vc.table_name\n)\nSELECT \n  rc.schema_name,\n  rc.table_name,\n  ts.total_size,\n  COALESCE(vs.vector_data_bytes, 0) AS vector_data_bytes,\n  ts.total_size - COALESCE(vs.vector_data_bytes, 0) AS regular_data_bytes,\n  CASE WHEN ts.total_size > 0 THEN ROUND(COALESCE(vs.vector_data_bytes, 0)::NUMERIC / ts.total_size * 100, 2) ELSE 0 END AS vector_storage_pct,\n  rc.row_count\nFROM row_counts rc\nJOIN (\n  SELECT nspname AS schema_name, relname AS table_name, pg_total_relation_size(oid) AS total_size\n  FROM pg_class\n  JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n  WHERE relkind = 'r'\n) ts ON rc.schema_name = ts.schema_name AND rc.table_name = ts.table_name\nLEFT JOIN vector_sizes vs ON rc.schema_name = vs.schema_name AND rc.table_name = vs.table_name\nWHERE rc.table_name IN (SELECT table_name FROM vector_cols) \nORDER BY vector_storage_pct DESC;"}
| execute_sql {"sql": "WITH vector_cols AS (\n  SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n  FROM pg_attribute a\n  JOIN pg_class c ON a.attrelid = c.oid\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  WHERE a.atttypid = 'vector'::regtype\n    AND a.attnum > 0\n    AND NOT a.attisdropped\n),\nrow_counts AS (\n    SELECT nspname AS schema_name, relname AS table_name, reltuples::BIGINT AS row_count\n    FROM pg_class\n    JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n    WHERE relkind = 'r'\n),\ntable_sizes AS (\n  SELECT nspname AS schema_name, relname AS table_name, oid, pg_total_relation_size(oid) AS total_size\n  FROM pg_class\n  JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n  WHERE relkind = 'r'\n),\nvector_sizes AS (\n  SELECT\n    vc.schema_name,\n    vc.table_name,\n    SUM(pg_column_size(t.v)) AS vector_data_bytes\n  FROM vector_cols vc\n  JOIN LATERAL (\n    SELECT (vc.column_name) as v\n    FROM information_schema.columns col\n    WHERE col.table_name = vc.table_name\n  ) t ON true\n  GROUP BY vc.schema_name, vc.table_name\n)\nSELECT \n  rc.schema_name,\n  rc.table_name,\n  ts.total_size,\n  COALESCE(vs.vector_data_bytes, 0) AS vector_data_bytes,\n  ts.total_size - COALESCE(vs.vector_data_bytes, 0) AS regular_data_bytes,\n  CASE WHEN ts.total_size > 0 THEN ROUND(COALESCE(vs.vector_data_bytes, 0)::NUMERIC / ts.total_size * 100, 2) ELSE 0 END AS vector_storage_pct,\n  rc.row_count\nFROM row_counts rc\nJOIN table_sizes ts ON rc.schema_name = ts.schema_name AND rc.table_name = ts.table_name\nLEFT JOIN vector_sizes vs ON rc.schema_name = vs.schema_name AND rc.table_name = vs.table_name\nWHERE rc.table_name IN (SELECT table_name FROM vector_cols) \nORDER BY vector_storage_pct DESC;"}
| execute_sql {"sql": "WITH vector_cols AS (\n  SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name\n  FROM pg_attribute a\n  JOIN pg_class c ON a.attrelid = c.oid\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  WHERE a.atttypid = 'vector'::regtype\n    AND a.attnum > 0\n    AND NOT a.attisdropped\n),\nrow_counts AS (\n    SELECT nspname AS schema_name, relname AS table_name, reltuples::BIGINT AS row_count\n    FROM pg_class\n    JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n    WHERE relkind = 'r'\n),\ntable_sizes AS (\n  SELECT nspname AS schema_name, relname AS table_name, pg_class.oid AS oid, pg_total_relation_size(pg_class.oid) AS total_size\n  FROM pg_class\n  JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n  WHERE relkind = 'r'\n),\nvector_sizes AS (\n  SELECT\n    vc.schema_name,\n    vc.table_name,\n    SUM(pg_column_size(t.v)) AS vector_data_bytes\n  FROM vector_cols vc\n  JOIN LATERAL (\n    SELECT (vc.column_name) as v\n    FROM information_schema.columns col\n    WHERE col.table_name = vc.table_name\n  ) t ON true\n  GROUP BY vc.schema_name, vc.table_name\n)\nSELECT \n  rc.schema_name,\n  rc.table_name,\n  ts.total_size,\n  COALESCE(vs.vector_data_bytes, 0) AS vector_data_bytes,\n  ts.total_size - COALESCE(vs.vector_data_bytes, 0) AS regular_data_bytes,\n  CASE WHEN ts.total_size > 0 THEN ROUND(COALESCE(vs.vector_data_bytes, 0)::NUMERIC / ts.total_size * 100, 2) ELSE 0 END AS vector_storage_pct,\n  rc.row_count\nFROM row_counts rc\nJOIN table_sizes ts ON rc.schema_name = ts.schema_name AND rc.table_name = ts.table_name\nLEFT JOIN vector_sizes vs ON rc.schema_name = vs.schema_name AND rc.table_name = vs.table_name\nWHERE rc.table_name IN (SELECT table_name FROM vector_cols) \nORDER BY vector_storage_pct DESC;"}
