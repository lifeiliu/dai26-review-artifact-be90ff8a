| execute_sql {"sql": "-- Policies for Posts Table\n-- SELECT: Users can read posts in channels they have access to\nCREATE POLICY posts_select_accessible ON public.posts\n  FOR SELECT\n  USING (EXISTS (\n    SELECT 1 FROM public.channels c\n    WHERE c.id = posts.channel_id\n      AND (\n        c.is_public = true  -- Assuming a flag for public access; alternatively, adjust condition for channel access\n        OR is_channel_owner(c.id, app_current_user_id())\n        OR is_channel_moderator(c.id, app_current_user_id())\n      )\n  ));\n\n-- INSERT: Authenticated users can create posts in any channel\nCREATE POLICY posts_insert_authenticated ON public.posts\n  FOR INSERT\n  WITH CHECK (app_current_user_id() IS NOT NULL);\n\n-- UPDATE: Post authors OR channel moderators OR channel owners can edit posts\nCREATE POLICY posts_update_author_moderator_owner ON public.posts\n  FOR UPDATE\n  USING (\n    author_id = app_current_user_id()\n    OR is_channel_owner(channel_id, app_current_user_id())\n    OR is_channel_moderator(channel_id, app_current_user_id())\n  );\n\n-- DELETE: Post authors OR channel moderators OR channel owners can delete posts\nCREATE POLICY posts_delete_author_moderator_owner ON public.posts\n  FOR DELETE\n  USING (\n    author_id = app_current_user_id()\n    OR is_channel_owner(channel_id, app_current_user_id())\n    OR is_channel_moderator(channel_id, app_current_user_id())\n  );"}
| execute_sql {"sql": "-- Policies for Comments Table\n-- SELECT: Users can read comments on posts they can access\nCREATE POLICY comments_select_accessible ON public.comments\n  FOR SELECT\n  USING (EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON c.id = p.channel_id\n    WHERE p.id = comments.post_id\n      AND (\n        c.is_public = true  -- Assuming public flag else change accordingly\n        OR is_channel_owner(c.id, app_current_user_id())\n        OR is_channel_moderator(c.id, app_current_user_id())\n      )\n  ));\n\n-- INSERT: Authenticated users can comment on posts they can see\nCREATE POLICY comments_insert_authenticated ON public.comments\n  FOR INSERT\n  WITH CHECK (app_current_user_id() IS NOT NULL\n    AND EXISTS (\n      SELECT 1 FROM public.posts p\n      JOIN public.channels c ON c.id = p.channel_id\n      WHERE p.id = comments.post_id\n        AND (\n          c.is_public = true\n          OR is_channel_owner(c.id, app_current_user_id())\n          OR is_channel_moderator(c.id, app_current_user_id())\n        )\n    ));\n\n-- UPDATE: Comment authors OR post authors OR channel moderators OR channel owners can edit comments\nCREATE POLICY comments_update_authors_moderators ON public.comments\n  FOR UPDATE\n  USING (\n    author_id = app_current_user_id()\n    OR EXISTS (\n      SELECT 1 FROM public.posts p\n      WHERE p.id = comments.post_id\n        AND p.author_id = app_current_user_id()\n    )\n    OR EXISTS (\n      SELECT 1 FROM public.posts p\n      JOIN public.channels c ON c.id = p.channel_id\n      WHERE p.id = comments.post_id\n        AND (is_channel_owner(c.id, app_current_user_id())\n          OR is_channel_moderator(c.id, app_current_user_id()))\n    )\n  );\n\n-- DELETE: Comment authors OR post authors OR channel moderators OR channel owners can delete comments\nCREATE POLICY comments_delete_authors_moderators ON public.comments\n  FOR DELETE\n  USING (\n    author_id = app_current_user_id()\n    OR EXISTS (\n      SELECT 1 FROM public.posts p\n      WHERE p.id = comments.post_id\n        AND p.author_id = app_current_user_id()\n    )\n    OR EXISTS (\n      SELECT 1 FROM public.posts p\n      JOIN public.channels c ON c.id = p.channel_id\n      WHERE p.id = comments.post_id\n        AND (is_channel_owner(c.id, app_current_user_id())\n          OR is_channel_moderator(c.id, app_current_user_id()))\n    )\n  );"}
| execute_sql {"sql": "-- Policies for Channel Moderators Table\n-- SELECT: Users can see moderator lists for channels\nCREATE POLICY channel_moderators_select ON public.channel_moderators\n  FOR SELECT\n  USING (true);\n\n-- INSERT: Only channel owners can add moderators\nCREATE POLICY channel_moderators_insert_owner ON public.channel_moderators\n  FOR INSERT\n  WITH CHECK (is_channel_owner(channel_id, app_current_user_id()));\n\n-- DELETE: Channel owners can remove moderators; moderators can remove themselves\nCREATE POLICY channel_moderators_delete_owner_or_self ON public.channel_moderators\n  FOR DELETE\n  USING (is_channel_owner(channel_id, app_current_user_id()) OR moderator_id = app_current_user_id());"}
