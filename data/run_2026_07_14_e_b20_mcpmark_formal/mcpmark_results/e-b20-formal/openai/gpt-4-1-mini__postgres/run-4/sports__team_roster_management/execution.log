| execute_sql {"sql": "-- baseball_event_states has batter_id, pitcher_id which refer to persons.id\n-- Let's join baseball_offensive_stats to baseball_event_states via id=baseball_event_state_id\n-- and get batter_id as person_id\n-- Summarize by batter_id\n\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n  bes.batter_id AS person_id,\n  CASE WHEN SUM(bos.at_bats) = 0 THEN 0 ELSE SUM(bos.hits)::DECIMAL / SUM(bos.at_bats) END AS batting_avg,\n  COALESCE(SUM(bos.home_runs), 0) AS home_runs,\n  COALESCE(SUM(bos.rbi), 0) AS rbis,\n  COALESCE(COUNT(DISTINCT pem.event_id), 0) AS games_played,\n  ((CASE WHEN SUM(bos.at_bats) = 0 THEN 0 ELSE SUM(bos.hits)::DECIMAL / SUM(bos.at_bats) END) * 1000) + \n  (COALESCE(SUM(bos.home_runs), 0) * 5) + \n  (COALESCE(SUM(bos.rbi), 0) * 2) AS performance_score,\n  '2024-01-01'::DATE AS evaluation_date\nFROM baseball_offensive_stats bos\nJOIN baseball_event_states bes ON bos.id = bes.id\nLEFT JOIN person_event_metadata pem ON pem.person_id = bes.batter_id\nGROUP BY bes.batter_id\nHAVING COALESCE(COUNT(DISTINCT pem.event_id), 0) >= 10;"}
| execute_sql {"sql": "-- Step 3: Create player_injury_status table\nCREATE TABLE player_injury_status (\n    status_id SERIAL PRIMARY KEY,\n    person_id INTEGER UNIQUE NOT NULL REFERENCES persons(id),\n    injury_count INTEGER DEFAULT 0,\n    last_injury_date DATE,\n    current_status VARCHAR CHECK (current_status IN ('healthy', 'injured', 'recovering'))\n);"}
| execute_sql {"sql": "-- Step 3 continued: Insert data into player_injury_status\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT\n  pe.person_id,\n  COALESCE(COUNT(ip.id), 0) AS injury_count,\n  MAX(ip.start_date) AS last_injury_date,\n  CASE\n    WHEN MAX(ip.end_date) IS NULL THEN 'injured'\n    ELSE 'healthy'\n  END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON ip.person_id = pe.person_id\nGROUP BY pe.person_id;"}
| execute_sql {"sql": "-- Check columns in injury_phases\nSELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'injury_phases';"}
| execute_sql {"sql": "-- Adjust insert statement using start_date_time and end_date_time\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT\n  pe.person_id,\n  COALESCE(COUNT(ip.id), 0) AS injury_count,\n  MAX(ip.start_date_time)::DATE AS last_injury_date,\n  CASE\n    WHEN MAX(ip.end_date_time) IS NULL THEN 'injured'\n    ELSE 'healthy'\n  END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON ip.person_id = pe.person_id\nGROUP BY pe.person_id;"}
| execute_sql {"sql": "-- Step 4: Update player_evaluation to reduce performance_score based on health status\nUPDATE player_evaluation\nSET performance_score = GREATEST(performance_score * 0.8, 0)\nWHERE person_id IN (SELECT person_id FROM player_injury_status WHERE current_status = 'injured');\n\nUPDATE player_evaluation\nSET performance_score = GREATEST(performance_score * 0.9, 0)\nWHERE person_id IN (SELECT person_id FROM player_injury_status WHERE injury_count > 2);"}
