| execute_sql {"sql": "WITH current_employees AS (\n    SELECT e.employee_id, e.gender, s.salary, e.birth_date, e.hire_date, \n           DATE '2002-08-01' AS ref_date\n    FROM employees.employee e\n    JOIN employees.salary s ON e.employee_id = s.employee_id\n    WHERE s.to_date = '9999-01-01'\n),\n\n-- Gender Statistics\n GenderStats AS (\n    SELECT gender,\n           COUNT(*) AS total_employees,\n           COUNT(*) AS current_employees\n    FROM current_employees\n    GROUP BY gender\n),\n\n TotalCurrentEmployees AS (\n    SELECT COUNT(*) AS total_current_employees FROM current_employees\n),\n\n InsertGenderStats AS (\n    INSERT INTO employees.gender_statistics (gender, total_employees, current_employees, percentage_of_workforce)\n    SELECT \n        gender,\n        total_employees,\n        current_employees,\n        ROUND(current_employees * 100.0 / (SELECT total_current_employees FROM TotalCurrentEmployees), 2) AS percentage_of_workforce\n    FROM GenderStats\n    RETURNING *\n),\n\n-- Age Group Analysis\n AgeGroups AS (\n    SELECT employee_id,\n        CASE\n            WHEN age BETWEEN 20 AND 29 THEN '20-29'\n            WHEN age BETWEEN 30 AND 39 THEN '30-39'\n            WHEN age BETWEEN 40 AND 49 THEN '40-49'\n            WHEN age BETWEEN 50 AND 59 THEN '50-59'\n            ELSE '60+'\n        END AS age_group,\n        salary,\n        EXTRACT(DAY FROM (ref_date - hire_date)) AS tenure_days\n    FROM (\n        SELECT employee_id, salary, hire_date, \n               birth_date, \n               DATE_PART('year', AGE(ref_date, birth_date)) AS age, \n               ref_date\n        FROM current_employees\n    ) sub\n),\n\n InsertAgeGroup AS (\n    INSERT INTO employees.age_group_analysis (age_group, employee_count, avg_salary, avg_tenure_days)\n    SELECT age_group,\n           COUNT(*) AS employee_count,\n           ROUND(AVG(salary), 2) AS avg_salary,\n           ROUND(AVG(tenure_days), 2) AS avg_tenure_days\n    FROM AgeGroups\n    GROUP BY age_group\n    HAVING COUNT(*) > 0\n    RETURNING *\n),\n\n-- Birth Month Distribution\n BirthMonthDist AS (\n    SELECT \n        EXTRACT(MONTH FROM birth_date) AS birth_month,\n        TO_CHAR(birth_date, 'Month') AS month_name,\n        COUNT(*) AS employee_count,\n        SUM(CASE WHEN salary IS NOT NULL THEN 1 ELSE 0 END) AS current_employee_count\n    FROM employees.employee e\n    LEFT JOIN employees.salary s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\n    GROUP BY birth_month, month_name\n    ORDER BY birth_month\n),\n\n InsertBirthMonthDist AS (\n    INSERT INTO employees.birth_month_distribution (birth_month, month_name, employee_count, current_employee_count)\n    SELECT birth_month,\n           TRIM(month_name) AS month_name,\n           employee_count,\n           current_employee_count\n    FROM BirthMonthDist\n    RETURNING *\n),\n\n-- Hiring Year Summary\n HireYearSummary AS (\n    SELECT \n        EXTRACT(YEAR FROM hire_date) AS hire_year,\n        COUNT(*) AS employees_hired,\n        SUM(CASE WHEN s.to_date = '9999-01-01' THEN 1 ELSE 0 END) AS still_employed\n    FROM employees.employee e\n    LEFT JOIN employees.salary s ON e.employee_id = s.employee_id\n    WHERE hire_date IS NOT NULL\n    GROUP BY hire_year\n    ORDER BY hire_year\n),\n\n InsertHireYearSummary AS (\n    INSERT INTO employees.hiring_year_summary (hire_year, employees_hired, still_employed, retention_rate)\n    SELECT hire_year,\n           employees_hired,\n           still_employed,\n           ROUND((still_employed::DECIMAL / NULLIF(employees_hired, 0)) * 100, 2) AS retention_rate\n    FROM HireYearSummary\n    RETURNING *\n)\n\nSELECT 'Completed data insertion' AS result;"}
