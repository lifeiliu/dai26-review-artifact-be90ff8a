| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n  to_char(\"InvoiceDate\", 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT \"InvoiceId\") AS total_invoices,\n  SUM(\"Total\") AS total_revenue,\n  SUM(il.\"Quantity\") AS total_tracks_sold,\n  AVG(\"Total\") AS average_invoice_value,\n  COUNT(DISTINCT \"CustomerId\") AS unique_customers\nFROM public.\"Invoice\" i\nJOIN public.\"InvoiceLine\" il ON i.\"InvoiceId\" = il.\"InvoiceId\"\nGROUP BY year_month\nHAVING COUNT(DISTINCT i.\"InvoiceId\") > 0\nORDER BY year_month;"}
| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n  to_char(i.\"InvoiceDate\", 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT i.\"InvoiceId\") AS total_invoices,\n  SUM(i.\"Total\") AS total_revenue,\n  SUM(il.\"Quantity\") AS total_tracks_sold,\n  AVG(i.\"Total\") AS average_invoice_value,\n  COUNT(DISTINCT i.\"CustomerId\") AS unique_customers\nFROM public.\"Invoice\" i\nJOIN public.\"InvoiceLine\" il ON i.\"InvoiceId\" = il.\"InvoiceId\"\nGROUP BY year_month\nHAVING COUNT(DISTINCT i.\"InvoiceId\") > 0\nORDER BY year_month;"}
| execute_sql {"sql": "TRUNCATE public.top_music_charts;"}
| execute_sql {"sql": "-- Top Tracks: rank tracks by total quantity sold (only top 10, exclude zero sales)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT\n  'top_tracks' AS chart_type,\n  RANK() OVER (ORDER BY SUM(il.\"Quantity\") DESC, t.\"Name\" ASC) AS rank_position,\n  t.\"TrackId\" AS item_id,\n  t.\"Name\" AS item_name,\n  SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\nFROM public.\"InvoiceLine\" il\nJOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\nGROUP BY t.\"TrackId\", t.\"Name\"\nHAVING SUM(il.\"Quantity\") > 0\nORDER BY rank_position\nLIMIT 10;"}
| execute_sql {"sql": "-- Top Albums: rank albums by total revenue generated from their tracks (only top 10, exclude zero sales)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT\n  'top_albums' AS chart_type,\n  RANK() OVER (ORDER BY SUM(il.\"UnitPrice\" * il.\"Quantity\") DESC, al.\"Title\" ASC) AS rank_position,\n  al.\"AlbumId\" AS item_id,\n  al.\"Title\" AS item_name,\n  SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\nFROM public.\"InvoiceLine\" il\nJOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\nJOIN public.\"Album\" al ON t.\"AlbumId\" = al.\"AlbumId\"\nGROUP BY al.\"AlbumId\", al.\"Title\"\nHAVING SUM(il.\"Quantity\") > 0\nORDER BY rank_position\nLIMIT 10;"}
| execute_sql {"sql": "-- Top Artists: rank artists by total revenue from all tracks across all their albums (only top 10, exclude zero sales)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT\n  'top_artists' AS chart_type,\n  RANK() OVER (ORDER BY SUM(il.\"UnitPrice\" * il.\"Quantity\") DESC, ar.\"Name\" ASC) AS rank_position,\n  ar.\"ArtistId\" AS item_id,\n  ar.\"Name\" AS item_name,\n  SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\nFROM public.\"InvoiceLine\" il\nJOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\nJOIN public.\"Album\" al ON t.\"AlbumId\" = al.\"AlbumId\"\nJOIN public.\"Artist\" ar ON al.\"ArtistId\" = ar.\"ArtistId\"\nGROUP BY ar.\"ArtistId\", ar.\"Name\"\nHAVING SUM(il.\"Quantity\") > 0\nORDER BY rank_position\nLIMIT 10;"}
The requested monthly sales summary and top music charts system have been successfully created and populated in the public schema with two tables:

1. Table `monthly_sales_summary` holds monthly aggregated sales data including total invoices, total revenue, total tracks sold, average invoice value, and unique customers.

2. Table `top_music_charts` holds top 10 rankings for three chart types: top tracks, top albums, and top artists with their respective total revenues.

This system is now ready for Chinook's management team to use for tracking business performance and identifying trending music content.

