| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT\n  to_char(invoice_date, 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT invoice_id) AS total_invoices,\n  SUM(total) AS total_revenue,\n  SUM(quantity) AS total_tracks_sold,\n  AVG(total) AS average_invoice_value,\n  COUNT(DISTINCT customer_id) AS unique_customers\nFROM invoice\nJOIN invoice_line USING (invoice_id)\nGROUP BY year_month\nHAVING COUNT(DISTINCT invoice_id) > 0\nORDER BY year_month;"}
