| execute_sql {"sql": "-- Insert into manager_profile\nINSERT INTO employees.manager_profile (manager_id, manager_name, current_department, management_periods, current_manager)\nSELECT \n    dm.employee_id AS manager_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    CASE WHEN dm.to_date = '9999-01-01' THEN d.dept_name ELSE NULL END AS current_department,\n    COUNT(*) OVER (PARTITION BY dm.employee_id) AS management_periods,\n    (dm.to_date = '9999-01-01') AS current_manager\nFROM employees.department_manager dm\nJOIN employees.employee e ON dm.employee_id = e.id\nJOIN employees.department d ON dm.department_id = d.id;"}
| execute_sql {"sql": "-- Insert into department_leadership\nINSERT INTO employees.department_leadership (department_name, current_manager_name, manager_start_date, total_historical_managers)\nSELECT \n  d.dept_name AS department_name,\n  CONCAT(e.first_name, ' ', e.last_name) AS current_manager_name,\n  dm.from_date AS manager_start_date,\n  (SELECT COUNT(DISTINCT employee_id) FROM employees.department_manager WHERE department_id = d.id) AS total_historical_managers\nFROM employees.department_manager dm\nJOIN employees.employee e ON dm.employee_id = e.id\nJOIN employees.department d ON dm.department_id = d.id\nWHERE dm.to_date = '9999-01-01';"}
| execute_sql {"sql": "-- Insert data into management_transitions\nINSERT INTO employees.management_transitions (department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days)\nWITH manager_changes AS (\n  SELECT\n    d.dept_name AS department_name,\n    dm.employee_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    dm.from_date,\n    dm.to_date\n  FROM employees.department_manager dm\n  JOIN employees.department d ON dm.department_id = d.id\n  JOIN employees.employee e ON dm.employee_id = e.id\n), transitions AS (\n  SELECT\n    department_name,\n    to_date AS transition_date,\n    employee_id AS outgoing_manager_id,\n    manager_name AS outgoing_manager,\n    LEAD(employee_id) OVER (PARTITION BY department_name ORDER BY from_date) AS incoming_manager_id,\n    LEAD(manager_name) OVER (PARTITION BY department_name ORDER BY from_date) AS incoming_manager,\n    LEAD(from_date) OVER (PARTITION BY department_name ORDER BY from_date) AS incoming_start_date\n  FROM manager_changes\n)\nSELECT\n  department_name,\n  EXTRACT(YEAR FROM transition_date)::integer AS transition_year,\n  outgoing_manager,\n  COALESCE(incoming_manager, 'No Successor') AS incoming_manager,\n  CASE \n    WHEN incoming_start_date IS NULL THEN 0\n    ELSE GREATEST(0, incoming_start_date - transition_date)\n  END AS transition_gap_days\nFROM transitions;"}
| execute_sql {"sql": "-- Insert data into span_of_control\nINSERT INTO employees.span_of_control (manager_id, manager_name, department_name, total_employees, current_employees, management_load)\nWITH manager_employees AS (\n  SELECT\n    dm.employee_id AS manager_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    d.dept_name AS department_name\n  FROM employees.department_manager dm\n  JOIN employees.employee e ON dm.employee_id = e.id\n  JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n), department_employees AS (\n  SELECT\n    de.department_id,\n    COUNT(*) AS total_employees,\n    COUNT(CASE WHEN de.to_date = '9999-01-01' THEN 1 END) AS current_employees\n  FROM employees.department_employee de\n  GROUP BY de.department_id\n)\nSELECT\n  me.manager_id,\n  me.manager_name,\n  me.department_name,\n  COALESCE(de.total_employees, 0) AS total_employees,\n  COALESCE(de.current_employees, 0) AS current_employees,\n  CASE\n    WHEN COALESCE(de.current_employees, 0) < 5000 THEN 'light'\n    WHEN COALESCE(de.current_employees, 0) BETWEEN 5000 AND 15000 THEN 'moderate'\n    ELSE 'heavy'\n  END AS management_load\nFROM manager_employees me\nLEFT JOIN department_employees de ON me.department_name = (SELECT dept_name FROM employees.department WHERE id = de.department_id);"}
| execute_sql {"sql": "-- Correct join conditions in span_of_control insert\nINSERT INTO employees.span_of_control (manager_id, manager_name, department_name, total_employees, current_employees, management_load)\nWITH manager_employees AS (\n  SELECT\n    dm.employee_id AS manager_id,\n    CONCAT(e.first_name, ' ', e.last_name) AS manager_name,\n    d.dept_name AS department_name,\n    dm.department_id\n  FROM employees.department_manager dm\n    JOIN employees.employee e ON dm.employee_id = e.id\n    JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n), department_employees AS (\n  SELECT\n    de.department_id,\n    COUNT(*) AS total_employees,\n    COUNT(CASE WHEN de.to_date = '9999-01-01' THEN 1 END) AS current_employees\n  FROM employees.department_employee de\n  GROUP BY de.department_id\n)\nSELECT\n  me.manager_id,\n  me.manager_name,\n  me.department_name,\n  COALESCE(de.total_employees, 0) AS total_employees,\n  COALESCE(de.current_employees, 0) AS current_employees,\n  CASE\n    WHEN COALESCE(de.current_employees, 0) < 5000 THEN 'light'\n    WHEN COALESCE(de.current_employees, 0) BETWEEN 5000 AND 15000 THEN 'moderate'\n    ELSE 'heavy'\n  END AS management_load\nFROM manager_employees me\nLEFT JOIN department_employees de ON me.department_id = de.department_id;"}
