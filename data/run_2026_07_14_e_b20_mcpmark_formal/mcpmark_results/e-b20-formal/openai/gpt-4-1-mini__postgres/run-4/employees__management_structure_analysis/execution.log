| execute_sql {"sql": "-- Insert data into manager_profile\nINSERT INTO employees.manager_profile (manager_id, manager_name, current_department, management_periods, current_manager)\nSELECT \n  mgr.employee_id AS manager_id,\n  CONCAT(mgr.first_name, ' ', mgr.last_name) AS manager_name,\n  CASE WHEN mgr.to_date = '9999-01-01' THEN d.department_name ELSE NULL END AS current_department,\n  COUNT(*) AS management_periods,\n  (mgr.to_date = '9999-01-01') AS current_manager\nFROM employees.department_managers mgr\nJOIN employees.departments d ON mgr.department_id = d.department_id\nGROUP BY mgr.employee_id, mgr.first_name, mgr.last_name, mgr.to_date, d.department_name;\n"}
