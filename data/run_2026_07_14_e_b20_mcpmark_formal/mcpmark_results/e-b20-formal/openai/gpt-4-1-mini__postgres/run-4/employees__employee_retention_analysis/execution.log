| execute_sql {"sql": "INSERT INTO employees.employee_retention_analysis (department_name, total_employees_ever, current_employees, former_employees, retention_rate)\nSELECT\n  d.dept_name AS department_name,\n  COUNT(DISTINCT de.employee_id) AS total_employees_ever,\n  COUNT(DISTINCT CASE WHEN de.to_date = '9999-01-01' THEN de.employee_id END) AS current_employees,\n  COUNT(DISTINCT CASE WHEN de.to_date <> '9999-01-01' THEN de.employee_id END) AS former_employees,\n  ROUND(COALESCE(COUNT(DISTINCT CASE WHEN de.to_date = '9999-01-01' THEN de.employee_id END)::DECIMAL / NULLIF(COUNT(DISTINCT de.employee_id), 0) * 100, 0), 2) AS retention_rate\nFROM employees.department_employee de\nJOIN employees.department d ON de.department_id = d.id\nGROUP BY d.dept_name\nORDER BY d.dept_name;"}
| execute_sql {"sql": "WITH dept_retention AS (\n  SELECT\n    d.dept_name AS department_name,\n    ROUND(COALESCE(COUNT(DISTINCT CASE WHEN de.to_date = '9999-01-01' THEN de.employee_id END)::DECIMAL / NULLIF(COUNT(DISTINCT de.employee_id), 0) * 100, 0), 2) AS retention_rate\n  FROM employees.department_employee de\n  JOIN employees.department d ON de.department_id = d.id\n  GROUP BY d.dept_name\n)\nINSERT INTO employees.high_risk_employees (employee_id, full_name, current_department, tenure_days, current_salary, risk_category)\nSELECT\n  e.id AS employee_id,\n  e.first_name || ' ' || e.last_name AS full_name,\n  d.dept_name AS current_department,\n  DATE '2002-08-01' - e.hire_date AS tenure_days,\n  s.amount AS current_salary,\n  CASE\n    WHEN dr.retention_rate < 80 AND (DATE '2002-08-01' - e.hire_date) < 1095 THEN 'high_risk'\n    WHEN dr.retention_rate < 85 AND (DATE '2002-08-01' - e.hire_date) < 1825 THEN 'medium_risk'\n    ELSE 'low_risk'\n  END AS risk_category\nFROM employees.employee e\nJOIN employees.department_employee de ON e.id = de.employee_id AND de.to_date = '9999-01-01'\nJOIN employees.department d ON de.department_id = d.id\nJOIN employees.salary s ON e.id = s.employee_id AND s.to_date = '9999-01-01'\nJOIN dept_retention dr ON d.dept_name = dr.department_name\nORDER BY risk_category DESC, tenure_days;"}
| execute_sql {"sql": "INSERT INTO employees.turnover_trend_analysis (departure_year, departures_count, avg_tenure_days, avg_final_salary)\nWITH last_salary AS (\n  SELECT\n    s.employee_id,\n    s.to_date AS departure_date,\n    s.from_date,\n    s.amount,\n    ROW_NUMBER() OVER (\n      PARTITION BY s.employee_id, s.to_date\n      ORDER BY s.from_date DESC, s.amount DESC\n    ) AS rn\n  FROM employees.salary s\n),\nfinal_salary AS (\n  SELECT employee_id, departure_date, amount\n  FROM last_salary\n  WHERE rn = 1\n),\nemployee_departures AS (\n  SELECT\n    e.id,\n    e.hire_date,\n    fs.departure_date,\n    fs.amount\n  FROM employees.employee e\n  JOIN employees.department_employee de ON e.id = de.employee_id\n  JOIN final_salary fs ON e.id = fs.employee_id\n  WHERE de.to_date <> '9999-01-01'\n    AND fs.departure_date = de.to_date\n    AND fs.departure_date BETWEEN '1985-01-01' AND '2002-12-31'\n)\nSELECT\n  EXTRACT(YEAR FROM departure_date) AS departure_year,\n  COUNT(id) AS departures_count,\n  AVG(departure_date - hire_date) AS avg_tenure_days,\n  AVG(amount) AS avg_final_salary\nFROM employee_departures\nGROUP BY departure_year\nORDER BY departure_year;"}
