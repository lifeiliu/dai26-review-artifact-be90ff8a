| execute_sql {"sql": "INSERT INTO employees.employee_retention_analysis (department_name, total_employees_ever, current_employees, former_employees, retention_rate)\nSELECT\n  d.department_name,\n  COUNT(DISTINCT e.emp_no) AS total_employees_ever,\n  COUNT(DISTINCT CASE WHEN s.to_date = '9999-01-01' THEN e.emp_no END) AS current_employees,\n  COUNT(DISTINCT CASE WHEN s.to_date <> '9999-01-01' THEN e.emp_no END) AS former_employees,\n  ROUND(COALESCE(COUNT(DISTINCT CASE WHEN s.to_date = '9999-01-01' THEN e.emp_no END)::DECIMAL / NULLIF(COUNT(DISTINCT e.emp_no), 0) * 100, 0), 2) AS retention_rate\nFROM employees.employees e\nLEFT JOIN employees.dept_emp de ON e.emp_no = de.emp_no\nLEFT JOIN employees.departments d ON de.dept_no = d.dept_no\nLEFT JOIN employees.salaries s ON e.emp_no = s.emp_no\nGROUP BY d.department_name\nORDER BY d.department_name;"}
