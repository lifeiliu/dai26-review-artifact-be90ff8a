| execute_sql {"sql": "WITH current_salaries AS (\n    SELECT employee_id, salary\n    FROM employees.salary_records\n    WHERE to_date = '9999-01-01'\n),\nfirst_salaries AS (\n    SELECT s.employee_id, s.salary AS first_salary\n    FROM employees.salary_records s\n    INNER JOIN (\n        SELECT employee_id, MIN(from_date) AS first_date\n        FROM employees.salary_records\n        GROUP BY employee_id\n    ) AS first_date ON s.employee_id = first_date.employee_id AND s.from_date = first_date.first_date\n),\ndays_service AS (\n    SELECT employee_id, \n           EXTRACT(DAY FROM ('9999-01-01'::date - MIN(from_date)))::integer AS days_of_service\n    FROM employees.salary_records\n    GROUP BY employee_id\n),\npromotion_counts AS (\n    SELECT employee_id, COUNT(DISTINCT title) AS promotion_count\n    FROM employees.title_records\n    GROUP BY employee_id\n),\nsalary_growth AS (\n    SELECT c.employee_id, \n           (c.salary - f.first_salary) / f.first_salary * 100 AS salary_growth_rate\n    FROM current_salaries c\n    JOIN first_salaries f ON c.employee_id = f.employee_id\n),\nperformance_classification AS (\n    SELECT sg.employee_id, \n           CASE\n               WHEN sg.salary_growth_rate > 40 AND pc.promotion_count > 1 THEN 'high_achiever'\n               WHEN sg.salary_growth_rate < 15 AND ds.days_of_service > 3650 THEN 'needs_attention'\n               ELSE 'steady_performer'\n           END AS performance_category,\n           sg.salary_growth_rate, ds.days_of_service, pc.promotion_count\n    FROM salary_growth sg\n    JOIN days_service ds ON sg.employee_id = ds.employee_id\n    JOIN promotion_counts pc ON sg.employee_id = pc.employee_id\n)\nINSERT INTO employees.employee_performance_analysis(employee_id, performance_category, salary_growth_rate, days_of_service, promotion_count)\nSELECT employee_id, performance_category, salary_growth_rate, days_of_service, promotion_count\nFROM performance_classification;"}
