| execute_sql {"sql": "-- Step 2: Create stored procedure generate_monthly_report\nCREATE TABLE IF NOT EXISTS employees.monthly_reports (\n  report_id SERIAL PRIMARY KEY,\n  report_date DATE NOT NULL,\n  department_count INTEGER NOT NULL,\n  total_employees INTEGER NOT NULL,\n  avg_salary DECIMAL(10, 2) NOT NULL,\n  generated_at TIMESTAMP NOT NULL DEFAULT NOW()\n);\n\nCREATE OR REPLACE FUNCTION employees.generate_monthly_report(report_date DATE) RETURNS INTEGER AS $$\nDECLARE\n  v_report_id INTEGER;\n  v_department_count INTEGER;\n  v_total_employees INTEGER;\n  v_avg_salary DECIMAL(10, 2);\nBEGIN\n  SELECT COUNT(*) INTO v_department_count FROM employees.department;\n  SELECT COUNT(*) INTO v_total_employees FROM employees.department_employee WHERE to_date = '9999-01-01';\n  SELECT AVG(s.amount)::DECIMAL(10, 2) INTO v_avg_salary FROM employees.salary s WHERE s.to_date = '9999-01-01';\n\n  INSERT INTO employees.monthly_reports (report_date, department_count, total_employees, avg_salary)\n  VALUES (report_date, v_department_count, v_total_employees, v_avg_salary) RETURNING report_id INTO v_report_id;\n\n  RETURN v_report_id;\nEND;\n$$ LANGUAGE plpgsql;\n"}
| execute_sql {"sql": "-- Step 3: Create salary_alerts table and trigger for high_salary_alert\nCREATE TABLE IF NOT EXISTS employees.salary_alerts (\n  alert_id SERIAL PRIMARY KEY,\n  employee_id BIGINT NOT NULL,\n  salary_amount BIGINT NOT NULL,\n  alert_date TIMESTAMP NOT NULL DEFAULT NOW(),\n  status VARCHAR(20) NOT NULL DEFAULT 'new'\n);\n\nCREATE OR REPLACE FUNCTION employees.fn_high_salary_alert() RETURNS TRIGGER AS $$\nBEGIN\n  IF NEW.amount > 120000 THEN\n    INSERT INTO employees.salary_alerts (employee_id, salary_amount, alert_date, status)\n    VALUES (NEW.employee_id, NEW.amount, NOW(), 'new');\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER high_salary_alert\nAFTER INSERT ON employees.salary\nFOR EACH ROW\nEXECUTE FUNCTION employees.fn_high_salary_alert();\n"}
