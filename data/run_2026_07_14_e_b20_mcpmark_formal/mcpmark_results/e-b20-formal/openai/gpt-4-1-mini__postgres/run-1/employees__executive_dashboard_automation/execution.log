| execute_sql {"sql": "-- Recreate materialized view exec_salary_distribution\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH employee_salaries AS (\n  SELECT s.employee_id, s.amount\n  FROM employees.salary s\n  WHERE s.to_date = '9999-01-01'\n), salary_bands AS (\n  SELECT employee_id,\n         CASE\n           WHEN amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n           WHEN amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n           WHEN amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n           WHEN amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n           ELSE '110K+'\n         END AS salary_band\n  FROM employee_salaries\n), titles_most_common AS (\n  SELECT sb.salary_band, t.title, COUNT(*) AS cnt\n  FROM salary_bands sb\n  JOIN employees.title t ON sb.employee_id = t.employee_id\n  WHERE t.to_date = '9999-01-01'\n  GROUP BY sb.salary_band, t.title\n), most_common_titles AS (\n  SELECT salary_band, title AS most_common_title\n  FROM (\n    SELECT salary_band, title, cnt,\n           ROW_NUMBER() OVER (PARTITION BY salary_band ORDER BY cnt DESC) AS rn\n    FROM titles_most_common\n  ) ranked\n  WHERE rn = 1\n), salary_distribution AS (\n  SELECT salary_band,\n         COUNT(*) AS employee_count\n  FROM salary_bands\n  GROUP BY salary_band\n), total_emp AS (\n  SELECT COUNT(*)::decimal AS total_count FROM employee_salaries\n)\nSELECT sd.salary_band,\n       sd.employee_count,\n       ROUND((sd.employee_count / total_emp.total_count) * 100, 2)::decimal AS percentage_of_workforce,\n       COALESCE(mct.most_common_title, '') AS most_common_title\nFROM salary_distribution sd\nCROSS JOIN total_emp\nLEFT JOIN most_common_titles mct ON sd.salary_band = mct.salary_band\nORDER BY sd.salary_band;"}
| execute_sql {"sql": "-- Recreate materialized view exec_hiring_trends\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hiring_data AS (\n  SELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n         e.id AS employee_id\n  FROM employees.employee e\n), starting_salaries AS (\n  SELECT s.employee_id, MIN(s.from_date) AS start_date\n  FROM employees.salary s\n  GROUP BY s.employee_id\n), starting_salary_amounts AS (\n  SELECT s.employee_id, s.amount\n  FROM employees.salary s\n  JOIN starting_salaries ss ON s.employee_id = ss.employee_id AND s.from_date = ss.start_date\n), retention_counts AS (\n  SELECT h.hire_year,\n         COUNT(h.employee_id) AS total_hired,\n         COUNT(CASE WHEN s.to_date = '9999-01-01' THEN 1 ELSE NULL END) AS retained\n  FROM hiring_data h\n  LEFT JOIN employees.salary s ON h.employee_id = s.employee_id\n  GROUP BY h.hire_year\n), hires_per_department AS (\n  SELECT EXTRACT(YEAR FROM de.from_date)::int AS hire_year, dep.dept_name, COUNT(de.employee_id) AS hires\n  FROM employees.department_employee de\n  JOIN employees.department dep ON de.department_id = dep.id\n  GROUP BY hire_year, dep.dept_name\n)\nSELECT\n  h.hire_year,\n  rc.total_hired AS employees_hired,\n  AVG(ssa.amount)::decimal AS avg_starting_salary,\n  ROUND(COALESCE((rc.retained::decimal / NULLIF(rc.total_hired, 0)) * 100, 0), 2) AS retention_rate,\n  (SELECT dept_name FROM hires_per_department hd WHERE hd.hire_year = h.hire_year ORDER BY hires DESC LIMIT 1) AS top_hiring_department\nFROM hiring_data h\nJOIN starting_salary_amounts ssa ON h.employee_id = ssa.employee_id\nJOIN retention_counts rc ON rc.hire_year = h.hire_year\nGROUP BY h.hire_year, rc.total_hired, rc.retained\nORDER BY h.hire_year;\n"}
