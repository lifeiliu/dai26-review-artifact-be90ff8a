| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(de.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       dm.manager_name\nFROM employees.department d\nJOIN employees.department_employee de ON d.department_id = de.department_id\nJOIN employees.salary s ON de.employee_id = s.employee_id AND s.to_date = '9999-01-01'\nJOIN (\n  SELECT dm.department_id, e.employee_name AS manager_name\n  FROM employees.department_manager dm\n  JOIN employees.employee e ON dm.manager_id = e.employee_id\n  WHERE dm.to_date = '9999-01-01'\n) dm ON d.department_id = dm.department_id\nWHERE de.to_date = '9999-01-01'\nGROUP BY d.department_name, dm.manager_name;\n\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nSELECT EXTRACT(YEAR FROM e.hire_date)::int AS hire_year,\n       COUNT(e.employee_id) AS employees_hired,\n       AVG(s_start.amount)::decimal AS avg_starting_salary,\n       ROUND(COUNT(e.employee_id) FILTER (WHERE e.to_date = '9999-01-01')::decimal / NULLIF(COUNT(e.employee_id), 0)::decimal * 100, 2) AS retention_rate,\n       (SELECT d.department_name\n        FROM employees.department d\n        JOIN employees.department_employee de ON d.department_id = de.department_id\n        WHERE EXTRACT(YEAR FROM de.from_date) = EXTRACT(YEAR FROM e.hire_date)\n        GROUP BY d.department_name\n        ORDER BY COUNT(de.employee_id) DESC\n        LIMIT 1) AS top_hiring_department\nFROM employees.employee e\nJOIN employees.salary s_start ON e.employee_id = s_start.employee_id\n  AND s_start.from_date = (\n    SELECT MIN(from_date) FROM employees.salary s2 WHERE s2.employee_id = e.employee_id\n  )\nGROUP BY hire_year\nORDER BY hire_year;\n\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nSELECT salary_band,\n       COUNT(employee_id) AS employee_count,\n       ROUND(COUNT(employee_id)::decimal / NULLIF((SELECT COUNT(*) FROM employees.employee WHERE to_date = '9999-01-01'), 0) * 100, 2) AS percentage_of_workforce,\n       (SELECT t.title_name\n        FROM employees.title t\n        WHERE t.title_id = (\n          SELECT s.title_id\n          FROM employees.salary s\n          WHERE s.employee_id = e.employee_id\n            AND s.to_date = '9999-01-01'\n          LIMIT 1\n        )\n        GROUP BY t.title_name\n        ORDER BY COUNT(*) DESC\n        LIMIT 1) AS most_common_title\nFROM (\n  SELECT e.employee_id,\n         CASE\n           WHEN s.amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n           WHEN s.amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n           WHEN s.amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n           WHEN s.amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n           ELSE '110K+'\n         END AS salary_band\n  FROM employees.employee e\n  JOIN employees.salary s ON e.employee_id = s.employee_id\n  WHERE s.to_date = '9999-01-01'\n) banded\nGROUP BY salary_band\nORDER BY salary_band;\n"}
