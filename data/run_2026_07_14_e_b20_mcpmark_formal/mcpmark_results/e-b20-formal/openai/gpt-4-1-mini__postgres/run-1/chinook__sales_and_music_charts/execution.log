| execute_sql {"sql": "INSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT \n  TO_CHAR(i.\"InvoiceDate\", 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT i.\"InvoiceId\") AS total_invoices,\n  SUM(i.\"Total\") AS total_revenue,\n  SUM(il.\"Quantity\") AS total_tracks_sold,\n  AVG(i.\"Total\") AS average_invoice_value,\n  COUNT(DISTINCT i.\"CustomerId\") AS unique_customers\nFROM public.\"Invoice\" i\nJOIN public.\"InvoiceLine\" il ON i.\"InvoiceId\" = il.\"InvoiceId\"\nGROUP BY year_month\nHAVING COUNT(DISTINCT i.\"InvoiceId\") > 0;"}
| execute_sql {"sql": "WITH top_tracks_data AS (\n  SELECT \n    t.\"TrackId\" AS item_id,\n    t.\"Name\" AS item_name,\n    SUM(il.\"Quantity\") AS total_quantity,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Track\" t\n  JOIN public.\"InvoiceLine\" il ON t.\"TrackId\" = il.\"TrackId\"\n  GROUP BY t.\"TrackId\", t.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_quantity DESC, item_name\n  LIMIT 10\n), top_albums_data AS (\n  SELECT \n    a.\"AlbumId\" AS item_id,\n    a.\"Title\" AS item_name,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Album\" a\n  JOIN public.\"Track\" tr ON a.\"AlbumId\" = tr.\"AlbumId\"\n  JOIN public.\"InvoiceLine\" il ON tr.\"TrackId\" = il.\"TrackId\"\n  GROUP BY a.\"AlbumId\", a.\"Title\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name\n  LIMIT 10\n), top_artists_data AS (\n  SELECT \n    ar.\"ArtistId\" AS item_id,\n    ar.\"Name\" AS item_name,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Artist\" ar\n  JOIN public.\"Album\" al ON ar.\"ArtistId\" = al.\"ArtistId\"\n  JOIN public.\"Track\" tr ON al.\"AlbumId\" = tr.\"AlbumId\"\n  JOIN public.\"InvoiceLine\" il ON tr.\"TrackId\" = il.\"TrackId\"\n  GROUP BY ar.\"ArtistId\", ar.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name\n  LIMIT 10\n}\n\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) AS rank_position, item_id, item_name, total_revenue FROM top_tracks_data\nUNION ALL\nSELECT 'top_albums' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name) AS rank_position, item_id, item_name, total_revenue FROM top_albums_data\nUNION ALL\nSELECT 'top_artists' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name) AS rank_position, item_id, item_name, total_revenue FROM top_artists_data;"}
| execute_sql {"sql": "WITH top_tracks_data AS (\n  SELECT \n    t.\"TrackId\" AS item_id,\n    t.\"Name\" AS item_name,\n    SUM(il.\"Quantity\") AS total_quantity,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Track\" t\n  JOIN public.\"InvoiceLine\" il ON t.\"TrackId\" = il.\"TrackId\"\n  GROUP BY t.\"TrackId\", t.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_quantity DESC, item_name\n  LIMIT 10\n), top_albums_data AS (\n  SELECT \n    a.\"AlbumId\" AS item_id,\n    a.\"Title\" AS item_name,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Album\" a\n  JOIN public.\"Track\" tr ON a.\"AlbumId\" = tr.\"AlbumId\"\n  JOIN public.\"InvoiceLine\" il ON tr.\"TrackId\" = il.\"TrackId\"\n  GROUP BY a.\"AlbumId\", a.\"Title\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name\n  LIMIT 10\n), top_artists_data AS (\n  SELECT \n    ar.\"ArtistId\" AS item_id,\n    ar.\"Name\" AS item_name,\n    SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"Artist\" ar\n  JOIN public.\"Album\" al ON ar.\"ArtistId\" = al.\"ArtistId\"\n  JOIN public.\"Track\" tr ON al.\"AlbumId\" = tr.\"AlbumId\"\n  JOIN public.\"InvoiceLine\" il ON tr.\"TrackId\" = il.\"TrackId\"\n  GROUP BY ar.\"ArtistId\", ar.\"Name\"\n  HAVING SUM(il.\"Quantity\") > 0\n  ORDER BY total_revenue DESC, item_name\n  LIMIT 10\n)\n\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) AS rank_position, item_id, item_name, total_revenue FROM top_tracks_data\nUNION ALL\nSELECT 'top_albums' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name) AS rank_position, item_id, item_name, total_revenue FROM top_albums_data\nUNION ALL\nSELECT 'top_artists' AS chart_type, ROW_NUMBER() OVER (ORDER BY total_revenue DESC, item_name) AS rank_position, item_id, item_name, total_revenue FROM top_artists_data;"}
