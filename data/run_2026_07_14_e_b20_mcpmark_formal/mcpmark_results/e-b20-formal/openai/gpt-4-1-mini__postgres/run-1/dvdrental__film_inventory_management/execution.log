| execute_sql {"sql": "-- 2. Add Inventory Records for the new films\n-- Find the film_ids of the newly inserted films\nWITH new_films AS (\n    SELECT film_id, title FROM public.film\n    WHERE title IN ('Data Science Adventures', 'Cloud Computing Chronicles')\n)\nINSERT INTO public.inventory (film_id, store_id, last_update)\nSELECT film_id, store_id, now()\nFROM new_films, (VALUES (1), (2)) as stores(store_id), generate_series(1, CASE WHEN store_id = 1 THEN 3 ELSE 2 END) as copies(copy_num);"}
| execute_sql {"sql": "-- 3. Update rental_rate by increasing 10% for films with rating 'PG-13'\nUPDATE public.film\nSET rental_rate = rental_rate * 1.1,\n    last_update = now()\nWHERE rating = 'PG-13';"}
| execute_sql {"sql": "-- 4. Create available_films table\nDROP TABLE IF EXISTS public.available_films;\nCREATE TABLE public.available_films (\n    film_id INTEGER PRIMARY KEY,\n    title VARCHAR(255) NOT NULL,\n    rental_rate NUMERIC(4,2) NOT NULL,\n    length SMALLINT\n);\n\n-- Populate available_films with films meeting the criteria\nINSERT INTO public.available_films (film_id, title, rental_rate, length)\nSELECT f.film_id, f.title, f.rental_rate, f.length\nFROM public.film f\nJOIN public.inventory i ON f.film_id = i.film_id\nWHERE f.rental_rate BETWEEN 3.00 AND 5.00\n  AND f.length > 100\n  AND i.store_id = 1\nGROUP BY f.film_id;"}
| execute_sql {"sql": "-- 5. Delete inventory records for films with replacement_cost > 25.00, rental_rate < 1.00 and no rental history\nDELETE FROM public.inventory inv\nWHERE inv.film_id IN (\n    SELECT f.film_id\n    FROM public.film f\n    LEFT JOIN public.rental r ON f.film_id = r.inventory_id\n    WHERE f.replacement_cost > 25.00\n      AND f.rental_rate < 1.00\n      AND r.rental_id IS NULL\n);"}
| execute_sql {"sql": "-- 6. Create film_inventory_summary table\nDROP TABLE IF EXISTS public.film_inventory_summary;\nCREATE TABLE public.film_inventory_summary (\n    title VARCHAR(255) NOT NULL,\n    rental_rate NUMERIC(4,2) NOT NULL,\n    total_inventory INTEGER NOT NULL,\n    store1_count INTEGER NOT NULL,\n    store2_count INTEGER NOT NULL\n);\n\n-- Populate film_inventory_summary with the summary data\nINSERT INTO public.film_inventory_summary (title, rental_rate, total_inventory, store1_count, store2_count)\nSELECT f.title, f.rental_rate,\n       COUNT(i.inventory_id) AS total_inventory,\n       COUNT(CASE WHEN i.store_id = 1 THEN 1 END) AS store1_count,\n       COUNT(CASE WHEN i.store_id = 2 THEN 1 END) AS store2_count\nFROM public.film f\nJOIN public.inventory i ON f.film_id = i.film_id\nGROUP BY f.film_id\nHAVING COUNT(i.inventory_id) > 0\nORDER BY total_inventory DESC, f.title ASC;"}
