| execute_sql {"sql": "CREATE TABLE vector_analysis_columns (\n    schema VARCHAR(50),\n    table_name VARCHAR(100),\n    column_name VARCHAR(100),\n    dimensions INTEGER,\n    data_type VARCHAR(50),\n    has_constraints BOOLEAN,\n    rows BIGINT\n);"}
