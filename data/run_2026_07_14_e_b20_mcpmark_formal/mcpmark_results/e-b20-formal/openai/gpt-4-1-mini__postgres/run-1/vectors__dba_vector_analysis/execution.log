| execute_sql {"sql": "WITH vector_cols AS (\n    SELECT n.nspname AS schema,\n           c.relname AS table_name,\n           a.attname AS column_name\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    WHERE format_type(a.atttypid, a.atttypmod) LIKE 'vector%'\n      AND a.attnum > 0\n      AND NOT a.attisdropped\n), vector_storage AS (\n    SELECT schema, table_name, pg_relation_size(format('%I.%I', schema, table_name)) AS relation_size_bytes\n    FROM vector_cols\n    GROUP BY schema, table_name\n), total_sizes AS (\n    SELECT nspname as schema, relname as table_name, pg_total_relation_size(format('%I.%I', nspname, relname)) as total_size_bytes, reltuples::bigint as row_count\n    FROM pg_class\n    JOIN pg_namespace ON pg_namespace.oid = pg_class.relnamespace\n    WHERE relkind = 'r'\n), vector_bytes AS (\n    SELECT vc.schema, vc.table_name, sum(o.relpages * 8192) as vector_data_bytes\n    FROM pg_class c\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    JOIN pg_attribute a ON a.attrelid = c.oid\n    JOIN vector_cols vc ON vc.schema = n.nspname AND vc.table_name = c.relname\n    JOIN pg_class o ON o.relname = vc.table_name || '_vector_data'\n    GROUP BY vc.schema, vc.table_name\n)\nSELECT ts.schema, ts.table_name, ts.total_size_bytes, COALESCE(vb.vector_data_bytes, 0) AS vector_data_bytes, (ts.total_size_bytes - COALESCE(vb.vector_data_bytes, 0)) AS regular_data_bytes, \n    CASE WHEN ts.total_size_bytes > 0 THEN (COALESCE(vb.vector_data_bytes, 0) * 100.0 / ts.total_size_bytes) ELSE 0 END AS vector_storage_pct, \n    ts.row_count\nFROM total_sizes ts\nLEFT JOIN vector_bytes vb ON ts.schema = vb.schema AND ts.table_name = vb.table_name\nWHERE ts.schema = 'public' AND ts.table_name IN ('documents', 'document_chunks', 'user_queries');"}
