me = 'Employee Portal Upgrade' THEN 85\n        WHEN department = 'Customer Service' AND project_name = 'HR Analytics Dashboard' THEN 35\n        ELSE NULL\n    END as allocation_percentage\n    FROM emp_proj\n)\nINSERT INTO employees.project_assignments (employee_id, project_id, role, allocation_percentage, assigned_date)\nSELECT employee_id, project_id, role, allocation_percentage, DATE '2024-01-01'\nFROM assigned\nWHERE role IS NOT NULL;"}
