| execute_sql {"sql": "-- Create the consolidated table with the specified schema\nCREATE TABLE IF NOT EXISTS baseball_player_analysis (\n    player_id INTEGER NOT NULL,\n    player_name VARCHAR(255) NOT NULL,\n    team_name VARCHAR(255) DEFAULT 'Unknown',\n    games_played INTEGER,\n    at_bats INTEGER,\n    hits INTEGER,\n    runs_scored INTEGER,\n    rbi INTEGER,\n    home_runs INTEGER,\n    batting_average DECIMAL,\n    defensive_games INTEGER,\n    putouts INTEGER,\n    assists INTEGER,\n    errors INTEGER,\n    fielding_percentage DECIMAL\n);"}
| execute_sql {"sql": "-- Insert data into baseball_player_analysis from baseball_offensive_stats, baseball_defensive_stats, persons, and display_names\nWITH player_offensive AS (\n    SELECT \n        p.id AS player_id,\n        COALESCE(SUM(bos.at_bats), 0) AS at_bats,\n        COALESCE(SUM(bos.hits), 0) AS hits,\n        COALESCE(SUM(bos.runs_scored), 0) AS runs_scored,\n        COALESCE(SUM(bos.rbi), 0) AS rbi,\n        COALESCE(SUM(bos.home_runs), 0) AS home_runs,\n        COUNT(DISTINCT bes.event_id) AS games_played\n    FROM persons p\n    JOIN display_names dn ON dn.entity_id = p.id AND dn.entity_type = 'persons'\n    JOIN baseball_offensive_stats bos ON bos.id = p.id\n    JOIN baseball_event_states bes ON bes.batter_id = p.id\n    WHERE bos.at_bats >= 50\n    GROUP BY p.id\n), player_defensive AS (\n    SELECT \n        p.id AS player_id,\n        COUNT(DISTINCT bes.event_id) AS defensive_games,\n        COALESCE(SUM(bds.putouts), 0) AS putouts,\n        COALESCE(SUM(bds.assists), 0) AS assists,\n        COALESCE(SUM(bds.errors), 0) AS errors\n    FROM persons p\n    JOIN display_names dn ON dn.entity_id = p.id AND dn.entity_type = 'persons'\n    JOIN baseball_defensive_stats bds ON bds.id = p.id\n    JOIN baseball_event_states bes ON bes.batter_id = p.id\n    GROUP BY p.id\n)\nINSERT INTO baseball_player_analysis\nSELECT \n    po.player_id,\n    dn.full_name AS player_name,\n    'Unknown' AS team_name,\n    po.games_played,\n    po.at_bats,\n    po.hits,\n    po.runs_scored,\n    po.rbi,\n    po.home_runs,\n    CASE WHEN po.at_bats = 0 THEN NULL ELSE CAST(po.hits AS DECIMAL) / po.at_bats END AS batting_average,\n    pd.defensive_games AS defensive_games,\n    pd.putouts,\n    pd.assists,\n    pd.errors,\n    CASE WHEN (pd.putouts + pd.assists + pd.errors) = 0 THEN NULL ELSE CAST(pd.putouts + pd.assists AS DECIMAL) / (pd.putouts + pd.assists + pd.errors) END AS fielding_percentage\nFROM player_offensive po\nJOIN display_names dn ON dn.entity_id = po.player_id AND dn.entity_type = 'persons'\nLEFT JOIN player_defensive pd ON pd.player_id = po.player_id\nWHERE po.games_played >= 10 AND po.at_bats >= 50 AND dn.full_name IS NOT NULL\nORDER BY batting_average DESC, po.games_played DESC;"}
