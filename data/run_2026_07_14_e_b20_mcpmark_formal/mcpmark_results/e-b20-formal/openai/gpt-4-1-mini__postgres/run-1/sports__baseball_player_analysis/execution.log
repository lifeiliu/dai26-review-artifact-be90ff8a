| execute_sql {"sql": "-- Create a refined insertion query with proper joins and checks\nWITH offensive_data AS (\n    SELECT \n        p.id AS player_id,\n        dn.full_name AS player_name,\n        COUNT(DISTINCT bes.event_id) AS games_played,\n        COALESCE(SUM(bos.at_bats), 0) AS at_bats,\n        COALESCE(SUM(bos.hits), 0) AS hits,\n        COALESCE(SUM(bos.runs_scored), 0) AS runs_scored,\n        COALESCE(SUM(bos.rbi), 0) AS rbi,\n        COALESCE(SUM(bos.home_runs), 0) AS home_runs\n    FROM persons p\n    INNER JOIN display_names dn ON dn.entity_id = p.id AND dn.entity_type = 'persons'\n    INNER JOIN baseball_event_states bes ON bes.batter_id = p.id\n    INNER JOIN baseball_offensive_stats bos ON bos.id = p.id\n    GROUP BY p.id, dn.full_name\n    HAVING COUNT(DISTINCT bes.event_id) >= 10 AND SUM(bos.at_bats) >= 50 AND dn.full_name IS NOT NULL\n), defensive_data AS (\n    SELECT \n        p.id AS player_id,\n        COUNT(DISTINCT bes.event_id) AS defensive_games,\n        COALESCE(SUM(bds.putouts), 0) AS putouts,\n        COALESCE(SUM(bds.assists), 0) AS assists,\n        COALESCE(SUM(bds.errors), 0) AS errors\n    FROM persons p\n    INNER JOIN display_names dn ON dn.entity_id = p.id AND dn.entity_type = 'persons'\n    INNER JOIN baseball_defensive_players bdp ON bdp.player_id = p.id\n    INNER JOIN baseball_defensive_group bdg ON bdg.id = bdp.baseball_defensive_group_id\n    INNER JOIN baseball_defensive_stats bds ON bds.id = bdg.id\n    INNER JOIN baseball_event_states bes ON bes.batter_id = p.id\n    GROUP BY p.id\n)\nINSERT INTO baseball_player_analysis\nSELECT \n    od.player_id,\n    od.player_name,\n    'Unknown' AS team_name,\n    od.games_played,\n    od.at_bats,\n    od.hits,\n    od.runs_scored,\n    od.rbi,\n    od.home_runs,\n    CASE WHEN od.at_bats = 0 THEN NULL ELSE CAST(od.hits AS DECIMAL) / od.at_bats END AS batting_average,\n    COALESCE(dd.defensive_games, 0) AS defensive_games,\n    COALESCE(dd.putouts, 0) AS putouts,\n    COALESCE(dd.assists, 0) AS assists,\n    COALESCE(dd.errors, 0) AS errors,\n    CASE WHEN (COALESCE(dd.putouts, 0) + COALESCE(dd.assists, 0) + COALESCE(dd.errors, 0)) = 0 THEN NULL\n         ELSE CAST(COALESCE(dd.putouts, 0) + COALESCE(dd.assists, 0) AS DECIMAL) / \n              (COALESCE(dd.putouts, 0) + COALESCE(dd.assists, 0) + COALESCE(dd.errors, 0)) END AS fielding_percentage\nFROM offensive_data od\nLEFT JOIN defensive_data dd ON od.player_id = dd.player_id\nORDER BY batting_average DESC, od.games_played DESC;\n"}
