| execute_sql {"sql": "-- Users Table Policies\n\n-- SELECT: Users can read all public user profiles (username, created_at)\nCREATE POLICY select_public_profiles ON public.users\nFOR SELECT\nUSING (true);\n\n-- UPDATE: Users can only modify their own profile\nCREATE POLICY update_own_profile ON public.users\nFOR UPDATE\nUSING (id = app_current_user_id());\n\n-- DELETE: Users can only delete their own account\nCREATE POLICY delete_own_account ON public.users\nFOR DELETE\nUSING (id = app_current_user_id());\n\n-- Channels Table Policies\n\n-- SELECT: Everyone can read public channel info\nCREATE POLICY select_public_channels ON public.channels\nFOR SELECT\nUSING (true);\n\n-- INSERT: Any authenticated user can create a channel\nCREATE POLICY insert_channel_authenticated ON public.channels\nFOR INSERT\nWITH CHECK (app_current_user_id() IS NOT NULL AND owner_id = app_current_user_id());\n\n-- UPDATE: Only channel owners can modify channel details\nCREATE POLICY update_channel_owner ON public.channels\nFOR UPDATE\nUSING (is_channel_owner(id, app_current_user_id()));\n\n-- DELETE: Only channel owners can delete channels\nCREATE POLICY delete_channel_owner ON public.channels\nFOR DELETE\nUSING (is_channel_owner(id, app_current_user_id()));"}
| execute_sql {"sql": "-- Posts Table Policies\n\n-- SELECT: Users can read all posts in channels they have access to\nCREATE POLICY select_posts_on_accessible_channels ON public.posts\nFOR SELECT\nUSING (EXISTS (\n  SELECT 1 FROM public.channels c\n  WHERE c.id = channel_id\n    AND (c.is_public = true OR is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()))\n));\n\n-- INSERT: Authenticated users can create posts in any channel\nCREATE POLICY insert_posts_authenticated ON public.posts\nFOR INSERT\nWITH CHECK (app_current_user_id() IS NOT NULL);\n\n-- UPDATE: Post authors OR channel moderators OR channel owners can edit posts\nCREATE POLICY update_post_author_or_moderator_or_owner ON public.posts\nFOR UPDATE\nUSING (\n  author_id = app_current_user_id() OR\n  is_channel_moderator(channel_id, app_current_user_id()) OR\n  is_channel_owner(channel_id, app_current_user_id())\n);\n\n-- DELETE: Post authors OR channel moderators OR channel owners can delete posts\nCREATE POLICY delete_post_author_or_moderator_or_owner ON public.posts\nFOR DELETE\nUSING (\n  author_id = app_current_user_id() OR\n  is_channel_moderator(channel_id, app_current_user_id()) OR\n  is_channel_owner(channel_id, app_current_user_id())\n);"}
| execute_sql {"sql": "-- Comments Table Policies\n\n-- SELECT: Users can read comments on posts they can access\nCREATE POLICY select_comments_on_accessible_posts ON public.comments\nFOR SELECT\nUSING (\n  EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = post_id\n    AND (c.is_public = true OR is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()))\n  )\n);\n\n-- INSERT: Authenticated users can comment on posts they can see\nCREATE POLICY insert_comments_authenticated_on_accessible_posts ON public.comments\nFOR INSERT\nWITH CHECK (\n  app_current_user_id() IS NOT NULL\n  AND EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = post_id\n    AND (c.is_public = true OR is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()))\n  )\n);\n\n-- UPDATE: Comment authors OR post authors OR channel moderators OR channel owners can edit comments\nCREATE POLICY update_comment_author_post_author_or_moderators ON public.comments\nFOR UPDATE\nUSING (\n  author_id = app_current_user_id() OR\n  EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = post_id\n      AND (p.author_id = app_current_user_id())\n  ) OR\n  EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = post_id\n      AND (is_channel_moderator(c.id, app_current_user_id()) OR is_channel_owner(c.id, app_current_user_id()))\n  )\n);\n\n-- DELETE: Comment authors OR post authors OR channel moderators OR channel owners can delete comments\nCREATE POLICY delete_comment_author_post_author_or_moderators ON public.comments\nFOR DELETE\nUSING (\n  author_id = app_current_user_id() OR\n  EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = post_id\n      AND (p.author_id = app_current_user_id())\n  ) OR\n  EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON p.channel_id = c.id\n    WHERE p.id = post_id\n      AND (is_channel_moderator(c.id, app_current_user_id()) OR is_channel_owner(c.id, app_current_user_id()))\n  )\n);"}
| execute_sql {"sql": "-- Channel Moderators Table Policies\n\n-- SELECT: Users can see moderator lists for channels\nCREATE POLICY select_channel_moderators ON public.channel_moderators\nFOR SELECT\nUSING (true);\n\n-- INSERT: Only channel owners can add moderators\nCREATE POLICY insert_channel_moderators_owner_only ON public.channel_moderators\nFOR INSERT\nWITH CHECK (is_channel_owner(channel_id, app_current_user_id()));\n\n-- DELETE: Channel owners can remove moderators; moderators can remove themselves\nCREATE POLICY delete_channel_moderators_owner_or_self ON public.channel_moderators\nFOR DELETE\nUSING (is_channel_owner(channel_id, app_current_user_id()) OR moderator_id = app_current_user_id());"}
