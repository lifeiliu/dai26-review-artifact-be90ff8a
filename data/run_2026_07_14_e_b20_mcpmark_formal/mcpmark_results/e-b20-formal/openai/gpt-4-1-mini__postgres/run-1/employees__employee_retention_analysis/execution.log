| execute_sql {"sql": "-- Insert data into employee_retention_analysis\nWITH dept_counts AS (\n  SELECT\n    de.department_id,\n    d.dept_name AS department_name,\n    COUNT(DISTINCT de.employee_id) AS total_employees_ever,\n    COUNT(DISTINCT CASE WHEN de.to_date = '9999-01-01' THEN de.employee_id END) AS current_employees,\n    COUNT(DISTINCT CASE WHEN de.to_date <> '9999-01-01' THEN de.employee_id END) AS former_employees\n  FROM\n    employees.department_employee de\n    JOIN employees.department d ON de.department_id = d.id\n  GROUP BY de.department_id, d.dept_name\n), retention_rates AS (\n  SELECT\n    department_id,\n    department_name,\n    total_employees_ever,\n    current_employees,\n    former_employees,\n    CASE WHEN total_employees_ever > 0 THEN (current_employees::DECIMAL / total_employees_ever) * 100 ELSE 0 END AS retention_rate\n  FROM dept_counts\n)\nINSERT INTO employees.employee_retention_analysis\nSELECT department_name, total_employees_ever, current_employees, former_employees, retention_rate\nFROM retention_rates;"}
| execute_sql {"sql": "-- Insert data into turnover_trend_analysis considering departures between 1985 and 2002\nWITH departed_employees AS (\n  SELECT\n    e.id AS employee_id,\n    de.to_date AS departure_date,\n    EXTRACT(YEAR FROM de.to_date) AS departure_year,\n    e.hire_date,\n    de.department_id\n  FROM employees.employee e\n  JOIN employees.department_employee de ON e.id = de.employee_id\n  WHERE de.to_date <> '9999-01-01'\n    AND de.to_date BETWEEN '1985-01-01' AND '2002-12-31'\n),\nfinal_salaries AS (\n  SELECT\n    s.employee_id,\n    s.to_date,\n    s.from_date,\n    s.salary,\n    ROW_NUMBER() OVER (PARTITION BY s.employee_id, s.to_date ORDER BY s.from_date DESC, s.salary DESC) AS rn\n  FROM employees.salary s\n),\nsalaries_filtered AS (\n  SELECT employee_id, to_date, salary\n  FROM final_salaries\n  WHERE rn = 1\n),\njoined_data AS (\n  SELECT\n    d.employee_id,\n    d.departure_year,\n    EXTRACT(DAY FROM (d.to_date - e.hire_date)) AS tenure_days,\n    sf.salary AS final_salary\n  FROM departed_employees d\n  JOIN employees.employee e ON d.employee_id = e.id\n  LEFT JOIN salaries_filtered sf ON d.employee_id = sf.employee_id AND d.to_date = sf.to_date\n)\nINSERT INTO employees.turnover_trend_analysis (departure_year, departures_count, avg_tenure_days, avg_final_salary)\nSELECT\n  departure_year,\n  COUNT(employee_id) AS departures_count,\n  AVG(tenure_days) AS avg_tenure_days,\n  AVG(final_salary) AS avg_final_salary\nFROM joined_data\nGROUP BY departure_year\nORDER BY departure_year;"}
| get_object_details {"schema_name": "employees","object_name": "salary","object_type": "table"}
| execute_sql {"sql": "-- Insert data into turnover_trend_analysis considering departures between 1985 and 2002\nWITH departed_employees AS (\n  SELECT\n    e.id AS employee_id,\n    de.to_date AS departure_date,\n    EXTRACT(YEAR FROM de.to_date) AS departure_year,\n    e.hire_date,\n    de.department_id\n  FROM employees.employee e\n  JOIN employees.department_employee de ON e.id = de.employee_id\n  WHERE de.to_date <> '9999-01-01'\n    AND de.to_date BETWEEN '1985-01-01' AND '2002-12-31'\n),\nfinal_salaries AS (\n  SELECT\n    s.employee_id,\n    s.to_date,\n    s.from_date,\n    s.amount AS salary,\n    ROW_NUMBER() OVER (PARTITION BY s.employee_id, s.to_date ORDER BY s.from_date DESC, s.amount DESC) AS rn\n  FROM employees.salary s\n),\nsalaries_filtered AS (\n  SELECT employee_id, to_date, salary\n  FROM final_salaries\n  WHERE rn = 1\n),\njoined_data AS (\n  SELECT\n    d.employee_id,\n    d.departure_year,\n    EXTRACT(DAY FROM (d.to_date - e.hire_date)) AS tenure_days,\n    sf.salary AS final_salary\n  FROM departed_employees d\n  JOIN employees.employee e ON d.employee_id = e.id\n  LEFT JOIN salaries_filtered sf ON d.employee_id = sf.employee_id AND d.to_date = sf.to_date\n)\nINSERT INTO employees.turnover_trend_analysis (departure_year, departures_count, avg_tenure_days, avg_final_salary)\nSELECT\n  departure_year,\n  COUNT(employee_id) AS departures_count,\n  AVG(tenure_days) AS avg_tenure_days,\n  AVG(final_salary) AS avg_final_salary\nFROM joined_data\nGROUP BY departure_year\nORDER BY departure_year;"}
