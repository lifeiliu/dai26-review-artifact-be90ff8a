| execute_sql {"sql": "-- Insert data into turnover_trend_analysis considering departures between 1985 and 2002\nWITH departed_employees AS (\n  SELECT\n    e.id AS employee_id,\n    de.to_date AS departure_date,\n    EXTRACT(YEAR FROM de.to_date) AS departure_year,\n    e.hire_date,\n    de.department_id\n  FROM employees.employee e\n  JOIN employees.department_employee de ON e.id = de.employee_id\n  WHERE de.to_date <> '9999-01-01'\n    AND de.to_date BETWEEN '1985-01-01' AND '2002-12-31'\n),\nfinal_salaries AS (\n  SELECT\n    s.employee_id,\n    s.to_date,\n    s.from_date,\n    s.amount AS salary,\n    ROW_NUMBER() OVER (PARTITION BY s.employee_id, s.to_date ORDER BY s.from_date DESC, s.amount DESC) AS rn\n  FROM employees.salary s\n),\nsalaries_filtered AS (\n  SELECT employee_id, to_date, salary\n  FROM final_salaries\n  WHERE rn = 1\n),\njoined_data AS (\n  SELECT\n    d.employee_id,\n    d.departure_year,\n    (d.departure_date - e.hire_date) AS tenure_days,\n    sf.salary AS final_salary\n  FROM departed_employees d\n  JOIN employees.employee e ON d.employee_id = e.id\n  LEFT JOIN salaries_filtered sf ON d.employee_id = sf.employee_id AND d.departure_date = sf.to_date\n)\nINSERT INTO employees.turnover_trend_analysis (departure_year, departures_count, avg_tenure_days, avg_final_salary)\nSELECT\n  departure_year,\n  COUNT(employee_id) AS departures_count,\n  AVG(tenure_days) AS avg_tenure_days,\n  AVG(final_salary) AS avg_final_salary\nFROM joined_data\nGROUP BY departure_year\nORDER BY departure_year;"}
| execute_sql {"sql": "-- Insert data into high_risk_employees\nWITH current_employees AS (\n  SELECT\n    e.id AS employee_id,\n    e.first_name,\n    e.last_name,\n    d.dept_name AS current_department,\n    e.hire_date,\n    s.amount AS current_salary,\n    ('2002-08-01' - e.hire_date) AS tenure_days\n  FROM employees.employee e\n  JOIN employees.department_employee de ON e.id = de.employee_id\n  JOIN employees.department d ON de.department_id = d.id\n  JOIN employees.salary s ON e.id = s.employee_id\n  WHERE de.to_date = '9999-01-01' AND s.to_date = '9999-01-01'\n),\nretention_rate_per_department AS (\n  SELECT\n    department_name,\n    retention_rate\n  FROM employees.employee_retention_analysis\n)\nINSERT INTO employees.high_risk_employees\nSELECT\n  ce.employee_id,\n  CONCAT(ce.first_name, ' ', ce.last_name) AS full_name,\n  ce.current_department,\n  ce.tenure_days,\n  ce.current_salary,\n  CASE\n    WHEN rr.retention_rate < 80 AND ce.tenure_days < 1095 THEN 'high_risk'\n    WHEN rr.retention_rate < 85 AND ce.tenure_days < 1825 THEN 'medium_risk'\n    ELSE 'low_risk'\n  END AS risk_category\nFROM current_employees ce\nLEFT JOIN retention_rate_per_department rr\nON ce.current_department = rr.department_name;"}
