| execute_sql {"sql": "-- 2. Insert player performance data into player_evaluation\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n    bos.person_id,\n    CASE WHEN COALESCE(SUM(bos.at_bats),0) = 0 THEN 0 ELSE COALESCE(SUM(bos.hits),0)::DECIMAL / COALESCE(SUM(bos.at_bats),0) END AS batting_avg,\n    COALESCE(SUM(bos.home_runs),0) AS home_runs,\n    COALESCE(SUM(bos.rbi),0) AS rbis,\n    COALESCE(COUNT(DISTINCT pem.event_id),0) AS games_played,\n    ( \n      (CASE WHEN COALESCE(SUM(bos.at_bats),0) = 0 THEN 0 ELSE COALESCE(SUM(bos.hits),0)::DECIMAL / COALESCE(SUM(bos.at_bats),0) END) * 1000 \n      + COALESCE(SUM(bos.home_runs),0) * 5\n      + COALESCE(SUM(bos.rbi),0) * 2\n    ) AS performance_score,\n    DATE '2024-01-01' AS evaluation_date\nFROM baseball_offensive_stats bos\nLEFT JOIN person_event_metadata pem ON bos.person_id = pem.person_id\nGROUP BY bos.person_id\nHAVING COUNT(DISTINCT pem.event_id) >= 10;"}
