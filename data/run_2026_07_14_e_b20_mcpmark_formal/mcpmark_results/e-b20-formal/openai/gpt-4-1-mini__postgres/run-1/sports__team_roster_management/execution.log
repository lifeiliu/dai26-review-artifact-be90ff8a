| execute_sql {"sql": "-- Insert data into player_injury_status from player_evaluation and injury_phases\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT\n  pe.person_id,\n  COALESCE(COUNT(ip.injury_phase_id), 0) AS injury_count,\n  MAX(ip.start_date) AS last_injury_date,\n  CASE\n    WHEN EXISTS (\n      SELECT 1 FROM injury_phases ip2\n      WHERE ip2.person_id = pe.person_id AND ip2.end_date IS NULL\n    ) THEN 'injured'\n    ELSE 'healthy'\n  END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON pe.person_id = ip.person_id\nGROUP BY pe.person_id;"}
