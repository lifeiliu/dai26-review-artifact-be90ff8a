| execute_sql {"sql": "-- 1. Populate the manager_profile table\nWITH manager_periods_cte AS (\n    SELECT dm.employee_id AS manager_id, e.first_name || ' ' || e.last_name AS manager_name, dm.department_id,\n           COUNT(*) AS management_periods, \n           MAX(dm.to_date) AS latest_to_date\n    FROM employees.department_manager dm\n    JOIN employees.employee e ON dm.employee_id = e.id\n    GROUP BY dm.employee_id, e.first_name, e.last_name, dm.department_id\n),\ncurrent_depts AS (\n    SELECT employee_id AS manager_id, department_id\n    FROM employees.department_manager\n    WHERE to_date = '9999-01-01'\n),\nmanager_agg AS (\n    SELECT manager_id, manager_name, \n           (SELECT d.dept_name FROM employees.department d\n            JOIN current_depts cd ON cd.department_id = d.id AND cd.manager_id = mp.manager_id\n            LIMIT 1) AS current_department,\n           (SELECT COUNT(*) FROM employees.department_manager WHERE employee_id = mp.manager_id) AS management_periods,\n           EXISTS(SELECT 1 FROM current_depts cd WHERE cd.manager_id = mp.manager_id) AS current_manager\n    FROM manager_periods_cte mp\n    GROUP BY manager_id, manager_name\n)\nINSERT INTO employees.manager_profile(manager_id, manager_name, current_department, management_periods, current_manager)\nSELECT manager_id, manager_name, current_department, management_periods, current_manager FROM manager_agg;"}
| execute_sql {"sql": "-- 2. Populate the department_leadership table\nWITH current_leadership AS (\n    SELECT d.dept_name AS department_name, e.first_name || ' ' || e.last_name AS current_manager_name, dm.from_date AS manager_start_date\n    FROM employees.department_manager dm\n    JOIN employees.employee e ON dm.employee_id = e.id\n    JOIN employees.department d ON dm.department_id = d.id\n    WHERE dm.to_date = '9999-01-01'\n),\nhistorical_counts AS (\n    SELECT d.dept_name AS department_name, COUNT(DISTINCT dm.employee_id) AS total_historical_managers\n    FROM employees.department_manager dm\n    JOIN employees.department d ON dm.department_id = d.id\n    GROUP BY d.dept_name\n)\nINSERT INTO employees.department_leadership(department_name, current_manager_name, manager_start_date, total_historical_managers)\nSELECT cl.department_name, cl.current_manager_name, cl.manager_start_date, hc.total_historical_managers\nFROM current_leadership cl\nJOIN historical_counts hc ON cl.department_name = hc.department_name;"}
| execute_sql {"sql": "-- 3. Populate the management_transitions table\nWITH transitions AS (\n    SELECT d.dept_name AS department_name, \n           EXTRACT(YEAR FROM dm.to_date) AS transition_year, \n           e_out.first_name || ' ' || e_out.last_name AS outgoing_manager,\n           e_in.first_name || ' ' || e_in.last_name AS incoming_manager,\n           LEAD(dm.from_date) OVER (PARTITION BY dm.department_id ORDER BY dm.from_date) AS next_start_date,\n           dm.to_date AS outgoing_end_date\n    FROM employees.department_manager dm\n    JOIN employees.department d ON dm.department_id = d.id\n    LEFT JOIN employees.employee e_out ON dm.employee_id = e_out.id\n    LEFT JOIN employees.department_manager dm_next ON dm_next.department_id = dm.department_id AND dm_next.from_date > dm.to_date\n    LEFT JOIN employees.employee e_in ON dm_next.employee_id = e_in.id\n    WHERE dm.to_date <> '9999-01-01'\n),\nfinal_transitions AS (\n    SELECT department_name, transition_year, outgoing_manager, \n           COALESCE(incoming_manager, 'No Successor') AS incoming_manager,\n           CASE\n               WHEN next_start_date IS NOT NULL THEN GREATEST(0, next_start_date - outgoing_end_date)\n               ELSE 0\n           END AS transition_gap_days\n    FROM (\n        SELECT department_name, transition_year, outgoing_manager, incoming_manager, next_start_date, outgoing_end_date,\n               LEAD(dm.from_date) OVER (PARTITION BY dm.department_id ORDER BY dm.from_date) AS next_start_date\n        FROM employees.department_manager dm\n        JOIN employees.department d ON dm.department_id = d.id\n        LEFT JOIN employees.employee e_out ON dm.employee_id = e_out.id\n        LEFT JOIN LATERAL (\n            SELECT employee_id, from_date FROM employees.department_manager dm2 \n            WHERE dm2.department_id = dm.department_id AND dm2.from_date > dm.to_date ORDER BY dm2.from_date LIMIT 1\n        ) dm_next ON true\n        LEFT JOIN employees.employee e_in ON dm_next.employee_id = e_in.id\n        WHERE dm.to_date <> '9999-01-01'\n    ) sub\n) \nINSERT INTO employees.management_transitions(department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days)\nSELECT department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days\nFROM final_transitions;"}
| execute_sql {"sql": "-- Fixing the error in management_transitions insert by properly aliasing and selecting columns\nWITH transitions AS (\n    SELECT dm.department_id, d.dept_name AS department_name, \n           EXTRACT(YEAR FROM dm.to_date) AS transition_year, \n           e_out.first_name || ' ' || e_out.last_name AS outgoing_manager,\n           e_in.first_name || ' ' || e_in.last_name AS incoming_manager,\n           LEAD(dm.from_date) OVER (PARTITION BY dm.department_id ORDER BY dm.from_date) AS next_start_date,\n           dm.to_date AS outgoing_end_date\n    FROM employees.department_manager dm\n    JOIN employees.department d ON dm.department_id = d.id\n    LEFT JOIN employees.employee e_out ON dm.employee_id = e_out.id\n    LEFT JOIN employees.department_manager dm_next ON dm_next.department_id = dm.department_id AND dm_next.from_date > dm.to_date\n    LEFT JOIN employees.employee e_in ON dm_next.employee_id = e_in.id\n    WHERE dm.to_date <> '9999-01-01'\n),\nfinal_transitions AS (\n    SELECT department_name, transition_year, outgoing_manager, \n           COALESCE(incoming_manager, 'No Successor') AS incoming_manager,\n           CASE\n               WHEN next_start_date IS NOT NULL THEN GREATEST(0, next_start_date - outgoing_end_date)\n               ELSE 0\n           END AS transition_gap_days\n    FROM transitions\n)\nINSERT INTO employees.management_transitions(department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days)\nSELECT department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days\nFROM final_transitions;"}
| execute_sql {"sql": "-- 4. Populate the span_of_control table for current managers only\nWITH current_managers AS (\n    SELECT dm.employee_id AS manager_id, e.first_name || ' ' || e.last_name AS manager_name, dm.department_id\n    FROM employees.department_manager dm\n    JOIN employees.employee e ON dm.employee_id = e.id\n    WHERE dm.to_date = '9999-01-01'\n),\nemployee_counts AS (\n    SELECT de.department_id, \n           COUNT(*) AS total_employees,\n           COUNT(CASE WHEN e.hire_date <= CURRENT_DATE AND (e.hire_date IS NOT NULL) THEN 1 END) AS current_employees\n    FROM employees.department_employee de\n    JOIN employees.employee e ON de.employee_id = e.id\n    GROUP BY de.department_id\n),\nmanager_control AS (\n    SELECT cm.manager_id, cm.manager_name, d.dept_name AS department_name, \n           ec.total_employees, ec.current_employees\n    FROM current_managers cm\n    JOIN employees.department d ON cm.department_id = d.id\n    LEFT JOIN employee_counts ec ON cm.department_id = ec.department_id\n)\nINSERT INTO employees.span_of_control(manager_id, manager_name, department_name, total_employees, current_employees, management_load)\nSELECT manager_id, manager_name, department_name, total_employees, current_employees,\n       CASE \n         WHEN current_employees < 5000 THEN 'light'\n         WHEN current_employees BETWEEN 5000 AND 15000 THEN 'moderate'\n         ELSE 'heavy'\n       END AS management_load\nFROM manager_control;"}
The requested tables for management structure analysis have been created and populated successfully with the relevant data:

1. `manager_profile` contains manager IDs, names, current departments (if any), total management periods, and current manager status.
2. `department_leadership` lists departments with their current manager, manager start date, and the total historical managers count.
3. `management_transitions` captures year-wise management changes per department, including outgoing/incoming managers and gaps between transitions.
4. `span_of_control` shows current managers with their department employee counts and a management load classification (light, moderate, heavy).

These tables will provide the executive team with insights on leadership effectiveness, organizational hierarchy, tenure, span of control, and transitions to support optimization and succession planning.

