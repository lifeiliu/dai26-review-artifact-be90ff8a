| execute_sql {"sql": "-- 1. Populate the manager_profile table\nWITH manager_periods_cte AS (\n    SELECT dm.manager_id, e.first_name || ' ' || e.last_name AS manager_name, dm.department_id,\n           COUNT(*) AS management_periods, \n           MAX(dm.to_date) AS latest_to_date\n    FROM employees.department_manager dm\n    JOIN employees.employee e ON dm.manager_id = e.employee_id\n    GROUP BY dm.manager_id, e.first_name, e.last_name, dm.department_id\n),\ncurrent_depts AS (\n    SELECT manager_id, department_id\n    FROM employees.department_manager\n    WHERE to_date = '9999-01-01'\n),\nmanager_agg AS (\n    SELECT manager_id, manager_name, \n           -- Assuming a manager may manage multiple departments, pick the first alphabetically for current_department\n           (SELECT d.department_name FROM employees.department d\n            JOIN current_depts cd ON cd.department_id = d.department_id AND cd.manager_id = mp.manager_id\n            LIMIT 1) AS current_department,\n           (SELECT COUNT(*) FROM employees.department_manager WHERE manager_id = mp.manager_id) AS management_periods,\n           EXISTS(SELECT 1 FROM current_depts cd WHERE cd.manager_id = mp.manager_id) AS current_manager\n    FROM manager_periods_cte mp\n    GROUP BY manager_id, manager_name\n)\nINSERT INTO employees.manager_profile(manager_id, manager_name, current_department, management_periods, current_manager)\nSELECT manager_id, manager_name, current_department, management_periods, current_manager FROM manager_agg;"}
