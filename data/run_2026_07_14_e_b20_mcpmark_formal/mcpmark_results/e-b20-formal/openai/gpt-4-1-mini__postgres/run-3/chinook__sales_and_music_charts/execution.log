| execute_sql {"sql": "WITH monthly_data AS (\n  SELECT\n    TO_CHAR(i.invoice_date, 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT i.invoice_id) AS total_invoices,\n    SUM(i.total) AS total_revenue,\n    SUM(il.quantity) AS total_tracks_sold,\n    AVG(i.total) AS average_invoice_value,\n    COUNT(DISTINCT i.customer_id) AS unique_customers\n  FROM public.invoice i\n  JOIN public.invoice_line il ON i.invoice_id = il.invoice_id\n  GROUP BY year_month\n  HAVING COUNT(i.invoice_id) > 0\n)\nINSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers\nFROM monthly_data;\n"}
| list_objects {"schema_name": "public","object_type": "table"}
| execute_sql {"sql": "WITH monthly_data AS (\n  SELECT\n    TO_CHAR(i.\"InvoiceDate\", 'YYYY-MM') AS year_month,\n    COUNT(DISTINCT i.\"InvoiceId\") AS total_invoices,\n    SUM(i.\"Total\") AS total_revenue,\n    SUM(il.\"Quantity\") AS total_tracks_sold,\n    AVG(i.\"Total\") AS average_invoice_value,\n    COUNT(DISTINCT i.\"CustomerId\") AS unique_customers\n  FROM public.\"Invoice\" i\n  JOIN public.\"InvoiceLine\" il ON i.\"InvoiceId\" = il.\"InvoiceId\"\n  GROUP BY year_month\n  HAVING COUNT(i.\"InvoiceId\") > 0\n)\nINSERT INTO public.monthly_sales_summary (year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers)\nSELECT year_month, total_invoices, total_revenue, total_tracks_sold, average_invoice_value, unique_customers\nFROM monthly_data\nON CONFLICT (year_month) DO NOTHING;"}
| execute_sql {"sql": "-- Insert top 10 tracks ranked by total quantity sold\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks' AS chart_type,\n       ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) AS rank_position,\n       item_id,\n       item_name,\n       total_revenue\nFROM (\n    SELECT t.\"TrackId\" AS item_id,\n           t.\"Name\" AS item_name,\n           SUM(il.\"Quantity\") AS total_quantity,\n           SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n    FROM public.\"InvoiceLine\" il\n    JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n    GROUP BY t.\"TrackId\", t.\"Name\"\n    HAVING SUM(il.\"Quantity\") > 0\n) sub\nWHERE ROW_NUMBER() OVER (ORDER BY total_quantity DESC, item_name) <= 10\nON CONFLICT DO NOTHING;"}
| execute_sql {"sql": "WITH ranked_tracks AS (\n    SELECT t.\"TrackId\" AS item_id,\n           t.\"Name\" AS item_name,\n           SUM(il.\"Quantity\") AS total_quantity,\n           SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue,\n           ROW_NUMBER() OVER (ORDER BY SUM(il.\"Quantity\") DESC, t.\"Name\") AS rank_position\n    FROM public.\"InvoiceLine\" il\n    JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n    GROUP BY t.\"TrackId\", t.\"Name\"\n    HAVING SUM(il.\"Quantity\") > 0\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_tracks', rank_position, item_id, item_name, total_revenue\nFROM ranked_tracks\nWHERE rank_position <= 10\nON CONFLICT DO NOTHING;"}
| execute_sql {"sql": "WITH album_revenue AS (\n  SELECT al.\"AlbumId\" AS album_id, al.\"Title\" AS album_name, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  JOIN public.\"Album\" al ON t.\"AlbumId\" = al.\"AlbumId\"\n  GROUP BY al.\"AlbumId\", al.\"Title\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n), ranked_albums AS (\n  SELECT album_id AS item_id, album_name AS item_name, total_revenue,\n         ROW_NUMBER() OVER (ORDER BY total_revenue DESC, album_name) AS rank_position\n  FROM album_revenue\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_albums', rank_position, item_id, item_name, total_revenue\nFROM ranked_albums\nWHERE rank_position <= 10\nON CONFLICT DO NOTHING;"}
| execute_sql {"sql": "WITH artist_revenue AS (\n  SELECT ar.\"ArtistId\" AS artist_id, ar.\"Name\" AS artist_name, SUM(il.\"UnitPrice\" * il.\"Quantity\") AS total_revenue\n  FROM public.\"InvoiceLine\" il\n  JOIN public.\"Track\" t ON il.\"TrackId\" = t.\"TrackId\"\n  JOIN public.\"Album\" al ON t.\"AlbumId\" = al.\"AlbumId\"\n  JOIN public.\"Artist\" ar ON al.\"ArtistId\" = ar.\"ArtistId\"\n  GROUP BY ar.\"ArtistId\", ar.\"Name\"\n  HAVING SUM(il.\"UnitPrice\" * il.\"Quantity\") > 0\n), ranked_artists AS (\n  SELECT artist_id AS item_id, artist_name AS item_name, total_revenue,\n         ROW_NUMBER() OVER (ORDER BY total_revenue DESC, artist_name) AS rank_position\n  FROM artist_revenue\n)\nINSERT INTO public.top_music_charts (chart_type, rank_position, item_id, item_name, total_revenue)\nSELECT 'top_artists', rank_position, item_id, item_name, total_revenue\nFROM ranked_artists\nWHERE rank_position <= 10\nON CONFLICT DO NOTHING;"}
