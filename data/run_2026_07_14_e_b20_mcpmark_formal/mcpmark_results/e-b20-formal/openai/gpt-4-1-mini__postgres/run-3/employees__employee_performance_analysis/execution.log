| execute_sql {"sql": "WITH current_salaries AS (\n    SELECT employee_id, salary\n    FROM employees.salaries\n    WHERE to_date = '9999-01-01'\n),\nfirst_salaries AS (\n    SELECT employee_id, salary AS first_salary\n    FROM employees.salaries\n    WHERE (employee_id, from_date) IN (\n        SELECT employee_id, MIN(from_date)\n        FROM employees.salaries\n        GROUP BY employee_id\n    )\n),\ntitle_counts AS (\n    SELECT employee_id, COUNT(DISTINCT title) AS promotion_count\n    FROM employees.titles\n    GROUP BY employee_id\n),\ndays_of_service AS (\n    SELECT employee_id, \n        EXTRACT(DAY FROM (MAX(to_date) - MIN(from_date))) AS days_of_service\n    FROM employees.salaries\n    GROUP BY employee_id\n),\nsalary_growth AS (\n    SELECT c.employee_id, \n        ((c.salary::decimal / f.first_salary) - 1) * 100 AS salary_growth_rate\n    FROM current_salaries c\n    JOIN first_salaries f ON c.employee_id = f.employee_id\n)\nINSERT INTO employees.employee_performance_analysis (employee_id, performance_category, salary_growth_rate, days_of_service, promotion_count)\nSELECT \n    s.employee_id,\n    CASE \n      WHEN sg.salary_growth_rate > 40 AND tc.promotion_count > 1 THEN 'high_achiever'\n      WHEN sg.salary_growth_rate < 15 AND ds.days_of_service > 3650 THEN 'needs_attention'\n      ELSE 'steady_performer'\n    END AS performance_category,\n    sg.salary_growth_rate,\n    ds.days_of_service,\n    tc.promotion_count\nFROM current_salaries s\nJOIN salary_growth sg ON s.employee_id = sg.employee_id\nJOIN title_counts tc ON s.employee_id = tc.employee_id\nJOIN days_of_service ds ON s.employee_id = ds.employee_id;"}
