| execute_sql {"sql": "-- Insert retention analysis data\nWITH total_employees AS (\n    SELECT de.department_id, d.dept_name, COUNT(DISTINCT de.employee_id) AS total_employees_ever\n    FROM employees.department_employee de\n    JOIN employees.department d ON de.department_id = d.id\n    GROUP BY de.department_id, d.dept_name\n), current_employees AS (\n    SELECT de.department_id, COUNT(DISTINCT de.employee_id) AS current_employees\n    FROM employees.department_employee de\n    JOIN employees.employee e ON de.employee_id = e.id\n    WHERE de.to_date = '9999-01-01'\n    GROUP BY de.department_id\n), former_employees AS (\n    SELECT de.department_id, COUNT(DISTINCT de.employee_id) AS former_employees\n    FROM employees.department_employee de\n    JOIN employees.employee e ON de.employee_id = e.id\n    WHERE de.to_date <> '9999-01-01'\n    GROUP BY de.department_id\n)\nINSERT INTO employees.employee_retention_analysis (department_name, total_employees_ever, current_employees, former_employees, retention_rate)\nSELECT\n    te.dept_name AS department_name,\n    te.total_employees_ever,\n    COALESCE(ce.current_employees, 0) AS current_employees,\n    COALESCE(fe.former_employees, 0) AS former_employees,\n    CASE WHEN te.total_employees_ever > 0 THEN (COALESCE(ce.current_employees, 0)::DECIMAL / te.total_employees_ever) * 100 ELSE 0 END AS retention_rate\nFROM total_employees te\nLEFT JOIN current_employees ce ON te.department_id = ce.department_id\nLEFT JOIN former_employees fe ON te.department_id = fe.department_id\nORDER BY department_name;"}
| execute_sql {"sql": "-- Insert high risk employees data\nWITH current_emps AS (\n    SELECT e.id AS employee_id, e.first_name, e.last_name, d.dept_name AS current_department, \n           s.salary AS current_salary, e.hire_date\n    FROM employees.employee e\n    JOIN employees.department_employee de ON e.id = de.employee_id\n    JOIN employees.department d ON de.department_id = d.id\n    JOIN employees.salary s ON e.id = s.employee_id\n    WHERE s.to_date = '9999-01-01' AND de.to_date = '9999-01-01'\n), retention_rates AS (\n    SELECT department_name, retention_rate\n    FROM employees.employee_retention_analysis\n), tenure_calculation AS (\n    SELECT employee_id, first_name, last_name, current_department, current_salary, hire_date,\n           EXTRACT(DAY FROM DATE '2002-08-01' - hire_date) AS tenure_days\n    FROM current_emps\n), risk_assessment AS (\n    SELECT t.employee_id, \n           t.first_name || ' ' || t.last_name AS full_name, \n           t.current_department, \n           t.tenure_days, \n           t.current_salary,\n           CASE \n               WHEN rr.retention_rate < 80 AND t.tenure_days < 1095 THEN 'high_risk'\n               WHEN rr.retention_rate < 85 AND t.tenure_days < 1825 THEN 'medium_risk'\n               ELSE 'low_risk'\n           END AS risk_category\n    FROM tenure_calculation t\n    LEFT JOIN retention_rates rr ON t.current_department = rr.department_name\n)\nINSERT INTO employees.high_risk_employees (employee_id, full_name, current_department, tenure_days, current_salary, risk_category)\nSELECT employee_id, full_name, current_department, tenure_days, current_salary, risk_category\nFROM risk_assessment;"}
