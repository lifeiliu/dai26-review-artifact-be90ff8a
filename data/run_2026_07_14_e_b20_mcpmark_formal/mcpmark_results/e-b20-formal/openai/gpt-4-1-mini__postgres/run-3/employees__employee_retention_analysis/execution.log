| execute_sql {"sql": "WITH dept_employment AS (\n    SELECT d.department_name, e.employee_id\n    FROM employees.departments d\n    JOIN employees.employee_department ed ON d.department_id = ed.department_id\n    JOIN employees.employees e ON e.employee_id = ed.employee_id\n), total_counts AS (\n    SELECT department_name, COUNT(DISTINCT employee_id) AS total_employees_ever\n    FROM dept_employment\n    GROUP BY department_name\n), current_counts AS (\n    SELECT d.department_name, COUNT(DISTINCT e.employee_id) AS current_employees\n    FROM employees.employees e\n    JOIN employees.employee_department ed ON e.employee_id = ed.employee_id\n    JOIN employees.departments d ON ed.department_id = d.department_id\n    WHERE e.termination_date IS NULL\n    GROUP BY d.department_name\n), former_counts AS (\n    SELECT d.department_name, COUNT(DISTINCT e.employee_id) AS former_employees\n    FROM employees.employees e\n    JOIN employees.employee_department ed ON e.employee_id = ed.employee_id\n    JOIN employees.departments d ON ed.department_id = d.department_id\n    WHERE e.termination_date IS NOT NULL\n    GROUP BY d.department_name\n)\nINSERT INTO employees.employee_retention_analysis (department_name, total_employees_ever, current_employees, former_employees, retention_rate)\nSELECT\n    total_counts.department_name,\n    total_counts.total_employees_ever,\n    COALESCE(current_counts.current_employees, 0),\n    COALESCE(former_counts.former_employees, 0),\n    CASE WHEN total_counts.total_employees_ever > 0 THEN\n        (COALESCE(current_counts.current_employees, 0)::DECIMAL / total_counts.total_employees_ever) * 100\n    ELSE\n        0\n    END AS retention_rate\nFROM total_counts\nLEFT JOIN current_counts ON total_counts.department_name = current_counts.department_name\nLEFT JOIN former_counts ON total_counts.department_name = former_counts.department_name\nORDER BY total_counts.department_name;"}
