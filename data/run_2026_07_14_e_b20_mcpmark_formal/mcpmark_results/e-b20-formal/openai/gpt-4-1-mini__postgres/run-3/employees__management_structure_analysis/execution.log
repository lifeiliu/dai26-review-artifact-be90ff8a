| execute_sql {"sql": "WITH manager_names AS (\n  SELECT id AS manager_id, first_name || ' ' || last_name AS manager_name\n  FROM employees.employee\n),\nmanagement_period_counts AS (\n  SELECT employee_id AS manager_id, COUNT(*) AS management_periods\n  FROM employees.department_manager\n  GROUP BY employee_id\n),\ncurrent_managers AS (\n  SELECT dm.employee_id AS manager_id, d.dept_name AS current_department\n  FROM employees.department_manager dm\n  JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n)\nINSERT INTO employees.manager_profile (manager_id, manager_name, current_department, management_periods, current_manager)\nSELECT\n  mn.manager_id,\n  mn.manager_name,\n  cm.current_department,\n  COALESCE(mpc.management_periods, 0) AS management_periods,\n  CASE WHEN cm.manager_id IS NOT NULL THEN TRUE ELSE FALSE END AS current_manager\nFROM manager_names mn\nLEFT JOIN management_period_counts mpc ON mn.manager_id = mpc.manager_id\nLEFT JOIN current_managers cm ON mn.manager_id = cm.manager_id;"}
| execute_sql {"sql": "WITH current_manager_info AS (\n  SELECT d.dept_name AS department_name, emp.first_name || ' ' || emp.last_name AS current_manager_name, dm.from_date AS manager_start_date\n  FROM employees.department_manager dm\n  JOIN employees.department d ON dm.department_id = d.id\n  JOIN employees.employee emp ON dm.employee_id = emp.id\n  WHERE dm.to_date = '9999-01-01'\n), historical_managers AS (\n  SELECT d.dept_name AS department_name, COUNT(DISTINCT dm.employee_id) AS total_historical_managers\n  FROM employees.department_manager dm\n  JOIN employees.department d ON dm.department_id = d.id\n  GROUP BY d.dept_name\n)\nINSERT INTO employees.department_leadership (department_name, current_manager_name, manager_start_date, total_historical_managers)\nSELECT c.department_name, c.current_manager_name, c.manager_start_date, COALESCE(h.total_historical_managers, 0)\nFROM current_manager_info c\nLEFT JOIN historical_managers h ON c.department_name = h.department_name;"}
| execute_sql {"sql": "WITH dept_management AS (\n  SELECT d.dept_name AS department_name, dm.employee_id, dm.from_date, dm.to_date\n  FROM employees.department_manager dm\n  JOIN employees.department d ON dm.department_id = d.id\n), ordered_transitions AS (\n  SELECT department_name, employee_id, from_date, to_date,\n         LEAD(employee_id) OVER (PARTITION BY department_name ORDER BY from_date) AS next_manager,\n         LEAD(from_date) OVER (PARTITION BY department_name ORDER BY from_date) AS next_manager_start_date\n  FROM dept_management\n), transitions AS (\n  SELECT department_name, EXTRACT(YEAR FROM to_date) AS transition_year, e1.id || ' ' || e1.first_name || ' ' || e1.last_name AS outgoing_manager,\n         COALESCE(e2.first_name || ' ' || e2.last_name, 'No Successor') AS incoming_manager,\n         CASE \n           WHEN next_manager_start_date IS NULL THEN 0\n           ELSE GREATEST(0, next_manager_start_date - to_date)\n         END AS transition_gap_days\n  FROM ordered_transitions ot\n  LEFT JOIN employees.employee e1 ON ot.employee_id = e1.id\n  LEFT JOIN employees.employee e2 ON ot.next_manager = e2.id\n  WHERE ot.to_date <> '9999-01-01'\n)\nINSERT INTO employees.management_transitions (department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days)\nSELECT department_name, transition_year, outgoing_manager, incoming_manager, transition_gap_days\nFROM transitions;"}
| execute_sql {"sql": "WITH current_managers AS (\n  SELECT dm.employee_id AS manager_id, emp.first_name || ' ' || emp.last_name AS manager_name, d.dept_name AS department_name\n  FROM employees.department_manager dm\n  JOIN employees.employee emp ON dm.employee_id = emp.id\n  JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n),\nemployee_counts AS (\n  SELECT department_id, COUNT(*) AS total_employees,\n         COUNT(*) FILTER (WHERE to_date = '9999-01-01') AS current_employees\n  FROM employees.department_employee\n  GROUP BY department_id\n)\nINSERT INTO employees.span_of_control (manager_id, manager_name, department_name, total_employees, current_employees, management_load)\nSELECT cm.manager_id, cm.manager_name, cm.department_name,\n       COALESCE(ec.total_employees, 0) AS total_employees,\n       COALESCE(ec.current_employees, 0) AS current_employees,\n       CASE \n         WHEN COALESCE(ec.current_employees, 0) < 5000 THEN 'light'\n         WHEN COALESCE(ec.current_employees, 0) BETWEEN 5000 AND 15000 THEN 'moderate'\n         ELSE 'heavy'\n       END AS management_load\nFROM current_managers cm\nLEFT JOIN employee_counts ec ON cm.department_name = (SELECT dept_name FROM employees.department WHERE id = ec.department_id);\n"}
| execute_sql {"sql": "WITH current_managers AS (\n  SELECT dm.employee_id AS manager_id, emp.first_name || ' ' || emp.last_name AS manager_name, d.id AS department_id, d.dept_name AS department_name\n  FROM employees.department_manager dm\n  JOIN employees.employee emp ON dm.employee_id = emp.id\n  JOIN employees.department d ON dm.department_id = d.id\n  WHERE dm.to_date = '9999-01-01'\n),\nemployee_counts AS (\n  SELECT department_id, COUNT(*) AS total_employees,\n         COUNT(*) FILTER (WHERE to_date = '9999-01-01') AS current_employees\n  FROM employees.department_employee\n  GROUP BY department_id\n)\nINSERT INTO employees.span_of_control (manager_id, manager_name, department_name, total_employees, current_employees, management_load)\nSELECT cm.manager_id, cm.manager_name, cm.department_name,\n       COALESCE(ec.total_employees, 0) AS total_employees,\n       COALESCE(ec.current_employees, 0) AS current_employees,\n       CASE \n         WHEN COALESCE(ec.current_employees, 0) < 5000 THEN 'light'\n         WHEN COALESCE(ec.current_employees, 0) BETWEEN 5000 AND 15000 THEN 'moderate'\n         ELSE 'heavy'\n       END AS management_load\nFROM current_managers cm\nLEFT JOIN employee_counts ec ON cm.department_id = ec.department_id;"}
I have created the required tables: `manager_profile`, `department_leadership`, `management_transitions`, and `span_of_control` in the `employees` schema.

Then, I populated:

1. The `manager_profile` table with manager IDs, names, current departments if applicable, total management periods, and current management status.
2. The `department_leadership` table showing each department’s current manager, their start date, and the total historical managers for the department.
3. The `management_transitions` table to capture management changes by department, including years, outgoing and incoming managers, and any gaps between transitions.
4. The `span_of_control` table with current managers' IDs, names, departments, total and current employee counts, and management load classification (light/moderate/heavy).

This comprehensive management structure analysis now provides insights into leadership tenure, span of control, organizational hierarchy stability, and identifies areas for succession planning and management optimization.

