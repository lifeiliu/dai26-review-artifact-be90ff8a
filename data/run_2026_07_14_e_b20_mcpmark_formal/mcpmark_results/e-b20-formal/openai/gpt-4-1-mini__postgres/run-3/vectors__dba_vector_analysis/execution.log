| list_objects {"schema_name": "public","object_type": "index"}
| execute_sql {"sql": "SELECT\n  n.nspname AS schema,\n  t.relname AS table_name,\n  i.relname AS index_name,\n  am.amname AS index_type,\n  pg_relation_size(i.oid) AS index_size_bytes,\n  array_to_string(array_agg(a.attname), ',') AS column_names\nFROM pg_index ix\nJOIN pg_class t ON t.oid = ix.indrelid\nJOIN pg_class i ON i.oid = ix.indexrelid\nJOIN pg_namespace n ON n.oid = t.relnamespace\nJOIN pg_am am ON i.relam = am.oid\nJOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)\nWHERE n.nspname NOT IN ('pg_catalog', 'information_schema', 'pg_toast')\nGROUP BY n.nspname, t.relname, i.relname, am.amname\nORDER BY n.nspname, t.relname, i.relname;"}
| execute_sql {"sql": "SELECT\n  n.nspname AS schema,\n  t.relname AS table_name,\n  i.relname AS index_name,\n  am.amname AS index_type,\n  SUM(pg_relation_size(i.oid)) AS index_size_bytes,\n  array_to_string(array_agg(a.attname), ',') AS column_names\nFROM pg_index ix\nJOIN pg_class t ON t.oid = ix.indrelid\nJOIN pg_class i ON i.oid = ix.indexrelid\nJOIN pg_namespace n ON n.oid = t.relnamespace\nJOIN pg_am am ON i.relam = am.oid\nJOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)\nWHERE n.nspname NOT IN ('pg_catalog', 'information_schema', 'pg_toast')\nGROUP BY n.nspname, t.relname, i.relname, am.amname\nORDER BY n.nspname, t.relname, i.relname;"}
| execute_sql {"sql": "-- Create and populate vector_analysis_indices table\nDROP TABLE IF EXISTS vector_analysis_indices;\nCREATE TABLE vector_analysis_indices (\n  schema VARCHAR(50),\n  table_name VARCHAR(100),\n  column_name VARCHAR(100),\n  index_name VARCHAR(100),\n  index_type VARCHAR(50),\n  index_size_bytes BIGINT\n);\n\nINSERT INTO vector_analysis_indices (schema, table_name, column_name, index_name, index_type, index_size_bytes)\nSELECT\n  n.nspname AS schema,\n  t.relname AS table_name,\n  a.attname AS column_name,\n  i.relname AS index_name,\n  am.amname AS index_type,\n  pg_relation_size(i.oid) AS index_size_bytes\nFROM pg_index ix\nJOIN pg_class t ON t.oid = ix.indrelid\nJOIN pg_class i ON i.oid = ix.indexrelid\nJOIN pg_namespace n ON n.oid = t.relnamespace\nJOIN pg_am am ON i.relam = am.oid\nJOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)\nWHERE n.nspname NOT IN ('pg_catalog', 'information_schema', 'pg_toast')\n  AND am.amname IN ('hnsw', 'ivfflat')\nORDER BY schema, table_name, index_name;"}
| execute_sql {"sql": "-- Insert all vector indexes including HNSW and fallback others for completeness\nINSERT INTO vector_analysis_indices (schema, table_name, column_name, index_name, index_type, index_size_bytes)\nSELECT\n  n.nspname AS schema,\n  t.relname AS table_name,\n  a.attname AS column_name,\n  i.relname AS index_name,\n  am.amname AS index_type,\n  pg_relation_size(i.oid) AS index_size_bytes\nFROM pg_index ix\nJOIN pg_class t ON t.oid = ix.indrelid\nJOIN pg_class i ON i.oid = ix.indexrelid\nJOIN pg_namespace n ON n.oid = t.relnamespace\nJOIN pg_am am ON i.relam = am.oid\nJOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = ANY(ix.indkey)\nWHERE n.nspname NOT IN ('pg_catalog', 'information_schema', 'pg_toast')\nORDER BY schema, table_name, index_name;"}
| execute_sql {"sql": "SELECT * FROM vector_analysis_indices;"}
| execute_sql {"sql": "-- Check for NULL vector embeddings or dimension mismatches\nSELECT\n  schema,\n  table_name,\n  column_name,\n  COUNT(*) AS null_vectors,\n  SUM(CASE WHEN array_length(%I::float4[], 1) != dimensions THEN 1 ELSE 0 END) AS dimension_mismatches\nFROM (\n  SELECT\n    schema,\n    table_name,\n    column_name,\n    dimensions\n  FROM vector_analysis_columns\n) vc\nJOIN LATERAL (\n  EXECUTE FORMAT('SELECT * FROM %I.%I', vc.schema, vc.table_name)\n) AS t ON true\nGROUP BY schema, table_name, column_name;"}
| execute_sql {"sql": "-- Check for NULL vector embeddings and dimension mismatches per vector column\n-- We need to do this per column due to SQL limitations; use dynamic SQL for each\nDO $$\nDECLARE\n  rec RECORD;\n  v_null_count BIGINT;\n  v_mismatch_count BIGINT;\nBEGIN\n  RAISE NOTICE 'schema | table_name | column | null_count | dimension_mismatch';\n  FOR rec IN SELECT schema, table_name, column_name, dimensions FROM vector_analysis_columns LOOP\n    EXECUTE FORMAT(\n      'SELECT COUNT(*) FILTER (WHERE %1$I IS NULL), COUNT(*) FILTER (WHERE array_length(%1$I::float4[], 1) != %2$L) FROM %3$I.%4$I',\n      rec.column_name, rec.dimensions, rec.schema, rec.table_name\n    ) INTO v_null_count, v_mismatch_count;\n\n    RAISE NOTICE '% | % | % | % | %', rec.schema, rec.table_name, rec.column_name, v_null_count, v_mismatch_count;\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- Check for outliers in vectors using approximate length (Euclidean norm) in each vector column\nDO $$\nDECLARE\n  rec RECORD;\n  v_max FLOAT;\n  v_min FLOAT;\n  v_avg FLOAT;\n  v_stddev FLOAT;\nBEGIN\n  RAISE NOTICE 'schema | table_name | column | min_norm | max_norm | avg_norm | stddev_norm';\n  FOR rec IN SELECT schema, table_name, column_name FROM vector_analysis_columns LOOP\n    EXECUTE FORMAT(\n      'SELECT MIN(sqrt(sum(pow(elem, 2)))), MAX(sqrt(sum(pow(elem, 2)))), AVG(sqrt(sum(pow(elem, 2)))), STDDEV_SAMP(sqrt(sum(pow(elem, 2)))) FROM (SELECT unnest(%1$I::float4[]) AS elem FROM %2$I.%3$I) AS sub',\n      rec.column_name, rec.schema, rec.table_name\n    ) INTO v_min, v_max, v_avg, v_stddev;\n\n    RAISE NOTICE '% | % | % | % | % | % | %', rec.schema, rec.table_name, rec.column_name, v_min, v_max, v_avg, v_stddev;\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- Calculate vector norms for each vector as sqrt(sum of squares of vector elements), then aggregate stats\nDO $$\nDECLARE\n  rec RECORD;\n  v_min FLOAT;\n  v_max FLOAT;\n  v_avg FLOAT;\n  v_stddev FLOAT;\nBEGIN\n  RAISE NOTICE 'schema | table_name | column | min_norm | max_norm | avg_norm | stddev_norm';\n  FOR rec IN SELECT schema, table_name, column_name FROM vector_analysis_columns LOOP\n    EXECUTE FORMAT(\n      'SELECT MIN(norm), MAX(norm), AVG(norm), STDDEV_SAMP(norm) FROM (SELECT sqrt(sum(pow(elem, 2))) AS norm FROM (SELECT unnest(%I::float4[]) AS elem FROM %I.%I) AS elems GROUP BY 1) AS norms',\n      rec.column_name, rec.schema, rec.table_name\n    ) INTO v_min, v_max, v_avg, v_stddev;\n\n    RAISE NOTICE '% | % | % | % | % | % | %', rec.schema, rec.table_name, rec.column_name, v_min, v_max, v_avg, v_stddev;\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- Calculate norms for each vector row by summing squares of elements, then aggregate\nDO $$\nDECLARE\n  rec RECORD;\n  v_min FLOAT;\n  v_max FLOAT;\n  v_avg FLOAT;\n  v_stddev FLOAT;\nBEGIN\n  RAISE NOTICE 'schema | table_name | column | min_norm | max_norm | avg_norm | stddev_norm';\n  FOR rec IN SELECT schema, table_name, column_name FROM vector_analysis_columns LOOP\n    EXECUTE FORMAT(\n      'SELECT MIN(norm), MAX(norm), AVG(norm), STDDEV_SAMP(norm) FROM (SELECT sqrt(SUM(POWER(elem, 2))) AS norm FROM (SELECT unnest(%I::float4[]) AS elem FROM %I.%I) AS unnested GROUP BY 1) AS norms',\n      rec.column_name, rec.schema, rec.table_name\n    ) INTO v_min, v_max, v_avg, v_stddev;\n\n    RAISE NOTICE '% | % | % | % | % | % | %', rec.schema, rec.table_name, rec.column_name, v_min, v_max, v_avg, v_stddev;\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- Manually calculate norms per vector row and aggregate without Group By using ROW_NUMBER\nDO $$\nDECLARE\n  rec RECORD;\n  v_min FLOAT;\n  v_max FLOAT;\n  v_avg FLOAT;\n  v_stddev FLOAT;\nBEGIN\n  RAISE NOTICE 'schema | table_name | column | min_norm | max_norm | avg_norm | stddev_norm';\n  FOR rec IN SELECT schema, table_name, column_name FROM vector_analysis_columns LOOP\n    EXECUTE FORMAT(\n      'WITH norms AS (\n         SELECT sqrt(SUM(pow(elem, 2))) AS norm FROM (SELECT unnest(%I::float4[]) AS elem FROM %I.%I) unnested GROUP BY ROW_NUMBER() OVER ()\n       )\n       SELECT MIN(norm), MAX(norm), AVG(norm), STDDEV_SAMP(norm) FROM norms',\n      rec.column_name, rec.schema, rec.table_name\n    ) INTO v_min, v_max, v_avg, v_stddev;\n\n    RAISE NOTICE '% | % | % | % | % | % | %', rec.schema, rec.table_name, rec.column_name, v_min, v_max, v_avg, v_stddev;\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- Calculate vector norms row-wise without window functions by using generate_series for row number\nDO $$\nDECLARE\n  rec RECORD;\n  v_min FLOAT;\n  v_max FLOAT;\n  v_avg FLOAT;\n  v_stddev FLOAT;\nBEGIN\n  RAISE NOTICE 'schema | table_name | column | min_norm | max_norm | avg_norm | stddev_norm';\n  FOR rec IN SELECT schema, table_name, column_name FROM vector_analysis_columns LOOP\n    EXECUTE FORMAT(\n      'WITH vecs AS (SELECT %1$I FROM %2$I.%3$I),\n        norms AS (\n          SELECT sqrt(sum(pow(elem, 2))) AS norm FROM (\n            SELECT unnest(vecs.%1$I::float4[]) AS elem FROM generate_series(1, (SELECT count(*) FROM %2$I.%3$I)) gs\n          ) sub\n        )\n       SELECT MIN(norm), MAX(norm), AVG(norm), STDDEV_SAMP(norm) FROM norms',\n      rec.column_name, rec.schema, rec.table_name\n    ) INTO v_min, v_max, v_avg, v_stddev;\n\n    RAISE NOTICE '% | % | % | % | % | % | %', rec.schema, rec.table_name, rec.column_name, v_min, v_max, v_avg, v_stddev;\n  END LOOP;\nEND $$;"}
