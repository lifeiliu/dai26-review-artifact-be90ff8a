| execute_sql {"sql": "-- Create and populate vector_analysis_storage_consumption\nDROP TABLE IF EXISTS vector_analysis_storage_consumption;\nCREATE TABLE vector_analysis_storage_consumption (\n    schema VARCHAR(50),\n    table_name VARCHAR(100),\n    total_size_bytes BIGINT,\n    vector_data_bytes BIGINT,\n    regular_data_bytes BIGINT,\n    vector_storage_pct NUMERIC(5,2),\n    row_count BIGINT\n);\n\n-- Insert storage info for tables with vector columns\nWITH vector_cols AS (\n  SELECT schema, table_name, column_name\n  FROM vector_analysis_columns\n)\nINSERT INTO vector_analysis_storage_consumption\nSELECT\n  v.schema,\n  v.table_name,\n  pg_total_relation_size(format('%I.%I', v.schema, v.table_name)::regclass) AS total_size_bytes,\n  pg_column_size(t.v)::BIGINT AS vector_data_bytes,\n  (pg_total_relation_size(format('%I.%I', v.schema, v.table_name)::regclass) - pg_column_size(t.v)::BIGINT) AS regular_data_bytes,\n  CASE WHEN pg_total_relation_size(format('%I.%I', v.schema, v.table_name)::regclass) > 0\n       THEN (pg_column_size(t.v)::NUMERIC / pg_total_relation_size(format('%I.%I', v.schema, v.table_name)::regclass)::NUMERIC) * 100\n       ELSE 0\n  END AS vector_storage_pct,\n  (SELECT rows FROM vector_analysis_columns c2 WHERE c2.schema = v.schema AND c2.table_name = v.table_name LIMIT 1) AS row_count\nFROM vector_cols v,\nLATERAL (\n  SELECT SUM(pg_column_size((v.table_name || '.' || v.column_name)::regclass)) AS v\n) t\nLIMIT 100;"}
| execute_sql {"sql": "-- Calculate vector storage for each table by summing vector column sizes dynamically for each row is expensive, instead estimate by average column size * row count\nDROP TABLE IF EXISTS vector_analysis_storage_consumption;\nCREATE TABLE vector_analysis_storage_consumption (\n    schema VARCHAR(50),\n    table_name VARCHAR(100),\n    total_size_bytes BIGINT,\n    vector_data_bytes BIGINT,\n    regular_data_bytes BIGINT,\n    vector_storage_pct NUMERIC(5,2),\n    row_count BIGINT\n);\n\nINSERT INTO vector_analysis_storage_consumption (schema, table_name, total_size_bytes, vector_data_bytes, regular_data_bytes, vector_storage_pct, row_count)\nSELECT\n  c.schema,\n  c.table_name,\n  pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass) AS total_size_bytes,\n  (avg_col_size * c.rows) AS vector_data_bytes,\n  pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass) - (avg_col_size * c.rows) AS regular_data_bytes,\n  CASE WHEN pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass) > 0\n       THEN ((avg_col_size * c.rows)::NUMERIC / pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass)::NUMERIC) * 100\n       ELSE 0\n  END AS vector_storage_pct,\n  c.rows\nFROM (\n  SELECT\n    schema,\n    table_name,\n    rows,\n    SUM(AVG(pg_column_size(col_val::vector))) OVER (PARTITION BY schema, table_name) AS avg_col_size\n  FROM (\n    SELECT\n      schema,\n      table_name,\n      rows,\n      column_name,\n      (SELECT avg(pg_column_size((format('\"%I\".\"%I\"', table_name, column_name))::text::vector)) FROM format('%I.%I', schema, table_name)::regclass) AS col_val\n    FROM vector_analysis_columns\n  ) AS sub\n) AS c\nLIMIT 100;"}
| execute_sql {"sql": "-- Simplified approach: calculate average vector column size per row per table using sample, then estimate total vector data size\nDROP TABLE IF EXISTS vector_analysis_storage_consumption;\nCREATE TABLE vector_analysis_storage_consumption (\n    schema VARCHAR(50),\n    table_name VARCHAR(100),\n    total_size_bytes BIGINT,\n    vector_data_bytes BIGINT,\n    regular_data_bytes BIGINT,\n    vector_storage_pct NUMERIC(5,2),\n    row_count BIGINT\n);\n\nINSERT INTO vector_analysis_storage_consumption (schema, table_name, total_size_bytes, vector_data_bytes, regular_data_bytes, vector_storage_pct, row_count)\nSELECT\n  c.schema,\n  c.table_name,\n  pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass) AS total_size_bytes,\n  (c.avg_vector_col_size * c.rows) AS vector_data_bytes,\n  pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass) - (c.avg_vector_col_size * c.rows) AS regular_data_bytes,\n  CASE WHEN pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass) > 0\n       THEN ((c.avg_vector_col_size * c.rows)::NUMERIC / pg_total_relation_size(format('%I.%I', c.schema, c.table_name)::regclass)::NUMERIC) * 100\n       ELSE 0\n  END AS vector_storage_pct,\n  c.rows\nFROM (\n  SELECT\n    vc.schema,\n    vc.table_name,\n    vc.rows,\n    AVG(pg_column_size(vc.example_column::vector)) AS avg_vector_col_size\n  FROM (\n    SELECT\n      schema,\n      table_name,\n      rows,\n      column_name AS example_column\n    FROM vector_analysis_columns\n  ) AS vc\n  GROUP BY vc.schema, vc.table_name, vc.rows\n) AS c;"}
| execute_sql {"sql": "-- Refine approach to getting average size of vector column: sample with a query per each vector column, then join results\n-- Use PL/pgSQL block\nDO $$\nDECLARE\n  rec RECORD;\n  v_avg_size FLOAT;\n  v_total_size BIGINT;\n  v_rows BIGINT;\nBEGIN\n  DROP TABLE IF EXISTS vector_analysis_storage_consumption;\n  CREATE TABLE vector_analysis_storage_consumption (\n    schema VARCHAR(50),\n    table_name VARCHAR(100),\n    total_size_bytes BIGINT,\n    vector_data_bytes BIGINT,\n    regular_data_bytes BIGINT,\n    vector_storage_pct NUMERIC(5,2),\n    row_count BIGINT\n  );\n\n  FOR rec IN\n    SELECT schema, table_name, column_name, rows\n      FROM vector_analysis_columns\n      ORDER BY schema, table_name\n  LOOP\n    EXECUTE FORMAT('SELECT AVG(pg_column_size(%I)) FROM %I.%I', rec.column_name, rec.schema, rec.table_name) INTO v_avg_size;\n    IF v_avg_size IS NULL THEN\n      v_avg_size := 0;\n    END IF;\n\n    v_total_size := ceil(v_avg_size * rec.rows);\n\n    EXECUTE FORMAT('SELECT pg_total_relation_size(%L::regclass)', rec.schema || '.' || rec.table_name) INTO v_rows;\n\n    INSERT INTO vector_analysis_storage_consumption VALUES (\n      rec.schema, rec.table_name,\n      (SELECT pg_total_relation_size(format('%I.%I', rec.schema, rec.table_name)::regclass),\n      v_total_size,\n      (SELECT pg_total_relation_size(format('%I.%I', rec.schema, rec.table_name)::regclass) - v_total_size),\n      CASE WHEN (SELECT pg_total_relation_size(format('%I.%I', rec.schema, rec.table_name)::regclass) > 0) THEN\n        (v_total_size::NUMERIC / (SELECT pg_total_relation_size(format('%I.%I', rec.schema, rec.table_name)::regclass))) * 100\n      ELSE 0 END,\n      rec.rows\n    );\n  END LOOP;\nEND $$;"}
