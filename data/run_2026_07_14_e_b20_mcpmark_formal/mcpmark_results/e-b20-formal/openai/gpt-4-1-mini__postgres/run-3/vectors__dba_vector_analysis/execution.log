| execute_sql {"sql": "-- Identify all vector columns across entire database with their dimensions and data types\nSELECT\n  n.nspname AS schema,\n  c.relname AS table_name,\n  a.attname AS column_name,\n  pg_catalog.vector_dimensions(a.atttypid) AS dimensions,\n  t.typname AS data_type,\n  (EXISTS (\n    SELECT 1\n    FROM pg_constraint con\n    WHERE con.conrelid = c.oid\n      AND a.attnum = ANY(con.conkey)\n      AND con.contype IN ('n', 'c', 'f')\n  )) AS has_constraints\nFROM pg_attribute a\nJOIN pg_class c ON a.attrelid = c.oid\nJOIN pg_namespace n ON c.relnamespace = n.oid\nJOIN pg_type t ON a.atttypid = t.oid\nWHERE t.typname = 'vector'\n  AND a.attnum > 0\n  AND NOT a.attisdropped\nORDER BY n.nspname, c.relname, a.attname;"}
| execute_sql {"sql": "-- Alternative: get dimensions using vector_length(column) on a sample row for each vector column\nWITH vector_columns AS (\n  SELECT\n    n.nspname AS schema,\n    c.relname AS table_name,\n    a.attname AS column_name\n  FROM pg_attribute a\n  JOIN pg_class c ON a.attrelid = c.oid\n  JOIN pg_namespace n ON c.relnamespace = n.oid\n  JOIN pg_type t ON a.atttypid = t.oid\n  WHERE t.typname = 'vector'\n    AND a.attnum > 0\n    AND NOT a.attisdropped\n)\nSELECT\n  vc.schema,\n  vc.table_name,\n  vc.column_name,\n  pg_type.typname AS data_type,\n  (SELECT COUNT(*) FROM pg_catalog.pg_constraint con WHERE con.conrelid = (SELECT oid FROM pg_class WHERE relname = vc.table_name AND relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = vc.schema)) AND vc.column_name = ANY( (SELECT array_agg(att.attname) FROM pg_attribute att WHERE att.attrelid = (SELECT oid FROM pg_class WHERE relname = vc.table_name AND relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = vc.schema)) AND att.attnum > 0) ) ) > 0 AS has_constraints,\n  (SELECT COUNT(*) FROM ONLY public.\"\" || vc.table_name) AS rows,\n  (SELECT vector_length((vc.column_name)::vector) FROM ONLY vc.schema || '.' || vc.table_name LIMIT 1) AS dimensions\nFROM vector_columns vc\nJOIN pg_type ON pg_type.typname = 'vector'\nLIMIT 10;"}
| execute_sql {"sql": "-- Correct query to dynamically get vector columns and their dimensions in a safer manner\nDO $$\nDECLARE\n  rec RECORD;\n  v_dim INT;\n  v_rows BIGINT;\nBEGIN\n  DROP TABLE IF EXISTS vector_analysis_columns;\n  CREATE TABLE vector_analysis_columns (\n      schema VARCHAR(50),\n      table_name VARCHAR(100),\n      column_name VARCHAR(100),\n      dimensions INTEGER,\n      data_type VARCHAR(50),\n      has_constraints BOOLEAN,\n      rows BIGINT\n  );\n\n  FOR rec IN\n    SELECT\n      n.nspname AS schema,\n      c.relname AS table_name,\n      a.attname AS column_name,\n      t.typname AS data_type,\n      (EXISTS (\n        SELECT 1\n        FROM pg_constraint con\n        WHERE con.conrelid = c.oid\n          AND a.attnum = ANY(con.conkey)\n          AND con.contype IN ('n', 'c', 'f')\n      )) AS has_constraints\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    JOIN pg_type t ON a.atttypid = t.oid\n    WHERE t.typname = 'vector'\n      AND a.attnum > 0\n      AND NOT a.attisdropped\n  LOOP\n    EXECUTE FORMAT('SELECT COUNT(*) FROM %I.%I', rec.schema, rec.table_name) INTO v_rows;\n    EXECUTE FORMAT('SELECT vector_length(%I) FROM %I.%I LIMIT 1', rec.column_name, rec.schema, rec.table_name) INTO v_dim;\n    INSERT INTO vector_analysis_columns VALUES (rec.schema, rec.table_name, rec.column_name, v_dim, rec.data_type, rec.has_constraints, v_rows);\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- No direct function vector_length, use array_length on vector column cast to float4[] to get dimensions\nDO $$\nDECLARE\n  rec RECORD;\n  v_dim INT;\n  v_rows BIGINT;\nBEGIN\n  DROP TABLE IF EXISTS vector_analysis_columns;\n  CREATE TABLE vector_analysis_columns (\n      schema VARCHAR(50),\n      table_name VARCHAR(100),\n      column_name VARCHAR(100),\n      dimensions INTEGER,\n      data_type VARCHAR(50),\n      has_constraints BOOLEAN,\n      rows BIGINT\n  );\n\n  FOR rec IN\n    SELECT\n      n.nspname AS schema,\n      c.relname AS table_name,\n      a.attname AS column_name,\n      t.typname AS data_type,\n      (EXISTS (\n        SELECT 1\n        FROM pg_constraint con\n        WHERE con.conrelid = c.oid\n          AND a.attnum = ANY(con.conkey)\n          AND con.contype IN ('n', 'c', 'f')\n      )) AS has_constraints\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    JOIN pg_type t ON a.atttypid = t.oid\n    WHERE t.typname = 'vector'\n      AND a.attnum > 0\n      AND NOT a.attisdropped\n  LOOP\n    EXECUTE FORMAT('SELECT COUNT(*) FROM %I.%I', rec.schema, rec.table_name) INTO v_rows;\n    EXECUTE FORMAT('SELECT array_length(%I::float4[], 1) FROM %I.%I LIMIT 1', rec.column_name, rec.schema, rec.table_name) INTO v_dim;\n    INSERT INTO vector_analysis_columns VALUES (rec.schema, rec.table_name, rec.column_name, v_dim, rec.data_type, rec.has_constraints, v_rows);\n  END LOOP;\nEND $$;"}
| execute_sql {"sql": "-- Fix issue: use pg_class info to distinguish table vs index for counting rows\nDO $$\nDECLARE\n  rec RECORD;\n  v_dim INT;\n  v_rows BIGINT;\nBEGIN\n  DROP TABLE IF EXISTS vector_analysis_columns;\n  CREATE TABLE vector_analysis_columns (\n      schema VARCHAR(50),\n      table_name VARCHAR(100),\n      column_name VARCHAR(100),\n      dimensions INTEGER,\n      data_type VARCHAR(50),\n      has_constraints BOOLEAN,\n      rows BIGINT\n  );\n\n  FOR rec IN\n    SELECT\n      n.nspname AS schema,\n      c.relname AS table_name,\n      a.attname AS column_name,\n      t.typname AS data_type,\n      (EXISTS (\n        SELECT 1\n        FROM pg_constraint con\n        WHERE con.conrelid = c.oid\n          AND a.attnum = ANY(con.conkey)\n          AND con.contype IN ('n', 'c', 'f')\n      )) AS has_constraints\n    FROM pg_attribute a\n    JOIN pg_class c ON a.attrelid = c.oid\n    JOIN pg_namespace n ON c.relnamespace = n.oid\n    JOIN pg_type t ON a.atttypid = t.oid\n    WHERE t.typname = 'vector'\n      AND a.attnum > 0\n      AND NOT a.attisdropped\n      AND c.relkind = 'r' -- only tables\n  LOOP\n    EXECUTE FORMAT('SELECT COUNT(*) FROM %I.%I', rec.schema, rec.table_name) INTO v_rows;\n    EXECUTE FORMAT('SELECT array_length(%I::float4[], 1) FROM %I.%I LIMIT 1', rec.column_name, rec.schema, rec.table_name) INTO v_dim;\n    INSERT INTO vector_analysis_columns VALUES (rec.schema, rec.table_name, rec.column_name, v_dim, rec.data_type, rec.has_constraints, v_rows);\n  END LOOP;\nEND $$;"}
