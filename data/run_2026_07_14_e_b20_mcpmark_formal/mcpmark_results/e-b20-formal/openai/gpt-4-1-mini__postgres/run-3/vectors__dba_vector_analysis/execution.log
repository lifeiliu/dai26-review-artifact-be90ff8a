| execute_sql {"sql": "DO $$\nDECLARE\n  rec RECORD;\n  v_avg_size FLOAT;\n  v_total_size BIGINT;\n  v_rows BIGINT;\n  v_total_table_size BIGINT;\nBEGIN\n  DROP TABLE IF EXISTS vector_analysis_storage_consumption;\n  CREATE TABLE vector_analysis_storage_consumption (\n    schema VARCHAR(50),\n    table_name VARCHAR(100),\n    total_size_bytes BIGINT,\n    vector_data_bytes BIGINT,\n    regular_data_bytes BIGINT,\n    vector_storage_pct NUMERIC(5,2),\n    row_count BIGINT\n  );\n\n  FOR rec IN\n    SELECT schema, table_name, column_name, rows\n    FROM vector_analysis_columns\n    ORDER BY schema, table_name\n  LOOP\n    EXECUTE FORMAT('SELECT AVG(pg_column_size(%I)) FROM %I.%I', rec.column_name, rec.schema, rec.table_name) INTO v_avg_size;\n    IF v_avg_size IS NULL THEN\n      v_avg_size := 0;\n    END IF;\n\n    v_total_size := CEIL(v_avg_size * rec.rows);\n\n    EXECUTE FORMAT('SELECT pg_total_relation_size(%L::regclass)', rec.schema || '.' || rec.table_name) INTO v_total_table_size;\n\n    INSERT INTO vector_analysis_storage_consumption VALUES (\n      rec.schema, rec.table_name,\n      v_total_table_size,\n      v_total_size,\n      v_total_table_size - v_total_size,\n      CASE\n        WHEN v_total_table_size > 0 THEN (v_total_size::NUMERIC / v_total_table_size) * 100\n        ELSE 0\n      END,\n      rec.rows\n   );\n  END LOOP;\nEND $$;"}
