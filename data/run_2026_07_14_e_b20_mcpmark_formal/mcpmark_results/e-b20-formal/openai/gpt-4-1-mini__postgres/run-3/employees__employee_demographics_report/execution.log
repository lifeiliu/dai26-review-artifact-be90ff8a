| execute_sql {"sql": "CREATE TABLE employees.age_group_analysis (\n  age_group VARCHAR(7) PRIMARY KEY,\n  employee_count INTEGER,\n  avg_salary DECIMAL(10,2),\n  avg_tenure_days DECIMAL(10,2)\n);"}
| execute_sql {"sql": "CREATE TABLE employees.birth_month_distribution (\n  birth_month INTEGER PRIMARY KEY,\n  month_name VARCHAR(9),\n  employee_count INTEGER,\n  current_employee_count INTEGER\n);"}
| execute_sql {"sql": "CREATE TABLE employees.hiring_year_summary (\n  hire_year INTEGER PRIMARY KEY,\n  employees_hired INTEGER,\n  still_employed INTEGER,\n  retention_rate DECIMAL(5,2)\n);"}
| execute_sql {"sql": "WITH current_employees AS (\n  SELECT emp.emp_no, emp.gender\n  FROM employees.employee emp\n  JOIN employees.salary sal ON emp.emp_no = sal.emp_no\n  WHERE sal.to_date = '9999-01-01'\n  GROUP BY emp.emp_no, emp.gender\n),\nworkforce_size AS (\n  SELECT COUNT(*) AS total FROM current_employees\n)\nINSERT INTO employees.gender_statistics (gender, total_employees, current_employees, percentage_of_workforce)\nSELECT\n  gender,\n  (SELECT COUNT(*) FROM employees.employee WHERE gender = ce.gender) AS total_employees,\n  COUNT(ce.emp_no) AS current_employees,\n  (COUNT(ce.emp_no) * 100.0 / (SELECT total FROM workforce_size))::DECIMAL(5,2) AS percentage_of_workforce\nFROM current_employees ce\nGROUP BY gender;\n"}
| execute_sql {"sql": "SELECT column_name FROM information_schema.columns WHERE table_schema = 'employees' AND table_name = 'employee';"}
| execute_sql {"sql": "SELECT column_name FROM information_schema.columns WHERE table_schema = 'employees' AND table_name = 'salary';"}
| execute_sql {"sql": "WITH current_employees AS (\n  SELECT emp.id, emp.gender\n  FROM employees.employee emp\n  JOIN employees.salary sal ON emp.id = sal.employee_id\n  WHERE sal.to_date = '9999-01-01'\n  GROUP BY emp.id, emp.gender\n),\nworkforce_size AS (\n  SELECT COUNT(*) AS total FROM current_employees\n)\nINSERT INTO employees.gender_statistics (gender, total_employees, current_employees, percentage_of_workforce)\nSELECT\n  gender,\n  (SELECT COUNT(*) FROM employees.employee WHERE gender = ce.gender) AS total_employees,\n  COUNT(ce.id) AS current_employees,\n  (COUNT(ce.id) * 100.0 / (SELECT total FROM workforce_size))::DECIMAL(5,2) AS percentage_of_workforce\nFROM current_employees ce\nGROUP BY gender;"}
| execute_sql {"sql": "WITH current_employees AS (\n  SELECT emp.id, emp.birth_date, emp.hire_date, sal.amount\n  FROM employees.employee emp\n  JOIN employees.salary sal ON emp.id = sal.employee_id\n  WHERE sal.to_date = '9999-01-01'\n),\nage_groups AS (\n  SELECT\n    CASE\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 20 AND 29 THEN '20-29'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 30 AND 39 THEN '30-39'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 40 AND 49 THEN '40-49'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 50 AND 59 THEN '50-59'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) >= 60 THEN '60+'\n      ELSE NULL\n    END AS age_group,\n    emp.id,\n    sal.amount,\n    emp.hire_date\n  FROM current_employees emp\n),\naggr AS (\n  SELECT\n    age_group,\n    COUNT(id) AS employee_count,\n    AVG(amount) AS avg_salary,\n    AVG(('2002-08-01'::date - hire_date)) AS avg_tenure_days\n  FROM age_groups\n  WHERE age_group IS NOT NULL\n  GROUP BY age_group\n)\nINSERT INTO employees.age_group_analysis (age_group, employee_count, avg_salary, avg_tenure_days)\nSELECT age_group, employee_count, avg_salary, avg_tenure_days FROM aggr\n;"}
| execute_sql {"sql": "WITH current_employees AS (\n  SELECT emp.id AS emp_id, emp.birth_date, emp.hire_date, sal.amount\n  FROM employees.employee emp\n  JOIN employees.salary sal ON emp.id = sal.employee_id\n  WHERE sal.to_date = '9999-01-01'\n),\nage_groups AS (\n  SELECT\n    CASE\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 20 AND 29 THEN '20-29'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 30 AND 39 THEN '30-39'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 40 AND 49 THEN '40-49'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) BETWEEN 50 AND 59 THEN '50-59'\n      WHEN date_part('year', age('2002-08-01'::date, birth_date)) >= 60 THEN '60+'\n      ELSE NULL\n    END AS age_group,\n    emp_id,\n    amount,\n    hire_date\n  FROM current_employees\n),\naggr AS (\n  SELECT\n    age_group,\n    COUNT(emp_id) AS employee_count,\n    AVG(amount) AS avg_salary,\n    AVG(('2002-08-01'::date - hire_date)) AS avg_tenure_days\n  FROM age_groups\n  WHERE age_group IS NOT NULL\n  GROUP BY age_group\n)\nINSERT INTO employees.age_group_analysis (age_group, employee_count, avg_salary, avg_tenure_days)\nSELECT age_group, employee_count, avg_salary, avg_tenure_days FROM aggr\n;"}
| execute_sql {"sql": "WITH month_names AS (\n  SELECT generate_series(1, 12) AS month_num,\n         to_char(to_date(generate_series(1, 12)::text, 'MM'), 'Month') AS month_name\n),\nemployees_by_month AS (\n  SELECT EXTRACT(MONTH FROM birth_date) AS birth_month, COUNT(*) AS employee_count\n  FROM employees.employee\n  GROUP BY birth_month\n),\ncurrent_employees_by_month AS (\n  SELECT EXTRACT(MONTH FROM e.birth_date) AS birth_month, COUNT(*) AS current_employee_count\n  FROM employees.employee e\n  JOIN employees.salary s ON e.id = s.employee_id\n  WHERE s.to_date = '9999-01-01'\n  GROUP BY birth_month\n)\nINSERT INTO employees.birth_month_distribution (birth_month, month_name, employee_count, current_employee_count)\nSELECT mn.month_num, TRIM(mn.month_name), COALESCE(ebm.employee_count, 0), COALESCE(cebm.current_employee_count, 0)\nFROM month_names mn\nLEFT JOIN employees_by_month ebm ON mn.month_num = ebm.birth_month\nLEFT JOIN current_employees_by_month cebm ON mn.month_num = cebm.birth_month\nORDER BY mn.month_num;"}
| execute_sql {"sql": "WITH hires AS (\n  SELECT hire_date, id,\n    CASE WHEN EXISTS (\n      SELECT 1 FROM employees.salary s WHERE s.employee_id = e.id AND s.to_date = '9999-01-01'\n    ) THEN 1 ELSE 0 END AS still_employed\n  FROM employees.employee e\n),\nhire_years AS (\n  SELECT EXTRACT(YEAR FROM hire_date) AS hire_year,\n         COUNT(*) AS employees_hired,\n         SUM(still_employed) AS still_employed\n  FROM hires\n  GROUP BY hire_year\n)\nINSERT INTO employees.hiring_year_summary (hire_year, employees_hired, still_employed, retention_rate)\nSELECT hire_year, employees_hired, still_employed,\n       (still_employed * 100.0 / employees_hired)::DECIMAL(5,2) AS retention_rate\nFROM hire_years\nORDER BY hire_year;"}
The requested tables for employee demographics and basic statistics have been created in the employees schema: 

- gender_statistics
- age_group_analysis
- birth_month_distribution
- hiring_year_summary

Data has been populated as follows:
- Gender statistics capture total and current employees by gender plus percentage of workforce.
- Age group analysis categorizes current employees by defined age buckets with average salary and tenure.
- Birth month distribution counts total and current employees born in each month.
- Hiring year summary shows hires by year, how many still employed, and retention rate.

You can now use these tables for the annual company overview and diversity initiatives reporting. If you need any specific queries or reports based on this data, please let me know!
