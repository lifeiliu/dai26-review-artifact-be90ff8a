| execute_sql {"sql": "-- Step 2: Insert historical player statistics into player_evaluation\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n  bo.person_id,\n  CASE WHEN SUM(bo.at_bats) = 0 THEN 0 ELSE SUM(bo.hits)::decimal / SUM(bo.at_bats) END AS batting_avg,\n  COALESCE(SUM(bo.home_runs), 0) AS home_runs,\n  COALESCE(SUM(bo.rbi), 0) AS rbis,\n  COALESCE(COUNT(DISTINCT pem.event_id), 0) AS games_played,\n  (CASE WHEN SUM(bo.at_bats) = 0 THEN 0 ELSE SUM(bo.hits)::decimal / SUM(bo.at_bats) END) * 1000 + (COALESCE(SUM(bo.home_runs), 0) * 5) + (COALESCE(SUM(bo.rbi), 0) * 2) AS performance_score,\n  DATE '2024-01-01' AS evaluation_date\nFROM baseball_offensive_stats bo\nLEFT JOIN person_event_metadata pem ON bo.person_id = pem.person_id\nGROUP BY bo.person_id\nHAVING COALESCE(COUNT(DISTINCT pem.event_id), 0) >= 10;"}
