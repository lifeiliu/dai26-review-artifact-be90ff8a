| execute_sql {"sql": "-- Aggregate player statistics for player_evaluation insertion\nINSERT INTO player_evaluation (person_id, batting_avg, home_runs, rbis, games_played, performance_score, evaluation_date)\nSELECT\n  pem.person_id,\n  CASE WHEN SUM(bo.at_bats) = 0 THEN 0 ELSE SUM(bo.hits)::DECIMAL / SUM(bo.at_bats) END AS batting_avg,\n  COALESCE(SUM(bo.home_runs), 0) AS home_runs,\n  COALESCE(SUM(bo.rbi), 0) AS rbis,\n  COUNT(DISTINCT pem.event_id) AS games_played,\n  (CASE WHEN SUM(bo.at_bats) = 0 THEN 0 ELSE SUM(bo.hits)::DECIMAL / SUM(bo.at_bats) END) * 1000 + COALESCE(SUM(bo.home_runs), 0) * 5 + COALESCE(SUM(bo.rbi), 0) * 2 AS performance_score,\n  DATE '2024-01-01' AS evaluation_date\nFROM person_event_metadata pem\nJOIN baseball_offensive_stats bo ON pem.event_id = bo.id\nGROUP BY pem.person_id\nHAVING COUNT(DISTINCT pem.event_id) >= 10;"}
| execute_sql {"sql": "-- Step 3: Create player_injury_status table\nCREATE TABLE player_injury_status (\n  status_id SERIAL PRIMARY KEY,\n  person_id INTEGER UNIQUE NOT NULL,\n  injury_count INTEGER DEFAULT 0,\n  last_injury_date DATE,\n  current_status VARCHAR CHECK (current_status IN ('healthy', 'injured', 'recovering'))\n);"}
| execute_sql {"sql": "-- Insert data into player_injury_status based on player_evaluation and injury_phases\nINSERT INTO player_injury_status (person_id, injury_count, last_injury_date, current_status)\nSELECT \n  pe.person_id,\n  COALESCE(COUNT(ip.id), 0) AS injury_count,\n  MAX(ip.start_date_time)::DATE AS last_injury_date,\n  CASE \n    WHEN MAX(ip.end_date_time) IS NULL AND MAX(ip.start_date_time) IS NOT NULL THEN 'injured'\n    ELSE 'healthy'\n  END AS current_status\nFROM player_evaluation pe\nLEFT JOIN injury_phases ip ON ip.person_id = pe.person_id\nGROUP BY pe.person_id;"}
| execute_sql {"sql": "-- Step 4: Update player_evaluation performance_score based on player_injury_status\nUPDATE player_evaluation pe\nSET performance_score = GREATEST(\n  pe.performance_score * \n  CASE \n    WHEN pis.current_status = 'injured' THEN 0.8\n    WHEN pis.injury_count > 2 THEN 0.9\n    ELSE 1.0\n  END, 0)\nFROM player_injury_status pis\nWHERE pe.person_id = pis.person_id;"}
| execute_sql {"sql": "-- Step 5: Create team_performance_summary table\nCREATE TABLE team_performance_summary (\n  summary_id SERIAL PRIMARY KEY,\n  metric_name VARCHAR UNIQUE,\n  metric_value DECIMAL\n);"}
| execute_sql {"sql": "-- Insert summary metrics into team_performance_summary\nINSERT INTO team_performance_summary (metric_name, metric_value)\nVALUES\n  ('total_players', (SELECT COUNT(*) FROM player_evaluation)),\n  ('avg_batting_average', (SELECT AVG(COALESCE(batting_avg, 0)) FROM player_evaluation)),\n  ('total_home_runs', (SELECT SUM(COALESCE(home_runs, 0)) FROM player_evaluation)),\n  ('avg_performance_score', (SELECT AVG(COALESCE(performance_score, 0)) FROM player_evaluation)),\n  ('injured_player_count', (SELECT COUNT(*) FROM player_injury_status WHERE current_status = 'injured')),\n  ('healthy_player_count', (SELECT COUNT(*) FROM player_injury_status WHERE current_status = 'healthy'));"}
