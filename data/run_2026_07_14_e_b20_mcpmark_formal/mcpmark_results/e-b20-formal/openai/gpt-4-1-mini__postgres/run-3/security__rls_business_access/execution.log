| execute_sql {"sql": "-- Enable RLS on all five tables\nALTER TABLE public.users ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.channels ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.posts ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.comments ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.channel_moderators ENABLE ROW LEVEL SECURITY;"}
| execute_sql {"sql": "-- Policies for Users Table\n-- SELECT: Users can read all public user profiles (username, created_at)\nCREATE POLICY select_public_profiles ON public.users\nFOR SELECT\nUSING (true);\n\n-- UPDATE: Users can only modify their own profile\nCREATE POLICY update_own_profile ON public.users\nFOR UPDATE\nUSING (id = app_current_user_id());\n\n-- DELETE: Users can only delete their own account\nCREATE POLICY delete_own_account ON public.users\nFOR DELETE\nUSING (id = app_current_user_id());"}
| execute_sql {"sql": "-- Policies for Channels Table\n-- SELECT: Everyone can read public channel information\nCREATE POLICY select_public_channels ON public.channels\nFOR SELECT\nUSING (true);\n\n-- INSERT: Any authenticated user can create a channel (becomes owner)\nCREATE POLICY insert_channel_authenticated ON public.channels\nFOR INSERT\nWITH CHECK (app_current_user_id() IS NOT NULL);\n\n-- UPDATE: Only channel owners can modify channel details\nCREATE POLICY update_channel_owner ON public.channels\nFOR UPDATE\nUSING (is_channel_owner(id, app_current_user_id()));\n\n-- DELETE: Only channel owners can delete channels\nCREATE POLICY delete_channel_owner ON public.channels\nFOR DELETE\nUSING (is_channel_owner(id, app_current_user_id()));"}
| execute_sql {"sql": "-- Policies for Posts Table\n-- SELECT: Users can read all posts in channels they have access to\nCREATE POLICY select_posts_accessible_channels ON public.posts\nFOR SELECT\nUSING (EXISTS (SELECT 1 FROM public.channels c WHERE c.id = channel_id AND (is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()) OR c.is_public = true)));\n\n-- INSERT: Authenticated users can create posts in any channel\nCREATE POLICY insert_posts_authenticated ON public.posts\nFOR INSERT\nWITH CHECK (app_current_user_id() IS NOT NULL);\n\n-- UPDATE: Post authors OR channel moderators OR channel owners can edit posts\nCREATE POLICY update_posts_author_or_mod_or_owner ON public.posts\nFOR UPDATE\nUSING (author_id = app_current_user_id() OR can_moderate_channel(channel_id, app_current_user_id()));\n\n-- DELETE: Post authors OR channel moderators OR channel owners can delete posts\nCREATE POLICY delete_posts_author_or_mod_or_owner ON public.posts\nFOR DELETE\nUSING (author_id = app_current_user_id() OR can_moderate_channel(channel_id, app_current_user_id()));"}
| execute_sql {"sql": "-- Policies for Comments Table\n-- SELECT: Users can read comments on posts they can access\nCREATE POLICY select_comments_accessible_posts ON public.comments\nFOR SELECT\nUSING (EXISTS (\n  SELECT 1 FROM public.posts p\n  WHERE p.id = post_id\n  AND EXISTS (\n    SELECT 1 FROM public.channels c\n    WHERE c.id = p.channel_id\n    AND (is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()) OR c.is_public = true)\n  )\n));\n\n-- INSERT: Authenticated users can comment on posts they can see\nCREATE POLICY insert_comments_authenticated ON public.comments\nFOR INSERT\nWITH CHECK (\n  app_current_user_id() IS NOT NULL\n  AND EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = post_id\n    AND EXISTS (\n      SELECT 1 FROM public.channels c\n      WHERE c.id = p.channel_id\n      AND (is_channel_owner(c.id, app_current_user_id()) OR is_channel_moderator(c.id, app_current_user_id()) OR c.is_public = true)\n    )\n  )\n);\n\n-- UPDATE: Comment authors OR post authors OR channel moderators OR channel owners can edit comments\nCREATE POLICY update_comments_auth_mod_owners ON public.comments\nFOR UPDATE\nUSING (\n  author_id = app_current_user_id()\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = post_id\n    AND p.author_id = app_current_user_id()\n  )\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON c.id = p.channel_id\n    WHERE p.id = post_id\n    AND can_moderate_channel(c.id, app_current_user_id())\n  )\n);\n\n-- DELETE: Comment authors OR post authors OR channel moderators OR channel owners can delete comments\nCREATE POLICY delete_comments_auth_mod_owners ON public.comments\nFOR DELETE\nUSING (\n  author_id = app_current_user_id()\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    WHERE p.id = post_id\n    AND p.author_id = app_current_user_id()\n  )\n  OR EXISTS (\n    SELECT 1 FROM public.posts p\n    JOIN public.channels c ON c.id = p.channel_id\n    WHERE p.id = post_id\n    AND can_moderate_channel(c.id, app_current_user_id())\n  )\n);"}
| execute_sql {"sql": "-- Policies for Channel Moderators Table\n-- SELECT: Users can see moderator lists for channels\nCREATE POLICY select_channel_moderators ON public.channel_moderators\nFOR SELECT\nUSING (true);\n\n-- INSERT: Only channel owners can add moderators\nCREATE POLICY insert_channel_moderators_owner_only ON public.channel_moderators\nFOR INSERT\nWITH CHECK (is_channel_owner(channel_id, app_current_user_id()));\n\n-- DELETE: Channel owners can remove moderators; moderators can remove themselves\nCREATE POLICY delete_channel_moderators_owner_or_self ON public.channel_moderators\nFOR DELETE\nUSING (is_channel_owner(channel_id, app_current_user_id()) OR moderator_id = app_current_user_id());"}
| execute_sql {"sql": "-- Check the columns of the channel_moderators table to find the correct column name for the moderator user ID\nSELECT column_name FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'channel_moderators';"}
| execute_sql {"sql": "-- Fix the delete policy using correct column name 'user_id' for the moderator in channel_moderators\nDROP POLICY IF EXISTS delete_channel_moderators_owner_or_self ON public.channel_moderators;\nCREATE POLICY delete_channel_moderators_owner_or_self ON public.channel_moderators\nFOR DELETE\nUSING (is_channel_owner(channel_id, app_current_user_id()) OR user_id = app_current_user_id());"}
All requested Row Level Security (RLS) policies have been enabled and created for the Users, Channels, Posts, Comments, and Channel Moderators tables according to the specified requirements:

- Users table: RLS enabled; policies allow users to select public profiles, update/delete their own accounts.
- Channels table: RLS enabled; policies allow everyone to select channels, authenticated users to insert, and only channel owners to update/delete channels.
- Posts table: RLS enabled; users can select posts in accessible channels, insert posts if authenticated, update/delete if author or channel moderator/owner.
- Comments table: RLS enabled; users can select comments on accessible posts, insert if authenticated and post accessible; update/delete allowed for comment authors, post authors, or channel moderators/owners.
- Channel Moderators table: RLS enabled; policies allow everyone to select, only channel owners to insert moderators, and owners or moderators themselves to delete.

The policies use the predefined helper functions for current user ID, channel ownership, moderation, and moderation capability.

