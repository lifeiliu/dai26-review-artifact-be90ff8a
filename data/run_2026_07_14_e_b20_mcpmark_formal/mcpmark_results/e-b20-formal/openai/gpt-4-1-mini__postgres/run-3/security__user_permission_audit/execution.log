pment Team', 'user_profiles', 'SELECT'),\n        ('Development Team', 'product_catalog', 'SELECT'),\n        ('Backup Service', 'user_profiles', 'SELECT'),\n        ('Backup Service', 'product_catalog', 'SELECT'),\n        ('Backup Service', 'order_management', 'SELECT'),\n        ('Backup Service', 'financial_transactions', 'SELECT'),\n        ('Backup Service', 'user_stat_analysis', 'SELECT'),\n        ('Backup Service', 'audit_logs', 'SELECT'),\n        ('Backup Service', 'user_credentials', 'SELECT')\n    ) AS t(role_name, table_name, permission_type)\n),\n\nuser_permissions AS (\n    SELECT grantee AS username, table_name, privilege_type AS permission_type\n    FROM information_schema.table_privileges\n    WHERE table_schema = 'public'\n),\n\nuser_role_mapping AS (\n    SELECT ur.username, ur.role_name\n    FROM user_roles ur\n),\n\n-- Dangling Users: Have privileges on business tables but not in USER_ROLE\ndangling_users AS (\n    SELECT DISTINCT up.username\n    FROM user_permissions up\n    WHERE up.username NOT IN (SELECT username FROM user_roles) AND up.username NOT IN ('postgres', 'pg_read_all_data', 'pg_write_all_data', 'pg_monitor', 'pg_read_all_settings', 'pg_read_all_stats', 'pg_stat_scan_tables', 'pg_read_server_files', 'pg_write_server_files', 'pg_execute_server_program', 'pg_signal_backend', 'pg_checkpoint', 'pg_maintain', 'pg_use_reserved_connections', 'pg_create_subscription')\n),\n\n-- All grants for dangling users\ndangling_user_grants AS (\n    SELECT up.username, up.table_name, up.permission_type\n    FROM user_permissions up\n    WHERE up.username IN (SELECT username FROM dangling_users)\n),\n\n-- Missing Permissions: Expected but not granted\nmissing_permissions AS (\n    SELECT ur.username, ep.table_name, ep.permission_type\n    FROM user_role_mapping ur\n    JOIN expected_permissions ep ON ur.role_name = ep.role_name\n    LEFT JOIN user_permissions up ON up.username = ur.username AND up.table_name = ep.table_name AND up.permission_type = ep.permission_type\n    WHERE up.username IS NULL\n),\n\n-- Excessive Permissions: Granted but not expected\nexcessive_permissions AS (\n    SELECT up.username, up.table_name, up.permission_type\n    FROM user_permissions up\n    LEFT JOIN user_role_mapping ur ON up.username = ur.username\n    LEFT JOIN expected_permissions ep ON ur.role_name = ep.role_name AND up.table_name = ep.table_name AND up.permission_type = ep.permission_type\n    WHERE ep.role_name IS NULL OR ep.role_name IS NOT NULL AND ep.table_name IS NULL  -- includes dangling user grants (no role)\n    OR ep.permission_type IS NULL\n),\n\nexcessive_permissions_filtered AS (\n    -- Remove dangling users already captured separately, but keep their grants as excessive\n    SELECT ep.* FROM excessive_permissions ep\n    WHERE ep.username NOT IN (SELECT username FROM dangling_users)\n    UNION ALL\n    SELECT dug.username, dug.table_name, dug.permission_type FROM dangling_user_grants dug\n)\n\n-- Insert audit details\nINSERT INTO security_audit_details (username, issue_type, table_name, permission_type, expected_access)\nSELECT username, 'DANGLING_USER' AS issue_type, NULL AS table_name, NULL AS permission_type, FALSE AS expected_access\nFROM dangling_users\nON CONFLICT DO NOTHING;\n\n-- Insert missing permissions\nINSERT INTO security_audit_details (username, issue_type, table_name, permission_type, expected_access)\nSELECT username, 'MISSING_PERMISSION' AS issue_type, table_name, permission_type, TRUE AS expected_access\nFROM missing_permissions\nON CONFLICT DO NOTHING;\n\n-- Insert excessive permissions\nINSERT INTO security_audit_details (username, issue_type, table_name, permission_type, expected_access)\nSELECT username, 'EXCESSIVE_PERMISSION' AS issue_type, table_name, permission_type, FALSE AS expected_access\nFROM excessive_permissions_filtered\nON CONFLICT DO NOTHING;\n\n-- Insert summary counts\nINSERT INTO security_audit_results (audit_type, total_issues, users_affected, tables_affected)\nSELECT 'DANGLING_USERS' as audit_type, COUNT(*) as total_issues, COUNT(DISTINCT username) as users_affected, 0 as tables_affected\nFROM dangling_users\nUNION ALL\nSELECT 'MISSING_PERMISSIONS', COUNT(*), COUNT(DISTINCT username), COUNT(DISTINCT table_name)\nFROM missing_permissions\nUNION ALL\nSELECT 'EXCESSIVE_PERMISSIONS', COUNT(*), COUNT(DISTINCT username), COUNT(DISTINCT table_name)\nFROM excessive_permissions_filtered;\n"}
