| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.department_name,\n       COUNT(e.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       m.manager_name\nFROM employees.departments d\nJOIN employees.employees e ON d.department_id = e.department_id\nJOIN employees.salaries s ON e.employee_id = s.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN (\n    SELECT department_id, employee_name AS manager_name\n    FROM employees.employees\n    WHERE is_manager = TRUE\n) m ON d.department_id = m.department_id\nWHERE e.status = 'active'\nGROUP BY d.department_name, m.manager_name;"}
| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n    SELECT EXTRACT(YEAR FROM hire_date)::integer AS hire_year,\n           employee_id,\n           department_id,\n           salary_at_hire\n    FROM employees.employees\n),\nhires_summary AS (\n    SELECT hire_year,\n           COUNT(employee_id) AS employees_hired,\n           AVG(salary_at_hire) AS avg_starting_salary\n    FROM hires\n    GROUP BY hire_year\n),\nhires_retention AS (\n    SELECT h.hire_year,\n           COUNT(CASE WHEN e.status = 'active' THEN 1 END) * 100.0 / COUNT(h.employee_id) AS retention_rate\n    FROM hires h\n    LEFT JOIN employees.employees e ON h.employee_id = e.employee_id\n    GROUP BY h.hire_year\n),\ntop_departments AS (\n    SELECT hire_year, department_name AS top_hiring_department\n    FROM (\n        SELECT hire_year, department_id, COUNT(employee_id) AS hires_count,\n               RANK() OVER (PARTITION BY hire_year ORDER BY COUNT(employee_id) DESC) AS rnk\n        FROM hires\n        GROUP BY hire_year, department_id\n    ) ranked\n    JOIN employees.departments d ON ranked.department_id = d.department_id\n    WHERE rnk = 1\n)\nSELECT hs.hire_year, hs.employees_hired, hs.avg_starting_salary, COALESCE(hr.retention_rate, 0) AS retention_rate, td.top_hiring_department\nFROM hires_summary hs\nLEFT JOIN hires_retention hr ON hs.hire_year = hr.hire_year\nLEFT JOIN top_departments td ON hs.hire_year = td.hire_year\nORDER BY hs.hire_year;"}
| execute_sql {"sql": "CREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n    SELECT employee_id, amount,\n           CASE \n               WHEN amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n               WHEN amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n               WHEN amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n               WHEN amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n               WHEN amount >= 110000 THEN '110K+'\n               ELSE 'Below 30K'\n           END AS salary_band\n    FROM employees.salaries\n    WHERE to_date = '9999-01-01'\n),\ntotal_employees AS (\n    SELECT COUNT(*) AS total FROM employees.employees WHERE status = 'active'\n),\nband_counts AS (\n    SELECT salary_band, COUNT(employee_id) AS employee_count\n    FROM salary_bands sb\n    JOIN employees.employees e ON sb.employee_id = e.employee_id\n    WHERE e.status = 'active'\n    GROUP BY salary_band\n),\nmost_common_titles AS (\n    SELECT salary_band, \n           mode() WITHIN GROUP (ORDER BY e.job_title) AS most_common_title\n    FROM salary_bands sb\n    JOIN employees.employees e ON sb.employee_id = e.employee_id\n    WHERE e.status = 'active'\n    GROUP BY salary_band\n)\nSELECT bc.salary_band, \n       bc.employee_count,\n       ROUND((bc.employee_count::decimal / te.total) * 100, 2) AS percentage_of_workforce,\n       mct.most_common_title\nFROM band_counts bc, total_employees te\nJOIN most_common_titles mct ON bc.salary_band = mct.salary_band\nORDER BY bc.salary_band;"}
