| execute_sql {"sql": "-- Dropping materialized views before retrying for cleanup\nDROP MATERIALIZED VIEW IF EXISTS employees.exec_department_summary;\nDROP MATERIALIZED VIEW IF EXISTS employees.exec_hiring_trends;\nDROP MATERIALIZED VIEW IF EXISTS employees.exec_salary_distribution;\n\n-- Recreate exec_department_summary (simplified)\nCREATE MATERIALIZED VIEW employees.exec_department_summary AS\nSELECT d.dept_name AS department_name,\n       COUNT(de.employee_id) AS total_employees,\n       AVG(s.amount) AS avg_salary,\n       SUM(s.amount)::bigint AS total_payroll,\n       CONCAT(mgr.first_name, ' ', mgr.last_name) AS manager_name\nFROM employees.department d\nJOIN employees.department_employee de ON d.id = de.department_id AND de.to_date = '9999-01-01'\nJOIN employees.employee e ON de.employee_id = e.id\nJOIN employees.salary s ON e.id = s.employee_id AND s.to_date = '9999-01-01'\nLEFT JOIN employees.department_manager dm ON d.id = dm.department_id AND dm.to_date = '9999-01-01'\nLEFT JOIN employees.employee mgr ON dm.employee_id = mgr.id\nGROUP BY d.dept_name, mgr.first_name, mgr.last_name\nWITH DATA;\n\n-- Recreate exec_hiring_trends (simplified)\nCREATE MATERIALIZED VIEW employees.exec_hiring_trends AS\nWITH hires AS (\n  SELECT EXTRACT(YEAR FROM hire_date)::integer AS hire_year, id AS employee_id, hire_date\n  FROM employees.employee\n), hires_per_year AS (\n  SELECT hire_year, COUNT(employee_id) AS employees_hired\n  FROM hires\n  GROUP BY hire_year\n), retention AS (\n  SELECT EXTRACT(YEAR FROM hire_date)::integer AS hire_year,\n         COUNT(CASE WHEN s.to_date = '9999-01-01' THEN 1 END)::float / COUNT(*) * 100 AS retention_rate\n  FROM employees.employee e\n  JOIN employees.salary s ON e.id = s.employee_id\n  GROUP BY hire_year\n), top_departments AS (\n  SELECT hire_year, dept_name AS top_hiring_department\n  FROM (\n    SELECT EXTRACT(YEAR FROM e.hire_date)::integer AS hire_year, d.dept_name, COUNT(*) AS dept_hires,\n           RANK() OVER (PARTITION BY EXTRACT(YEAR FROM e.hire_date)::integer ORDER BY COUNT(*) DESC) AS rnk\n    FROM employees.employee e\n    JOIN employees.department_employee de ON e.id = de.employee_id AND de.to_date = '9999-01-01'\n    JOIN employees.department d ON de.department_id = d.id\n    GROUP BY hire_year, d.dept_name\n  ) ranked\n  WHERE rnk = 1\n)\nSELECT hp.hire_year, hp.employees_hired, NULL::decimal AS avg_starting_salary, COALESCE(r.retention_rate, 0) AS retention_rate, td.top_hiring_department\nFROM hires_per_year hp\nLEFT JOIN retention r ON hp.hire_year = r.hire_year\nLEFT JOIN top_departments td ON hp.hire_year = td.hire_year\nORDER BY hp.hire_year;\n\n-- Create exec_salary_distribution\nCREATE MATERIALIZED VIEW employees.exec_salary_distribution AS\nWITH salary_bands AS (\n  SELECT employee_id,\n         CASE\n           WHEN amount BETWEEN 30000 AND 49999 THEN '30K-50K'\n           WHEN amount BETWEEN 50000 AND 69999 THEN '50K-70K'\n           WHEN amount BETWEEN 70000 AND 89999 THEN '70K-90K'\n           WHEN amount BETWEEN 90000 AND 109999 THEN '90K-110K'\n           WHEN amount >= 110000 THEN '110K+'\n           ELSE 'Below 30K'\n         END AS salary_band\n  FROM employees.salary\n  WHERE to_date = '9999-01-01'\n), total_employees AS (\n  SELECT COUNT(*) AS total FROM employees.employee\n), band_counts AS (\n  SELECT salary_band, COUNT(employee_id) AS employee_count\n  FROM salary_bands\n  GROUP BY salary_band\n), most_common_titles AS (\n  SELECT sb.salary_band, mode() WITHIN GROUP (ORDER BY t.title) AS most_common_title\n  FROM salary_bands sb\n  JOIN employees.title t ON sb.employee_id = t.employee_id AND t.to_date = '9999-01-01'\n  GROUP BY sb.salary_band\n)\nSELECT bc.salary_band, bc.employee_count, ROUND((bc.employee_count::decimal / te.total) * 100, 2) AS percentage_of_workforce, mct.most_common_title\nFROM band_counts bc\nJOIN total_employees te ON true\nJOIN most_common_titles mct ON bc.salary_band = mct.salary_band\nORDER BY bc.salary_band;\n"}
| execute_sql {"sql": "-- Create table monthly_reports\nCREATE TABLE IF NOT EXISTS employees.monthly_reports (\n  report_id SERIAL PRIMARY KEY,\n  report_date DATE NOT NULL,\n  department_count INTEGER NOT NULL,\n  total_employees INTEGER NOT NULL,\n  avg_salary DECIMAL NOT NULL,\n  generated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Create generate_monthly_report stored procedure\nCREATE OR REPLACE FUNCTION employees.generate_monthly_report(report_date DATE)\nRETURNS INTEGER AS $$\nDECLARE\n  dep_count INTEGER;\n  tot_emps INTEGER;\n  avg_sal DECIMAL;\n  rid INTEGER;\nBEGIN\n  SELECT COUNT(*) INTO dep_count FROM employees.department;\n  SELECT COUNT(*) INTO tot_emps FROM employees.employee;\n  SELECT AVG(amount) INTO avg_sal FROM employees.salary WHERE to_date = '9999-01-01';\n  \n  INSERT INTO employees.monthly_reports(report_date, department_count, total_employees, avg_salary)\n  VALUES(report_date, dep_count, tot_emps, avg_sal)\n  RETURNING report_id INTO rid;\n  \n  RETURN rid;\nEND;\n$$ LANGUAGE plpgsql;"}
| execute_sql {"sql": "-- Create salary_alerts table for alert storage\nCREATE TABLE IF NOT EXISTS employees.salary_alerts (\n  alert_id SERIAL PRIMARY KEY,\n  employee_id BIGINT NOT NULL,\n  salary_amount BIGINT NOT NULL,\n  alert_date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  status VARCHAR(20) NOT NULL DEFAULT 'new'\n);\n\n-- Create function for high_salary_alert trigger\nCREATE OR REPLACE FUNCTION employees.fn_high_salary_alert()\nRETURNS TRIGGER AS $$\nBEGIN\n  IF NEW.amount > 120000 THEN\n    INSERT INTO employees.salary_alerts(employee_id, salary_amount, alert_date, status)\n    VALUES (NEW.employee_id, NEW.amount, NOW(), 'new');\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- Create trigger high_salary_alert on salary insert\nDROP TRIGGER IF EXISTS high_salary_alert ON employees.salary;\nCREATE TRIGGER high_salary_alert\nAFTER INSERT ON employees.salary\nFOR EACH ROW\nEXECUTE FUNCTION employees.fn_high_salary_alert();"}
