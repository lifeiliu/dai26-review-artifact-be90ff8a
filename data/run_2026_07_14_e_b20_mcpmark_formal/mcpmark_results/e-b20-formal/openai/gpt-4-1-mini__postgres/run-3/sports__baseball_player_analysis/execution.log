| execute_sql {"sql": "-- Inserting data in baseball_player_analysis with joined data from stats, persons, baseball_offensive_stats and baseball_defensive_stats\nINSERT INTO baseball_player_analysis (\n    player_id, player_name, team_name, games_played, at_bats, hits, runs_scored, rbi, home_runs, batting_average, defensive_games, putouts, assists, errors, fielding_percentage\n)\nSELECT \n    p.id AS player_id,\n    p.person_key AS player_name,\n    'Unknown' AS team_name,\n    -- Aggregate games_played from events or stats count\n    COALESCE(off_stats_count.games_played, 0) AS games_played,\n    COALESCE(off.at_bats, 0) AS at_bats,\n    COALESCE(off.hits, 0) AS hits,\n    COALESCE(off.runs_scored, 0) AS runs_scored,\n    COALESCE(off.rbi, 0) AS rbi,\n    COALESCE(off.home_runs, 0) AS home_runs,\n    CASE WHEN COALESCE(off.at_bats, 0) = 0 THEN 0 ELSE (off.hits::DECIMAL / off.at_bats) END AS batting_average,\n    COALESCE(def_stats_count.defensive_games, 0) AS defensive_games,\n    COALESCE(def.putouts, 0) AS putouts,\n    COALESCE(def.assists, 0) AS assists,\n    COALESCE(def.errors, 0) AS errors,\n    CASE \n        WHEN (COALESCE(def.putouts, 0) + COALESCE(def.assists, 0) + COALESCE(def.errors, 0)) = 0 THEN 0\n        ELSE (COALESCE(def.putouts, 0) + COALESCE(def.assists, 0))::DECIMAL / \n             (COALESCE(def.putouts, 0) + COALESCE(def.assists, 0) + COALESCE(def.errors, 0))\n    END AS fielding_percentage\nFROM persons p\nJOIN stats off_stat ON off_stat.stat_holder_type = 'persons' AND off_stat.stat_holder_id = p.id AND off_stat.stat_repository_type = 'baseball_offensive_stats'\nJOIN baseball_offensive_stats off ON off.id = off_stat.stat_repository_id\nJOIN stats def_stat ON def_stat.stat_holder_type = 'persons' AND def_stat.stat_holder_id = p.id AND def_stat.stat_repository_type = 'baseball_defensive_stats'\nJOIN baseball_defensive_stats def ON def.id = def_stat.stat_repository_id\nLEFT JOIN (\n    -- Assuming games played can be inferred from count of offensive stats entries per player\n    SELECT stat_holder_id, COUNT(*) AS games_played\n    FROM stats\n    WHERE stat_holder_type = 'persons' AND stat_repository_type = 'baseball_offensive_stats'\n    GROUP BY stat_holder_id\n) off_stats_count ON off_stats_count.stat_holder_id = p.id\nLEFT JOIN (\n    -- Assuming defensive games are similar count\n    SELECT stat_holder_id, COUNT(*) AS defensive_games\n    FROM stats\n    WHERE stat_holder_type = 'persons' AND stat_repository_type = 'baseball_defensive_stats'\n    GROUP BY stat_holder_id\n) def_stats_count ON def_stats_count.stat_holder_id = p.id\nWHERE \n    COALESCE(off_stats_count.games_played, 0) >= 10\n    AND COALESCE(off.at_bats, 0) >= 50\n    AND p.person_key IS NOT NULL\nORDER BY batting_average DESC, games_played DESC;"}
